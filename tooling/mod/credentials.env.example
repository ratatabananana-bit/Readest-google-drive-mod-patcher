# Google OAuth client for Drive sign-in. Enter these in the patcher GUI
# (recommended) or copy this file to `credentials.env` and fill them in.
#
# Get them at https://console.cloud.google.com → APIs & Services → Credentials →
# Create credentials → OAuth client ID → Application type: Desktop app.
#
# The real `credentials.env` is gitignored and never uploaded. Without it the
# app still builds, but Drive sign-in is disabled.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_SECRET=
