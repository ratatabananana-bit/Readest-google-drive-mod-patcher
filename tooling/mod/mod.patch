+
+describe('GoogleDriveProvider.getBinary', () => {
+  it('returns the bytes when the file resolves', async () => {
+    const tree = new Map<string, MockFile>([
+      ['root/Readest', { id: 'F1', mimeType: FOLDER_MIME }],
+      ['F1/blob.bin', { id: 'B1' }],
+    ]);
+    const bytes = new TextEncoder().encode('hi').buffer;
+    const fetchFn: FetchFn = async (url, init) => {
+      if (url.includes('q=')) {
+        const q = new URL(url).searchParams.get('q') ?? '';
+        const m = q.match(/name = '(.*?)' and '(.*?)' in parents/)!;
+        const hit = tree.get(`${m[2]}/${m[1]}`);
+        return okJson({ files: hit ? [hit] : [] });
+      }
+      if (url.includes('alt=media')) return okBinary(bytes);
+      throw new Error(`unexpected: ${init?.method} ${url}`);
+    };
+    const p = new GoogleDriveProvider(mockAuth, fetchFn);
+    const got = await p.getBinary('Readest/blob.bin');
+    expect(got).not.toBeNull();
+    expect(new TextDecoder().decode(got!)).toBe('hi');
+  });
+
+  it('returns null when the file resolves to nothing', async () => {
+    const { fetchFn } = makeFetch(new Map());
+    const p = new GoogleDriveProvider(mockAuth, fetchFn);
+    expect(await p.getBinary('Readest/missing.bin')).toBeNull();
+  });
+
+  it('returns null when the resolved file 404s on download', async () => {
+    const tree = new Map<string, MockFile>([['root/a', { id: 'A' }]]);
+    // No body registered for A -> download returns 404 -> getBinary null.
+    const { fetchFn } = makeFetch(tree);
+    const p = new GoogleDriveProvider(mockAuth, fetchFn);
+    expect(await p.getBinary('a')).toBeNull();
+  });
+});
+
+describe('GoogleDriveProvider.list', () => {
+  it('maps children to CloudEntry[] (folder via mime, size, time, md5)', async () => {
+    const tree = new Map<string, MockFile>([
+      ['root/Readest', { id: 'F1', mimeType: FOLDER_MIME }],
+      [
+        'F1/note.json',
+        {
+          id: 'C1',
+          name: 'note.json',
+          size: '12',
+          modifiedTime: '2026-01-02T03:04:05.000Z',
+          md5Checksum: 'abc',
+        },
+      ],
+      ['F1/sub', { id: 'C2', name: 'sub', mimeType: FOLDER_MIME }],
+    ]);
+    const { fetchFn } = makeFetch(tree);
+    const p = new GoogleDriveProvider(mockAuth, fetchFn);
+    const entries = await p.list('Readest');
+    const byName = new Map(entries.map((e) => [e.name, e]));
+
+    const file = byName.get('note.json')!;
+    expect(file.isFolder).toBe(false);
+    expect(file.path).toBe('Readest/note.json');
+    expect(file.size).toBe(12);
+    expect(file.modifiedTime).toBe('2026-01-02T03:04:05.000Z');
+    expect(file.md5).toBe('abc');
+
+    const sub = byName.get('sub')!;
+    expect(sub.isFolder).toBe(true);
+    expect(sub.path).toBe('Readest/sub');
+  });
+
+  it('returns an empty array when the folder is absent', async () => {
+    const { fetchFn } = makeFetch(new Map());
+    const p = new GoogleDriveProvider(mockAuth, fetchFn);
+    expect(await p.list('Readest/nope')).toEqual([]);
+  });
+
+  // Contract pin: this mirrors the FakeCloudProvider immediate-children tests so
+  // both implementations are held to the SAME observable `list` semantics — a
+  // folder child maps to isFolder:true (no body metadata), a file child to
+  // isFolder:false with its size/md5 surfaced.
+  it('maps a direct subfolder and a direct file to the shared contract shape', async () => {
+    const tree = new Map<string, MockFile>([
+      ['root/Readest', { id: 'F1', mimeType: FOLDER_MIME }],
+      ['F1/sub', { id: 'C1', name: 'sub', mimeType: FOLDER_MIME }],
+      [
+        'F1/books.jsonl',
+        {
+          id: 'C2',
+          name: 'books.jsonl',
+          size: '42',
+          modifiedTime: '2026-02-03T04:05:06.000Z',
+          md5Checksum: 'deadbeef',
+        },
+      ],
+    ]);
+    const { fetchFn } = makeFetch(tree);
+    const p = new GoogleDriveProvider(mockAuth, fetchFn);
+    const entries = await p.list('Readest');
+    const byName = new Map(entries.map((e) => [e.name, e]));
+
+    const folder = byName.get('sub')!;
+    expect(folder.isFolder).toBe(true);
+    expect(folder.path).toBe('Readest/sub');
+    expect(folder.size).toBeUndefined();
+    expect(folder.md5).toBeUndefined();
+
+    const file = byName.get('books.jsonl')!;
+    expect(file.isFolder).toBe(false);
+    expect(file.path).toBe('Readest/books.jsonl');
