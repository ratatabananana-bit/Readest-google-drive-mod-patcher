+import { describe, it, expect, afterEach } from 'vitest';
+import { FakeCloudProvider } from '@/services/cloudprovider/FakeCloudProvider';
+import { setCloudProviderForTest, clearCloudProvider } from '@/services/drivesync/cloudSyncContext';
+import { isSyncEnabled } from '@/services/drivesync/isSyncEnabled';
+
+// isSyncEnabled reads the app-wide cloud singleton, so reset that state after
+// every case to keep the suite order-independent.
+afterEach(() => clearCloudProvider());
+
+describe('isSyncEnabled', () => {
+  it('is true when a Readest user is present and cloud is off (stock behavior)', () => {
+    expect(isSyncEnabled({ id: 'u1' })).toBe(true);
+  });
+
+  it('is true when there is no user but the cloud is configured (standalone)', () => {
+    setCloudProviderForTest(new FakeCloudProvider());
+    expect(isSyncEnabled(null)).toBe(true);
+  });
+
+  it('is false when there is no user and the cloud is off', () => {
+    expect(isSyncEnabled(null)).toBe(false);
+  });
+
+  it('is true when both a user is present and the cloud is configured', () => {
+    setCloudProviderForTest(new FakeCloudProvider());
+    expect(isSyncEnabled({ id: 'u1' })).toBe(true);
+  });
+});
diff --git a/apps/readest-app/src/__tests__/drivesync/jsonl.test.ts b/apps/readest-app/src/__tests__/drivesync/jsonl.test.ts
new file mode 100644
index 00000000..011b903c
--- /dev/null
+++ b/apps/readest-app/src/__tests__/drivesync/jsonl.test.ts
@@ -0,0 +1,73 @@
+import { describe, it, expect, vi, afterEach } from 'vitest';
+import { parseJsonl, serializeJsonl } from '@/services/drivesync/jsonl';
+
+// A minimal record shape: the codec is generic, so the fields are arbitrary —
+// these mirror the kind of DB rows (a key plus a timestamp) the sync replicas
+// actually carry, without depending on the concrete record types.
+interface Row {
+  book_hash: string;
+  updated_at: string;
+}
+
+const ROW_A: Row = { book_hash: 'a', updated_at: '2024-01-01T00:00:00.000Z' };
+const ROW_B: Row = { book_hash: 'b', updated_at: '2024-02-01T00:00:00.000Z' };
+
+describe('parseJsonl', () => {
+  it('returns an empty array for null (no file yet)', () => {
+    expect(parseJsonl<Row>(null)).toEqual([]);
+  });
+
+  it('returns an empty array for an empty string', () => {
+    expect(parseJsonl<Row>('')).toEqual([]);
+  });
+
+  it('returns an empty array for whitespace-only content', () => {
+    expect(parseJsonl<Row>('  \n\t\n')).toEqual([]);
+  });
+
+  it('parses one JSON object per non-blank line', () => {
+    const text = `${JSON.stringify(ROW_A)}\n${JSON.stringify(ROW_B)}`;
+    expect(parseJsonl<Row>(text)).toEqual([ROW_A, ROW_B]);
+  });
+
+  it('skips blank and whitespace-only lines between records', () => {
+    const text = `${JSON.stringify(ROW_A)}\n\n   \n${JSON.stringify(ROW_B)}\n`;
+    expect(parseJsonl<Row>(text)).toEqual([ROW_A, ROW_B]);
+  });
+
+  it('skips a single malformed line (warns, does not throw) and keeps the rest', () => {
+    const warn = vi.spyOn(console, 'warn').mockImplementation(() => {});
+    const text = `${JSON.stringify(ROW_A)}\n{not valid json\n${JSON.stringify(ROW_B)}`;
+
+    const parsed = parseJsonl<Row>(text);
+
+    // The good rows survive; only the broken middle line is dropped.
+    expect(parsed).toEqual([ROW_A, ROW_B]);
+    // The drop is observable (a warning carrying line context), never silent.
+    expect(warn).toHaveBeenCalledTimes(1);
+    expect(warn.mock.calls[0]![0]).toContain('jsonl');
+  });
+});
+
+describe('serializeJsonl', () => {
+  it('emits an empty string for an empty array', () => {
+    expect(serializeJsonl<Row>([])).toBe('');
+  });
+
+  it('emits one compact JSON object per line, newline-joined (no trailing newline)', () => {
+    expect(serializeJsonl<Row>([ROW_A, ROW_B])).toBe(
+      `${JSON.stringify(ROW_A)}\n${JSON.stringify(ROW_B)}`,
+    );
+  });
+});
+
+describe('round-trip', () => {
+  it('serialize then parse reproduces the records', () => {
+    const records = [ROW_A, ROW_B];
+    expect(parseJsonl<Row>(serializeJsonl(records))).toEqual(records);
+  });
+});
+
+afterEach(() => {
+  vi.restoreAllMocks();
+});
diff --git a/apps/readest-app/src/__tests__/drivesync/settingsTokenPersistence.test.ts b/apps/readest-app/src/__tests__/drivesync/settingsTokenPersistence.test.ts
