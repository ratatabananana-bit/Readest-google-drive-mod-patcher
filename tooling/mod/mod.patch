diff --git a/apps/readest-app/src/services/drivesync/jsonl.ts b/apps/readest-app/src/services/drivesync/jsonl.ts
new file mode 100644
index 00000000..dceb83b9
--- /dev/null
+++ b/apps/readest-app/src/services/drivesync/jsonl.ts
@@ -0,0 +1,78 @@
+/**
+ * JSON-lines (JSONL) codec for the cloud-sync mod's per-device replicas.
+ *
+ * Each sync replica (`Readest/sync/<deviceId>/<kind>.jsonl`) stores one DB row
+ * as a compact JSON object per line. JSONL — rather than one big JSON array —
+ * is chosen because it is append-friendly and degrades gracefully: a single
+ * corrupt line (a partial write, a stray byte) can be skipped without losing
+ * every other record in the file, which a malformed top-level array could not.
+ *
+ * The codec is intentionally tiny and pure: no I/O and no clock reads, so it is
+ * trivially unit-testable and the {@link DriveSyncClient} owns all the storage
+ * concerns. It is generic over the row type — the caller supplies the concrete
+ * `DBBook`/`DBBookConfig`/`DBBookNote` shape.
+ */
+
+/**
+ * Line separator for the JSONL format. Named so the one delimiter lives in a
+ * single place and `parse`/`serialize` can never disagree on it. Plain `\n`
+ * (not `\r\n`): the replicas are produced and consumed by this codec only, and
+ * the parser tolerates surrounding whitespace, so a `\r` left by some other
+ * tool is trimmed away rather than corrupting a record.
+ */
+const LINE_SEPARATOR = '\n';
+
+/**
+ * Parse JSONL text into an array of records.
+ *
+ * `null` or empty/whitespace-only input yields `[]` (the natural "no file yet"
+ * state — a device that has never pushed a kind has no replica). Lines are split
+ * on {@link LINE_SEPARATOR}; blank and whitespace-only lines are ignored.
+ *
+ * Robustness contract: a line that fails `JSON.parse` is SKIPPED — never thrown
+ * — and the drop is reported via `console.warn` carrying the path and line
+ * number for diagnosis. WHY skip-not-throw: a replica is the merge of many
+ * appends across app versions and interrupted writes; one bad line must not
+ * make an entire device's history unreadable and stall sync. The surviving rows
+ * still LWW-merge correctly, so the worst case is a single record momentarily
+ * missing until its next push.
+ *
+ * @param text - Raw file body, or `null` when the file is absent.
+ * @param sourcePath - Optional logical path of the file, included in the warning
+ *   for a malformed line so the operator can locate the offending replica.
+ */
+export const parseJsonl = <T>(text: string | null, sourcePath?: string): T[] => {
+  if (!text) {
+    return [];
+  }
+
+  const records: T[] = [];
+  const lines = text.split(LINE_SEPARATOR);
+  lines.forEach((line, index) => {
+    const trimmed = line.trim();
+    if (trimmed.length === 0) {
+      return;
+    }
+    try {
+      records.push(JSON.parse(trimmed) as T);
+    } catch (error) {
+      // Carry full context (which replica, which line, the parse error) so a
+      // corrupt row is diagnosable, but keep going so the rest of the file —
+      // and therefore the device's sync — survives one bad line.
+      const where = sourcePath ? `${sourcePath} line ${index + 1}` : `jsonl line ${index + 1}`;
+      console.warn(`[jsonl] skipping malformed line at ${where}:`, error);
+    }
+  });
+  return records;
+};
+
+/**
+ * Serialize records to JSONL text: one compact JSON object per line, joined by
+ * {@link LINE_SEPARATOR}, with no trailing newline. An empty input yields an
+ * empty string (the canonical empty-replica body, which {@link parseJsonl}
+ * round-trips back to `[]`).
+ *
+ * @param records - Rows to encode; each must be JSON-serializable.
+ */
+export const serializeJsonl = <T>(records: T[]): string =>
+  records.map((record) => JSON.stringify(record)).join(LINE_SEPARATOR);
diff --git a/apps/readest-app/src/services/drivesync/layout.ts b/apps/readest-app/src/services/drivesync/layout.ts
new file mode 100644
index 00000000..2d7b9734
--- /dev/null
+++ b/apps/readest-app/src/services/drivesync/layout.ts
@@ -0,0 +1,125 @@
+/**
+ * Logical path layout for the cloud-sync mod's app-scoped storage.
+ *
+ * Every path produced here is a *logical*, app-scoped, slash-joined key (see
+ * {@link CloudProvider}) — never an absolute filesystem path. All blobs live
+ * beneath a single application root so the user's wider cloud storage is never
+ * touched and the whole namespace can be reasoned about (and cleaned up) as one
+ * tree.
+ *
+ * Phase-1 scope: only the book + cover blob paths. Phase-2 adds the per-device
+ * JSONL sync replicas (see {@link deviceSyncPath}); salt/key-material paths
+ * belong to later phases and are intentionally omitted (YAGNI) to keep this
+ * surface minimal.
+ */
+
+import { CLOUD_PATH_SEPARATOR } from '../cloudprovider/CloudProvider';
+
+/** Single root folder that contains everything the mod writes to the cloud. */
+export const APP_ROOT = 'Readest';
+
+/** Container for all binary blobs (as opposed to JSON sync replicas). */
+const BLOBS_DIR = 'blobs';
+
+/** Subfolder of {@link BLOBS_DIR} holding book bodies, one file per hash+ext. */
+const BOOKS_DIR = 'books';
+
+/** Subfolder of {@link BLOBS_DIR} holding cover images, one file per hash. */
+const COVERS_DIR = 'covers';
+
+/**
+ * Cover images are always stored as PNG. Readest normalizes covers to PNG when
+ * it generates them, so the cloud blob carries a single, stable extension and
+ * content type regardless of the original source image — callers therefore need
+ * not (and cannot) vary the cover extension.
+ */
+const COVER_EXTENSION = 'png';
+
+/** Join logical path segments with the provider's app-scoped separator. */
+const joinPath = (...segments: string[]): string => segments.join(CLOUD_PATH_SEPARATOR);
+
+/** Folder holding book bodies: `Readest/blobs/books`. */
+const booksDirPath = joinPath(APP_ROOT, BLOBS_DIR, BOOKS_DIR);
+
+/** Folder holding cover images: `Readest/blobs/covers`. */
+const coversDirPath = joinPath(APP_ROOT, BLOBS_DIR, COVERS_DIR);
+
+/**
+ * Logical path of a book body, e.g. `Readest/blobs/books/<hash>.epub`.
+ *
+ * @param hash - Content hash that uniquely identifies the book.
+ * @param ext - File extension (e.g. `epub`, `pdf`), without a leading dot.
+ *   Callers are expected to pass a normalized (lower-case) extension; see
+ *   {@link DriveBlobStore}.
+ */
+export const bookBlobPath = (hash: string, ext: string): string =>
+  `${joinPath(booksDirPath, hash)}.${ext}`;
+
+/**
+ * Logical path of a cover image, e.g. `Readest/blobs/covers/<hash>.png`.
+ * The extension is always {@link COVER_EXTENSION} (see its docs for why).
+ *
+ * @param hash - Content hash of the book the cover belongs to.
+ */
+export const coverBlobPath = (hash: string): string =>
+  `${joinPath(coversDirPath, hash)}.${COVER_EXTENSION}`;
+
+// ---------------------------------------------------------------------------
+// Phase 2: per-device JSONL sync replicas.
+//
+// Each device owns one folder under {@link SYNC_DIR} and writes only its own
+// `<kind>.jsonl` files inside it (`Readest/sync/<deviceId>/books.jsonl`, ...).
+// Per-device write isolation is the core invariant: a device never edits a
+// peer's file, so two devices can push concurrently without clobbering each
+// other (no lost updates). Reads, by contrast, fan out across every device
+// folder and LWW-merge the rows — so a record is authoritative the moment any
+// device has written its newest copy. The folder-per-device shape also makes
+// each device's contribution discoverable via a single `list(syncRootPath())`.
+// ---------------------------------------------------------------------------
+
+/**
+ * The Phase-2 record kinds carried as per-device JSONL replicas (books/configs/
+ * notes). Kept as its own union so the record-sync machinery in
+ * {@link import('./DriveSyncClient')} stays typed to exactly these three.
+ */
+export type SyncRecordKind = 'books' | 'configs' | 'notes';
+
+/**
+ * The Phase-3 reading-stat kinds, each carried as its own per-device JSONL
+ * replica (`Readest/sync/<deviceId>/statBooks.jsonl` / `statPages.jsonl`). Split
+ * out from {@link SyncRecordKind} because stats merge by DIFFERENT rules
+ * (statBooks LWW; statPages longest-duration-wins) and carry a write-time
+ * cursor, so the two families never share a code path beyond the layout here.
+ */
+export type StatKind = 'statBooks' | 'statPages';
+
+/**
+ * Every per-device replica kind, record or stat. {@link deviceSyncPath} resolves
+ * any of these to its `<kind>.jsonl` path — the file-naming scheme is identical
+ * across families, so it is the one thing they DO share.
+ */
+export type SyncKind = SyncRecordKind | StatKind;
+
+/** Container for all per-device JSONL sync replicas (as opposed to blobs). */
+const SYNC_DIR = 'sync';
+
+/** Extension carried by every per-device sync replica (JSON-lines). */
+const SYNC_FILE_EXTENSION = 'jsonl';
+
+/**
+ * Root folder holding one subfolder per device: `Readest/sync`. Pulls list its
+ * immediate children to discover every contributing device.
+ */
+export const syncRootPath = (): string => joinPath(APP_ROOT, SYNC_DIR);
+
+/**
+ * Logical path of a device's replica for one kind, e.g.
+ * `Readest/sync/<deviceId>/books.jsonl`. The owning device is the only writer
+ * of this file (see the per-device write-isolation note above).
+ *
+ * @param deviceId - Stable identifier of the device that owns the file.
+ * @param kind - Which stream the file carries: a record kind
+ *   (books/configs/notes) or a stat kind (statBooks/statPages).
+ */
+export const deviceSyncPath = (deviceId: string, kind: SyncKind): string =>
+  `${joinPath(syncRootPath(), deviceId, kind)}.${SYNC_FILE_EXTENSION}`;
diff --git a/apps/readest-app/src/services/drivesync/settingsTokenPersistence.ts b/apps/readest-app/src/services/drivesync/settingsTokenPersistence.ts
new file mode 100644
index 00000000..434cd68a
--- /dev/null
+++ b/apps/readest-app/src/services/drivesync/settingsTokenPersistence.ts
@@ -0,0 +1,128 @@
+/**
+ * Settings-backed {@link TokenPersistence} for the Google Drive cloud-sync mod.
+ *
+ * Why settings, not a keyring: Readest ships no separate secret store — all
+ * secret-bearing integration credentials (OPDS, KOSync, Readwise/Hardcover
+ * tokens) already live in {@link SystemSettings}. The Drive `TokenSet` follows
+ * that same established home rather than inventing a parallel native keystore,
+ * so it is persisted, backed up, and cleared by exactly the machinery the rest
+ * of the app already uses.
+ *
+ * The persistence logic is expressed against an injected {@link SettingsAccess}
+ * seam rather than reaching into zustand/appService directly, so the read/
+ * write/clear behaviour is unit-testable with an in-memory fake — no store, no
+ * disk, no environment. The default wiring at the bottom of this file is the
+ * thin, intentionally-untested glue that binds the seam to the real store.
+ */
+
+import type { TokenPersistence } from '../cloudprovider/buildDriveProvider';
+import type { TokenSet } from '../cloudprovider/googleAuth/tokenStore';
+import type { SystemSettings } from '@/types/settings';
+import { useSettingsStore } from '@/store/settingsStore';
+import type { EnvConfigType } from '@/services/environment';
+
+/**
+ * The narrow slice of settings-store behaviour this module needs, injected so
+ * the factory below can be exercised without zustand or the app service.
+ *
+ * - {@link getSettings} reads the current in-memory settings.
+ * - {@link setSettings} swaps in a new settings object (zustand/React detect the
+ *   change by reference, hence the immutable updates in the factory).
+ * - {@link persist} writes the given settings to disk (the app service's
+ *   `saveSettings`), so a refreshed/cleared token survives a restart.
+ */
+export interface SettingsAccess {
+  getSettings: () => SystemSettings;
+  setSettings: (settings: SystemSettings) => void;
+  persist: (settings: SystemSettings) => Promise<void>;
+}
+
+/**
+ * Read the persisted token set, validating that every required field is
+ * present. A partial object (e.g. a half-written or schema-drifted settings
+ * file that lost `expiresAt`) is treated as "no usable credentials" rather than
+ * being surfaced as a malformed {@link TokenSet}, so downstream auth fails with
+ * a clean "not signed in" path instead of an opaque error mid-request.
+ */
+const readValidTokens = (settings: SystemSettings): TokenSet | null => {
+  const stored = settings.cloudSync?.google?.tokens;
+  if (stored === undefined) {
+    return null;
+  }
+  // `refreshToken` is legitimately optional (Google omits it on refresh), so it
+  // is not required here; `accessToken` and `expiresAt` are the load-bearing
+  // fields without which the set is unusable.
+  if (typeof stored.accessToken !== 'string' || typeof stored.expiresAt !== 'number') {
+    return null;
+  }
+  return stored;
+};
+
+/**
+ * Produce a new settings object whose `cloudSync.google` slice is replaced by
+ * `nextGoogle`, spreading at every level so no nested object the caller still
+ * holds is mutated in place. Centralised so {@link save} and {@link clear} build
+ * the immutable update identically.
+ *
+ * @param nextGoogle - the replacement `google` slice, or `undefined` to leave
+ *   `cloudSync` present but with no google account fields.
+ */
+const withGoogleCloudSync = (
+  settings: SystemSettings,
+  nextGoogle: NonNullable<NonNullable<SystemSettings['cloudSync']>['google']> | undefined,
+): SystemSettings => ({
+  ...settings,
+  cloudSync: {
+    ...settings.cloudSync,
+    google: nextGoogle,
+  },
+});
+
+/**
+ * Build a {@link TokenPersistence} over the injected {@link SettingsAccess}.
+ *
+ * Each mutating operation derives a brand-new settings object (never mutating
+ * the existing one), pushes it into the store via `setSettings`, then awaits
+ * `persist` so the change is durable before the promise resolves.
+ */
+export const createSettingsTokenPersistence = (access: SettingsAccess): TokenPersistence => ({
+  async load(): Promise<TokenSet | null> {
+    return readValidTokens(access.getSettings());
+  },
+
+  async save(tokens: TokenSet): Promise<void> {
+    const settings = access.getSettings();
+    const next = withGoogleCloudSync(settings, {
+      // Preserve any sibling fields on `google` (e.g. accountLabel) and overwrite
+      // only the token set.
+      ...settings.cloudSync?.google,
+      tokens,
+    });
+    access.setSettings(next);
+    await access.persist(next);
+  },
+
+  async clear(): Promise<void> {
+    const settings = access.getSettings();
+    const { tokens: _removedTokens, ...remainingGoogle } = settings.cloudSync?.google ?? {};
+    const next = withGoogleCloudSync(settings, remainingGoogle);
+    access.setSettings(next);
+    await access.persist(next);
+  },
+});
+
+/**
+ * Default wiring of {@link SettingsAccess} onto the live settings store.
+ *
+ * This is the deliberately-thin, un-unit-tested glue: it reads `getState()`
+ * fresh on every accessor call (so it always sees the current settings, not a
+ * snapshot captured at construction) and routes durability through the store's
+ * own `saveSettings`, which delegates to the platform app service. The testable
+ * behaviour lives entirely in {@link createSettingsTokenPersistence}.
+ */
+export const getSettingsTokenPersistence = (envConfig: EnvConfigType): TokenPersistence =>
+  createSettingsTokenPersistence({
+    getSettings: () => useSettingsStore.getState().settings,
+    setSettings: (settings) => useSettingsStore.getState().setSettings(settings),
+    persist: (settings) => useSettingsStore.getState().saveSettings(envConfig, settings),
+  });
diff --git a/apps/readest-app/src/services/drivesync/statsMerge.ts b/apps/readest-app/src/services/drivesync/statsMerge.ts
new file mode 100644
index 00000000..0d213c76
--- /dev/null
+++ b/apps/readest-app/src/services/drivesync/statsMerge.ts
@@ -0,0 +1,65 @@
+/**
+ * Pure "longest-duration-wins" merge for reading-page stat events — the ONE
+ * merge rule Phase 3 adds on top of the LWW engine in {@link import('./driveMerge')}.
+ *
+ * WHY a different rule from the rest of sync: a `stat_pages` row records how long
+ * a reading session on one page lasted. The same page/session can be reported by
+ * several devices (or re-reported after a partial sync), and the truest record is
+ * the one with the GREATEST `duration` — not the most recently written one. So
+ * unlike books/configs/notes (last-writer-wins by timestamp), page events merge
+ * by duration. This mirrors the server's `pickWinningPages` (sync.ts:28-38),
+ * which is itself KOReader-compatible: "existing keys win only when the incoming
+ * duration is strictly longer".
+ *
+ * `stat_books` do NOT use this rule — they are plain LWW by `book_hash` and reuse
+ * the shared {@link import('./driveMerge').mergeByKey}; only the page merge is new.
+ *
+ * Everything here is pure: no I/O, no clock reads, no input mutation — so it is
+ * trivially unit-testable and order-independent (see {@link mergeStatPagesByDuration}).
+ */
+
+import type { StatPageRecord } from '@/libs/sync';
+
+/**
+ * Separator joining a page event's composite primary key
+ * (`book_hash` + `page` + `start_time`) into a single map key. Mirrors the
+ * server's `pageKey` (sync.ts:21), which joins the same three fields with `'|'`.
+ * Named so the one delimiter lives in exactly one place and the key shape can
+ * never silently drift from the server's.
+ */
+const PAGE_KEY_SEPARATOR = '|';
+
+/**
+ * Composite primary key for a page event: `book_hash|page|start_time`. These
+ * three fields identify one reading session on one page (the server keys on
+ * exactly these — `onConflict: 'user_id,book_hash,page,start_time'`, sync.ts:543).
+ */
+export const statPageKeyOf = (record: StatPageRecord): string =>
+  [record.book_hash, record.page, record.start_time].join(PAGE_KEY_SEPARATOR);
+
+/**
+ * Collapse `pages` to one winner per key under the "longest duration wins" rule.
+ *
+ * Groups by {@link statPageKeyOf} and, within each group, keeps the single
+ * record with the greatest `duration`. The comparison is STRICT (`>`), exactly
+ * like the server's `pickWinningPages` ("incoming wins only when strictly
+ * longer"), which makes the fold deterministic and order-independent: a record
+ * only displaces the incumbent when it is provably longer, so an equal-duration
+ * record never swaps places and the first-seen one is kept. For any input with a
+ * uniquely-longest record per key (the real-world case) the winner is identical
+ * regardless of input order. Result order follows first-seen key order; callers
+ * treat the output as a set.
+ */
+export const mergeStatPagesByDuration = (pages: StatPageRecord[]): StatPageRecord[] => {
+  const winnerByKey = new Map<string, StatPageRecord>();
+  for (const page of pages) {
+    const key = statPageKeyOf(page);
+    const incumbent = winnerByKey.get(key);
+    // New key always wins; an existing key is replaced only by a strictly longer
+    // duration (mirrors pickWinningPages: `!existing || rec.duration > existing.duration`).
+    if (incumbent === undefined || page.duration > incumbent.duration) {
+      winnerByKey.set(key, page);
+    }
+  }
+  return [...winnerByKey.values()];
+};
