index 00000000..2730f363
--- /dev/null
+++ b/apps/readest-app/src/services/cloudprovider/CloudProvider.ts
@@ -0,0 +1,138 @@
+/**
+ * Backend-agnostic cloud file API used by the cloud-sync mod.
+ *
+ * Every concrete provider (Google Drive today, Dropbox later) operates inside
+ * the application's own private scope — Google `drive.file` or a Dropbox App
+ * folder — never the user's wider cloud storage. Paths handed to these methods
+ * are therefore *logical*, app-scoped, slash-joined keys such as
+ * `Readest/blobs/books/<hash>.epub`, not absolute filesystem paths. How a
+ * provider maps a logical path onto its own folder/ID model is an
+ * implementation detail hidden behind this seam.
+ *
+ * Downstream components (blob store, salt store, replica sync) depend only on
+ * this interface so they can be unit-tested against the in-memory
+ * {@link FakeCloudProvider} without touching the network.
+ */
+
+/** Path separator for logical, app-scoped cloud paths (`Readest/sync/devA`). */
+export const CLOUD_PATH_SEPARATOR = '/';
+
+/** Metadata describing a single file or folder within the provider's app scope. */
+export interface CloudEntry {
+  /** Full slash-joined logical path within the provider's app scope. */
+  path: string;
+  /** Last path segment (file or folder name). */
+  name: string;
+  /** True for a folder/container, false for a file blob. */
+  isFolder: boolean;
+  /** Size of the file body in bytes, when the provider reports it. */
+  size?: number;
+  /** Last-modified timestamp as ISO-8601, when the provider reports it. */
+  modifiedTime?: string;
+  /**
+   * Content hash when the provider exposes one (e.g. Google Drive's
+   * `md5Checksum`). Used downstream to skip redundant uploads/downloads.
+   */
+  md5?: string;
+}
+
+/**
+ * Upload progress callback.
+ *
+ * @param sentBytes - Bytes transferred so far.
+ * @param totalBytes - Total bytes to transfer for this operation.
+ */
+export type ProgressHandler = (sentBytes: number, totalBytes: number) => void;
+
+export interface CloudProvider {
+  /**
+   * Whether the provider currently holds usable credentials for the app scope.
+   * Implementations must not throw for an unauthenticated state — they resolve
+   * `false` instead.
+   */
+  isAuthenticated(): Promise<boolean>;
+
+  /**
+   * Human-readable label for the connected account (e.g. an email address),
+   * for display in settings. Resolves `null` when no account is connected or
+   * the backend does not expose one.
+   */
+  accountLabel(): Promise<string | null>;
+
+  /**
+   * Read a file's body decoded as UTF-8 text.
+   *
+   * @param path - Logical, app-scoped path to the file.
+   * @returns The text body, or `null` when no file exists at `path`.
+   */
+  getText(path: string): Promise<string | null>;
+
+  /**
+   * Write (creating or overwriting) a file's body from UTF-8 text.
+   *
+   * @param path - Logical, app-scoped path to the file.
+   * @param body - Text body to store; encoded as UTF-8 bytes.
+   * @param contentType - MIME type to associate; defaults to JSON, the format
+   *   of the sync replicas this seam was built for.
+   */
+  putText(path: string, body: string, contentType?: string): Promise<void>;
+
+  /**
+   * Read a file's raw bytes.
+   *
+   * @param path - Logical, app-scoped path to the file.
+   * @returns The byte body, or `null` when no file exists at `path`.
+   */
+  getBinary(path: string): Promise<ArrayBuffer | null>;
+
+  /**
+   * Write (creating or overwriting) a file's raw bytes.
+   *
+   * @param path - Logical, app-scoped path to the file.
+   * @param body - Byte body to store.
+   * @param contentType - MIME type to associate; defaults to an opaque binary
+   *   stream type when the caller does not know the format.
+   * @param onProgress - Optional upload-progress callback. Implementations must
+   *   report completion by calling it with `sentBytes === totalBytes`.
+   */
+  putBinary(
+    path: string,
+    body: ArrayBuffer,
+    contentType?: string,
+    onProgress?: ProgressHandler,
+  ): Promise<void>;
+
+  /**
+   * List the IMMEDIATE children of the folder at `path` — both the files
+   * directly inside it and its direct subfolders, but never deeper descendants.
+   * This is Google Drive's native model and the single contract every provider
+   * honours.
+   *
+   * A file child is returned as a {@link CloudEntry} with `isFolder: false` and
+   * its body metadata (size, and where the backend exposes them, md5/
+   * modifiedTime). A subfolder child is returned as a {@link CloudEntry} with
+   * `isFolder: true` and no body metadata (no size/md5); each distinct subfolder
+   * appears exactly once regardless of how many descendants it holds.
+   *
+   * @param path - Logical, app-scoped folder path (without a trailing
+   *   separator).
+   * @returns The immediate children, or an empty array when the folder is
+   *   absent or has none.
+   */
+  list(path: string): Promise<CloudEntry[]>;
+
+  /**
+   * Fetch metadata for a single file or folder.
+   *
+   * @param path - Logical, app-scoped path.
+   * @returns The entry's metadata, or `null` when nothing exists at `path`.
+   */
+  stat(path: string): Promise<CloudEntry | null>;
+
+  /**
+   * Delete the file at `path`.
+   *
+   * @param path - Logical, app-scoped path to the file.
+   */
+  deleteFile(path: string): Promise<void>;
+}
diff --git a/apps/readest-app/src/services/cloudprovider/FakeCloudProvider.ts b/apps/readest-app/src/services/cloudprovider/FakeCloudProvider.ts
new file mode 100644
index 00000000..7c7beade
--- /dev/null
+++ b/apps/readest-app/src/services/cloudprovider/FakeCloudProvider.ts
@@ -0,0 +1,155 @@
+import {
+  CLOUD_PATH_SEPARATOR,
+  type CloudEntry,
+  type CloudProvider,
+  type ProgressHandler,
+} from './CloudProvider';
+
+/**
+ * Default MIME type for {@link FakeCloudProvider.putText}. Matches the JSON/JSONL
+ * sync replicas this seam was built to carry, so text callers rarely pass one.
+ */
+const DEFAULT_TEXT_CONTENT_TYPE = 'application/json';
+
+/**
+ * Default MIME type for {@link FakeCloudProvider.putBinary} when the caller does
+ * not know the format — the standard "opaque byte stream" type.
+ */
+const DEFAULT_BINARY_CONTENT_TYPE = 'application/octet-stream';
+
+/**
+ * Label reported by {@link FakeCloudProvider.accountLabel}. Identifies the
+ * provider in test assertions and any UI that renders the connected account.
+ */
+const FAKE_ACCOUNT_LABEL = 'in-memory fake';
+
+/**
+ * Number of path segments below a folder's prefix that marks a key as a *direct*
+ * file child. Exactly one remaining segment (e.g. `books.jsonl` under
+ * `Readest/sync/devA/`) is an immediate file; more segments imply a subfolder.
+ */
+const DIRECT_CHILD_SEGMENT_COUNT = 1;
+
+/** A single stored file: its raw bytes plus the MIME type it was written with. */
+interface StoredFile {
+  body: ArrayBuffer;
+  contentType: string;
+}
+
+/**
+ * In-memory {@link CloudProvider} for network-free tests.
+ *
+ * Files live in a `Map` keyed by their logical, app-scoped path. There is no
+ * folder hierarchy: folders are implied by path prefixes, exactly as the real
+ * providers expose them through {@link CloudProvider.list}. This lets downstream
+ * code (blob store, salt store, replica sync) be driven under test with the same
+ * contract the production backends honour.
+ */
+export class FakeCloudProvider implements CloudProvider {
+  private readonly files = new Map<string, StoredFile>();
+
+  async isAuthenticated(): Promise<boolean> {
+    // The in-memory store is always reachable, so it is always "authenticated".
+    return true;
+  }
+
+  async accountLabel(): Promise<string | null> {
+    return FAKE_ACCOUNT_LABEL;
+  }
+
+  async getText(path: string): Promise<string | null> {
+    const body = await this.getBinary(path);
+    return body === null ? null : new TextDecoder().decode(body);
+  }
+
+  async putText(
+    path: string,
+    body: string,
+    contentType: string = DEFAULT_TEXT_CONTENT_TYPE,
+  ): Promise<void> {
+    await this.putBinary(path, new TextEncoder().encode(body).buffer, contentType);
+  }
+
+  async getBinary(path: string): Promise<ArrayBuffer | null> {
+    return this.files.get(path)?.body ?? null;
+  }
+
+  async putBinary(
+    path: string,
+    body: ArrayBuffer,
+    contentType: string = DEFAULT_BINARY_CONTENT_TYPE,
+    onProgress?: ProgressHandler,
+  ): Promise<void> {
+    this.files.set(path, { body, contentType });
+    // The whole body lands instantly in memory: report one completed step so
+    // callers exercising progress reporting see the expected terminal event.
+    onProgress?.(body.byteLength, body.byteLength);
+  }
+
+  async list(path: string): Promise<CloudEntry[]> {
+    // Contract: return only the IMMEDIATE children of `path` (Drive's native
+    // model). The store is flat — there are no real folders, just file keys — so
+    // subfolders are synthesized: a key one level below `path` is a direct file,
+    // and any key deeper than that implies a direct subfolder named by its first
+    // remaining segment. Matching on `path + separator` (not bare `path`) also
+    // excludes a sibling that merely shares the literal prefix (e.g.
+    // `Readest/synced.txt` vs the folder `Readest/sync`).
+    const folderPrefix = `${path}${CLOUD_PATH_SEPARATOR}`;
+    const fileEntries: CloudEntry[] = [];
+    // Distinct direct-subfolder names, deduplicated so the many files beneath one
+    // subfolder still yield a single folder entry.
+    const subfolderNames = new Set<string>();
+
+    for (const [storedPath, file] of this.files) {
+      if (!storedPath.startsWith(folderPrefix)) continue;
+      const remainder = storedPath.slice(folderPrefix.length);
+      const segments = remainder.split(CLOUD_PATH_SEPARATOR);
+      const isDirectFile = segments.length === DIRECT_CHILD_SEGMENT_COUNT;
+      if (isDirectFile) {
+        fileEntries.push(toFileEntry(storedPath, file));
+      } else {
+        // Deeper than one level: the first segment is a direct subfolder.
+        subfolderNames.add(segments[0]!);
+      }
+    }
+
+    const folderEntries = [...subfolderNames].map((name) =>
+      toFolderEntry(`${folderPrefix}${name}`, name),
+    );
+    return [...fileEntries, ...folderEntries];
+  }
+
+  async stat(path: string): Promise<CloudEntry | null> {
+    const file = this.files.get(path);
+    return file === undefined ? null : toFileEntry(path, file);
+  }
+
+  async deleteFile(path: string): Promise<void> {
+    this.files.delete(path);
+  }
+}
+
+/** Build a file {@link CloudEntry} from a stored path and its bytes. */
+function toFileEntry(path: string, file: StoredFile): CloudEntry {
+  return {
+    path,
+    name: lastPathSegment(path),
+    isFolder: false,
+    size: file.body.byteLength,
+  };
+}
+
+/**
+ * Build a folder {@link CloudEntry} synthesized from flat file keys. The fake
+ * store has no real folders, so a subfolder carries no body metadata (no size,
+ * md5, or modifiedTime) — it exists only because deeper files imply it.
+ */
+function toFolderEntry(path: string, name: string): CloudEntry {
+  return { path, name, isFolder: true };
+}
+
+/** Last segment of a slash-joined logical path (the file or folder name). */
+function lastPathSegment(path: string): string {
+  const segments = path.split(CLOUD_PATH_SEPARATOR);
+  return segments[segments.length - 1] ?? path;
+}
