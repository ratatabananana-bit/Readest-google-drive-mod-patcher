diff --git a/apps/readest-app/scripts/drive-smoke.ts b/apps/readest-app/scripts/drive-smoke.ts
new file mode 100644
index 00000000..55e9c194
--- /dev/null
+++ b/apps/readest-app/scripts/drive-smoke.ts
@@ -0,0 +1,144 @@
+/**
+ * Live end-to-end smoke test for the cloud-sync mod's Google Drive engine.
+ *
+ * Wires the REAL mod modules together against REAL Google Drive, with no Tauri
+ * build required: it runs the desktop loopback OAuth flow (PKCE), exchanges the
+ * code for tokens, then drives a full DriveBlobStore round-trip (upload → stat →
+ * download → verify bytes → list → delete) through GoogleDriveProvider.
+ *
+ * The only manual step is clicking "Allow" once in the browser — the OAuth
+ * consent is inherently interactive and tied to the user's Google account.
+ *
+ * Run:
+ *   pnpm exec dotenv -e .env.local -- tsx scripts/drive-smoke.ts
+ *
+ * Prereqs:
+ *   - NEXT_PUBLIC_GOOGLE_CLIENT_ID (+ NEXT_PUBLIC_GOOGLE_CLIENT_SECRET for a
+ *     Google "Desktop app" client) in .env.local.
+ *   - Google Drive API enabled in the Cloud project.
+ *   - The Google account added as a Test user on the OAuth consent screen.
+ */
+import { createServer } from 'node:http';
+import { createPkcePair, buildAuthUrl } from '../src/services/cloudprovider/googleAuth/pkce';
+import { exchangeCode } from '../src/services/cloudprovider/googleAuth/tokenStore';
+import { parseRedirect } from '../src/services/cloudprovider/googleAuth/parseRedirect';
+import {
+  GoogleDriveProvider,
+  type DriveAuth,
+} from '../src/services/cloudprovider/GoogleDriveProvider';
+import { DriveBlobStore } from '../src/services/drivesync/DriveBlobStore';
+
+/** The app-files Drive scope: the app only ever sees files it created. */
+const DRIVE_FILE_SCOPE = 'https://www.googleapis.com/auth/drive.file';
+/** Local interface Google redirects back to; any loopback port is allowed for Desktop clients. */
+const LOOPBACK_HOST = '127.0.0.1';
+/** A made-up book hash + format used only for this smoke test. */
+const TEST_HASH = 'smoke-test-book';
+const TEST_EXT = 'epub';
+const TEST_CONTENT = 'hello from the readest cloud-sync smoke test';
+
+const clientId = process.env['NEXT_PUBLIC_GOOGLE_CLIENT_ID'];
+const clientSecret = process.env['NEXT_PUBLIC_GOOGLE_CLIENT_SECRET'];
+
+if (!clientId) {
+  console.error('Missing NEXT_PUBLIC_GOOGLE_CLIENT_ID. Add it to .env.local and re-run.');
+  process.exit(1);
+}
+
+/** Node's global fetch is structurally compatible with the modules' injected FetchFn. */
+const nodeFetch = fetch as unknown as (input: string, init?: RequestInit) => Promise<Response>;
+
+/**
+ * Start a one-shot loopback HTTP server, open consent in the browser, and
+ * resolve with the full redirect URL once Google bounces back with the code.
+ */
+const captureRedirect = (
+  buildUrl: (redirectUri: string) => string,
+): Promise<{ redirectUrl: string; redirectUri: string }> =>
+  new Promise((resolve, reject) => {
+    const server = createServer((req, res) => {
+      const redirectUrl = `http://${LOOPBACK_HOST}${req.url ?? ''}`;
+      res.end(
+        'Readest cloud-sync: consent received. You can close this tab and return to the terminal.',
+      );
+      server.close();
+      resolve({ redirectUrl, redirectUri });
+    });
+    let redirectUri = '';
+    server.on('error', reject);
+    server.listen(0, LOOPBACK_HOST, () => {
+      const address = server.address();
+      if (address === null || typeof address === 'string') {
+        reject(new Error('Failed to bind loopback server'));
+        return;
+      }
+      redirectUri = `http://${LOOPBACK_HOST}:${address.port}`;
+      const authUrl = buildUrl(redirectUri);
+      console.log('\n=== STEP 1: open this URL in your browser and click "Allow" ===\n');
+      console.log(authUrl);
+      console.log('\nWaiting for the Google redirect on', redirectUri, '...\n');
+    });
+  });
+
+const decode = (buffer: ArrayBuffer): string => new TextDecoder().decode(buffer);
+
+const main = async (): Promise<void> => {
+  const { verifier, challenge } = await createPkcePair();
+  const state = crypto.randomUUID();
+
+  const { redirectUrl, redirectUri } = await captureRedirect((uri) =>
+    buildAuthUrl({ clientId, redirectUri: uri, scope: DRIVE_FILE_SCOPE, challenge, state }),
+  );
+
+  const { code } = parseRedirect(redirectUrl, state);
+  console.log('STEP 2: exchanging authorization code for tokens...');
+  const tokens = await exchangeCode(
+    { code, verifier, clientId, redirectUri, clientSecret },
+    nodeFetch as never,
+  );
+  console.log('  ✓ got access token (expires at', new Date(tokens.expiresAt).toISOString() + ')');
+  console.log('  refresh token present:', Boolean(tokens.refreshToken));
+
+  const auth: DriveAuth = {
+    getAccessToken: async () => tokens.accessToken,
+    accountLabel: async () => null,
+  };
+  const provider = new GoogleDriveProvider(auth, nodeFetch);
+  const store = new DriveBlobStore(provider);
+
+  console.log('\nSTEP 3: Drive round-trip via DriveBlobStore...');
+  const bytes = new TextEncoder().encode(TEST_CONTENT).buffer;
+  await store.uploadBook(TEST_HASH, TEST_EXT, bytes);
+  console.log('  ✓ uploaded', `Readest/blobs/books/${TEST_HASH}.${TEST_EXT}`);
+
+  const present = await store.hasBook(TEST_HASH, TEST_EXT);
+  console.log('  ✓ hasBook:', present);
+
+  const downloaded = await store.downloadBook(TEST_HASH, TEST_EXT);
+  const roundTripped = downloaded !== null && decode(downloaded) === TEST_CONTENT;
+  console.log('  ✓ downloaded bytes match:', roundTripped);
+
+  const listing = await provider.list('Readest/blobs/books');
+  console.log(
+    '  ✓ list Readest/blobs/books:',
+    listing.map((e) => e.name),
+  );
+
+  await provider.deleteFile(`Readest/blobs/books/${TEST_HASH}.${TEST_EXT}`);
+  const goneAfterDelete = !(await store.hasBook(TEST_HASH, TEST_EXT));
+  console.log('  ✓ deleted and gone:', goneAfterDelete);
+
+  if (present && roundTripped && goneAfterDelete) {
+    console.log(
+      '\n=== SMOKE TEST PASSED — the Drive engine works end-to-end against real Google Drive ===',
+    );
+    process.exit(0);
+  }
+  console.error('\n=== SMOKE TEST FAILED — see the per-step results above ===');
+  process.exit(1);
+};
+
+main().catch((err) => {
+  console.error('\nSmoke test error:', err instanceof Error ? err.message : err);
+  process.exit(1);
+});
