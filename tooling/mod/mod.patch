@@ -0,0 +1,74 @@
+import { describe, it, expect } from 'vitest';
+import { readCloudAccount } from '@/services/drivesync/cloudAccount';
+import type { SystemSettings } from '@/types/settings';
+
+/**
+ * Build a {@link SystemSettings} fixture whose only meaningful content is the
+ * `cloudSync` slice under test. Cast from a bare object — the rest of the
+ * settings shape is irrelevant to {@link readCloudAccount}, which reads only
+ * `cloudSync.google`.
+ */
+const settingsWithCloudSync = (cloudSync: SystemSettings['cloudSync']): SystemSettings =>
+  ({ cloudSync }) as SystemSettings;
+
+describe('readCloudAccount', () => {
+  it('reports not connected and no label when there is no cloudSync block', () => {
+    expect(readCloudAccount({} as SystemSettings)).toEqual({
+      connected: false,
+      label: null,
+    });
+  });
+
+  it('reports not connected when a google slice exists but holds no tokens', () => {
+    const settings = settingsWithCloudSync({ google: { accountLabel: 'a@b.com' } });
+
+    expect(readCloudAccount(settings).connected).toBe(false);
+  });
+
+  it('reports not connected when tokens are present but the access token is empty', () => {
+    const settings = settingsWithCloudSync({
+      google: { tokens: { accessToken: '', expiresAt: 1 } },
+    });
+
+    expect(readCloudAccount(settings).connected).toBe(false);
+  });
+
+  it('reports not connected when a tokens object carries no access token field', () => {
+    const settings = settingsWithCloudSync({
+      // A schema-drifted/half-written token set missing the load-bearing field.
+      google: { tokens: { expiresAt: 1 } as { accessToken: string; expiresAt: number } },
+    });
+
+    expect(readCloudAccount(settings).connected).toBe(false);
+  });
+
+  it('reports connected when a non-empty access token is persisted', () => {
+    const settings = settingsWithCloudSync({
+      google: { tokens: { accessToken: 'access-abc', expiresAt: 1 } },
+    });
+
+    expect(readCloudAccount(settings).connected).toBe(true);
+  });
+
+  it('surfaces the persisted account label when one is stored', () => {
+    const settings = settingsWithCloudSync({
+      google: {
+        tokens: { accessToken: 'access-abc', expiresAt: 1 },
+        accountLabel: 'reader@gmail.com',
+      },
+    });
+
+    expect(readCloudAccount(settings)).toEqual({
+      connected: true,
+      label: 'reader@gmail.com',
+    });
+  });
+
+  it('returns a null label when connected without a stored account label', () => {
+    const settings = settingsWithCloudSync({
+      google: { tokens: { accessToken: 'access-abc', expiresAt: 1 } },
+    });
+
+    expect(readCloudAccount(settings).label).toBeNull();
+  });
+});
diff --git a/apps/readest-app/src/__tests__/drivesync/cloudServiceDriveShim.test.ts b/apps/readest-app/src/__tests__/drivesync/cloudServiceDriveShim.test.ts
new file mode 100644
index 00000000..461347f2
--- /dev/null
+++ b/apps/readest-app/src/__tests__/drivesync/cloudServiceDriveShim.test.ts
@@ -0,0 +1,181 @@
+import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest';
+
+// Mock the server transfer layer. Two reasons:
+//   1. It keeps the suite network-free and lets us assert the server path is
+//      (or isn't) taken via these spies.
+//   2. Importing cloudService transitively pulls in @/libs/storage →
+//      @/utils/access → the Supabase client, which evaluates env-derived config
+//      at module load. Replacing the module severs that chain so the shim can be
+//      tested in isolation. The configured (Drive) path never calls these anyway.
+vi.mock('@/libs/storage', () => ({
+  uploadFile: vi.fn(),
+  uploadReplicaFile: vi.fn(),
+  deleteFile: vi.fn(),
+  downloadFile: vi.fn(),
+  batchGetDownloadUrls: vi.fn(),
+  createProgressHandler: () => () => {},
+}));
+
+import { FakeCloudProvider } from '@/services/cloudprovider/FakeCloudProvider';
+import { setCloudProviderForTest, clearCloudProvider } from '@/services/drivesync/cloudSyncContext';
+import { cloudPath } from '@/services/drivesync/driveStorageBridge';
+import { CLOUD_BOOKS_SUBDIR } from '@/services/constants';
+import { uploadBook, downloadBook } from '@/services/cloudService';
+import * as storage from '@/libs/storage';
+import { getCoverFilename, getLocalBookFilename, getRemoteBookFilename } from '@/utils/book';
+import type { Book } from '@/types/book';
+import type { AppService, BaseDir, FileSystem } from '@/types/system';
+
+// The shim reaches the provider through the app-wide singleton; reset it around
+// every test so the configured and not-configured cases never bleed together.
+// Clear mock call history too so per-test call-count assertions stay isolated.
+beforeEach(() => {
+  clearCloudProvider();
+  vi.clearAllMocks();
+});
+afterEach(() => clearCloudProvider());
+
+// A managed EPUB whose body + cover live on the local "device A" filesystem.
+const makeBook = (): Book => ({
+  hash: 'hash123',
+  format: 'EPUB',
+  title: 'My Book',
+  author: 'An Author',
+  createdAt: 1,
+  updatedAt: 1,
+});
+
+const LOCAL_BOOKS_DIR = '/local/Readest/Books';
+const BASE_SEPARATOR = ':';
+
+const decode = (bytes: ArrayBuffer): string => new TextDecoder().decode(bytes);
+const encode = (text: string): ArrayBuffer => new TextEncoder().encode(text).buffer;
+
+/**
+ * Minimal in-memory filesystem double. Keyed by `<base>:<path>` so the `'Books'`
+ * and `'None'` namespaces stay distinct, exactly as the real FS treats base dirs.
+ * Only the methods uploadBook/downloadBook actually exercise are implemented; the
+ * rest throw so an unexpected call surfaces loudly rather than silently passing.
+ */
+class InMemoryFs {
+  readonly store = new Map<string, ArrayBuffer>();
+
+  private key(path: string, base: BaseDir): string {
+    return `${base}${BASE_SEPARATOR}${path}`;
+  }
+
+  set(path: string, base: BaseDir, bytes: ArrayBuffer): void {
+    this.store.set(this.key(path, base), bytes);
+  }
+
+  async exists(path: string, base: BaseDir): Promise<boolean> {
+    return this.store.has(this.key(path, base));
+  }
+
+  async openFile(path: string, base: BaseDir): Promise<File> {
+    const bytes = this.store.get(this.key(path, base));
+    if (!bytes) throw new Error(`openFile: no such file ${base}:${path}`);
+    let closed = false;
+    // The shim only needs arrayBuffer() + close(); model just those.
+    return {
+      arrayBuffer: async () => bytes,
+      close: async () => {
+        closed = true;
+      },
+      get _closed() {
+        return closed;
+      },
+    } as unknown as File;
+  }
+
+  async writeFile(path: string, base: BaseDir, content: ArrayBuffer): Promise<void> {
+    this.store.set(this.key(path, base), content);
+  }
+
+  async createDir(): Promise<void> {
+    // No directory tree to maintain in the flat store; accept and ignore.
+  }
+
+  asFileSystem(): FileSystem {
+    return this as unknown as FileSystem;
+  }
+}
+
+/**
+ * AppService double whose writeFile lands bytes into the SAME backing store as a
+ * given InMemoryFs, so a download written via appService.writeFile(dst, 'None',…)
+ * is then visible to fs.exists(dst, 'None') — the existence probe downloadBook
+ * uses to confirm the book arrived.
+ */
+const makeAppService = (fs: InMemoryFs): AppService =>
+  ({
+    writeFile: async (path: string, base: BaseDir, content: ArrayBuffer) => {
+      fs.set(path, base, content);
+    },
+  }) as unknown as AppService;
+
+const resolveFilePath = async (path: string, base: BaseDir): Promise<string> => `${base}/${path}`;
+
+describe('cloudService Drive shim (round-trip through FakeCloudProvider)', () => {
+  it('uploadBook then downloadBook round-trips book + cover via the provider', async () => {
+    const cloud = new FakeCloudProvider();
+    setCloudProviderForTest(cloud);
+
+    // --- Device A: seed the managed book body + cover, then upload. ---
+    const book = makeBook();
+    const bookBytes = encode('EPUB-BODY');
+    const coverBytes = encode('PNG-COVER');
+    const deviceA = new InMemoryFs();
+    deviceA.set(getLocalBookFilename(book), 'Books', bookBytes);
+    deviceA.set(getCoverFilename(book), 'Books', coverBytes);
+
+    await uploadBook(deviceA.asFileSystem(), resolveFilePath, book);
+
+    // The bytes must now live in the provider at Readest/<cfp> for both files.
+    const bookCfp = `${CLOUD_BOOKS_SUBDIR}/${getRemoteBookFilename(book)}`;
+    const coverCfp = `${CLOUD_BOOKS_SUBDIR}/${getCoverFilename(book)}`;
+    const storedBook = await cloud.getBinary(cloudPath(bookCfp));
+    const storedCover = await cloud.getBinary(cloudPath(coverCfp));
+    expect(storedBook && decode(storedBook)).toBe('EPUB-BODY');
+    expect(storedCover && decode(storedCover)).toBe('PNG-COVER');
+    expect(book.uploadedAt).toBeTruthy();
+
+    // --- Device B: a FRESH local fs with neither file present → download. ---
+    const deviceB = new InMemoryFs();
+    const appServiceB = makeAppService(deviceB);
+    const downloadedBook: Book = { ...makeBook() };
+
+    await downloadBook(appServiceB, deviceB.asFileSystem(), LOCAL_BOOKS_DIR, downloadedBook);
+
+    // Both files were written locally with the exact bytes device A uploaded.
+    const localCover = deviceB.store.get(`None:${LOCAL_BOOKS_DIR}/${getCoverFilename(book)}`);
+    const localBook = deviceB.store.get(`None:${LOCAL_BOOKS_DIR}/${getLocalBookFilename(book)}`);
+    expect(localCover && decode(localCover)).toBe('PNG-COVER');
+    expect(localBook && decode(localBook)).toBe('EPUB-BODY');
+    expect(downloadedBook.downloadedAt).toBeTruthy();
+    expect(downloadedBook.coverDownloadedAt).toBeTruthy();
+  });
+
+  it('uploads nothing to the provider and uses the server path when cloud is NOT configured', async () => {
+    // Cloud not configured (beforeEach cleared it). @/libs/storage is mocked at
+    // the top, so the server path is exercised against the mock — no network.
+    const uploadFile = vi.mocked(storage.uploadFile);
+
+    // A provider exists but is NOT registered: prove the shim consults
+    // isCloudConfigured(), not merely the presence of a provider object.
+    const cloud = new FakeCloudProvider();
+    const putSpy = vi.spyOn(cloud, 'putBinary');
+
+    const book = makeBook();
+    const fs = new InMemoryFs();
+    fs.set(getLocalBookFilename(book), 'Books', encode('EPUB-BODY'));
+    fs.set(getCoverFilename(book), 'Books', encode('PNG-COVER'));
+
+    await uploadBook(fs.asFileSystem(), resolveFilePath, book);
+
+    // Server path taken: uploadFile called per managed file (cover + book = 2).
+    expect(uploadFile).toHaveBeenCalledTimes(2);
+    // Bridge path NOT taken: the provider received nothing.
+    expect(putSpy).not.toHaveBeenCalled();
+  });
+});
diff --git a/apps/readest-app/src/__tests__/drivesync/cloudSyncContext.test.ts b/apps/readest-app/src/__tests__/drivesync/cloudSyncContext.test.ts
