+                  'h-9 rounded-lg px-4 text-sm font-medium',
+                  'text-error hover:bg-error/10',
+                  'transition-colors duration-150',
+                  'focus-visible:ring-error/40 focus-visible:outline-none focus-visible:ring-2',
+                  isBusy && 'opacity-60',
+                )}
+              >
+                {isBusy ? <span className='loading loading-spinner loading-xs' /> : _('Disconnect')}
+              </button>
+            </SettingsRow>
+          </BoxedList>
+        </div>
+      ) : (
+        <div className='space-y-5'>
+          {!isConfigured && (
+            <p className='text-base-content/70 px-1 text-sm leading-relaxed'>
+              {_('Google Drive is not configured in this build.')}
+            </p>
+          )}
+          <div className='flex justify-center pt-1'>
+            <button
+              type='button'
+              onClick={handleConnect}
+              disabled={!isConfigured || isBusy}
+              className={clsx(
+                'btn btn-primary',
+                // Prominent, centered call-to-action (mirrors the library's blue
+                // "Import Books" button) rather than a small right-aligned button.
+                'h-11 min-h-11 w-full max-w-sm gap-2 rounded-lg border-0 px-6 text-sm font-medium',
+                'focus-visible:ring-primary/40 focus-visible:outline-none focus-visible:ring-2',
+                (!isConfigured || isBusy) && 'opacity-60',
+              )}
+            >
+              {isBusy ? (
+                <span className='loading loading-spinner loading-sm' />
+              ) : (
+                <>
+                  <RiGoogleLine className='h-4 w-4' />
+                  {_('Connect Google Drive')}
+                </>
+              )}
+            </button>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+};
+
+export default CloudSyncForm;
