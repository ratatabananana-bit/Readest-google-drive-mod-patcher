@@ -0,0 +1,57 @@
+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import { FakeCloudProvider } from '@/services/cloudprovider/FakeCloudProvider';
+import {
+  setCloudProviderForTest,
+  getBlobStore,
+  getCloudProvider,
+  isCloudConfigured,
+  clearCloudProvider,
+} from '@/services/drivesync/cloudSyncContext';
+
+// The module under test holds app-wide singleton state. Reset it around every
+// test so the suite is order-independent: no test inherits a provider another
+// left behind, and the "before configuration" cases see a genuinely empty slate.
+beforeEach(() => clearCloudProvider());
+afterEach(() => clearCloudProvider());
+
+describe('cloudSyncContext', () => {
+  it('exposes a DriveBlobStore over the active provider', async () => {
+    setCloudProviderForTest(new FakeCloudProvider());
+    const store = getBlobStore();
+    await store.uploadBook('h', 'epub', new TextEncoder().encode('X').buffer);
+    expect(await store.hasBook('h', 'epub')).toBe(true);
+  });
+
+  it('reports not configured before a provider is set, configured after', () => {
+    expect(isCloudConfigured()).toBe(false);
+    setCloudProviderForTest(new FakeCloudProvider());
+    expect(isCloudConfigured()).toBe(true);
+  });
+
+  it('returns the same memoized blob store across calls (built once)', () => {
+    setCloudProviderForTest(new FakeCloudProvider());
+    expect(getBlobStore()).toBe(getBlobStore());
+  });
+
+  it('returns the active provider once configured', () => {
+    const provider = new FakeCloudProvider();
+    setCloudProviderForTest(provider);
+    expect(getCloudProvider()).toBe(provider);
+  });
+
+  it('throws a clear error when getBlobStore() is called before configuration', () => {
+    expect(() => getBlobStore()).toThrow(/cloud provider not configured/i);
+  });
+
+  it('throws a clear error when getCloudProvider() is called before configuration', () => {
+    expect(() => getCloudProvider()).toThrow(/cloud provider not configured/i);
+  });
+
+  it('clearCloudProvider() resets configuration back to false', () => {
+    setCloudProviderForTest(new FakeCloudProvider());
+    expect(isCloudConfigured()).toBe(true);
+    clearCloudProvider();
+    expect(isCloudConfigured()).toBe(false);
+    expect(() => getBlobStore()).toThrow(/cloud provider not configured/i);
+  });
+});
diff --git a/apps/readest-app/src/__tests__/drivesync/cloudSyncController.test.ts b/apps/readest-app/src/__tests__/drivesync/cloudSyncController.test.ts
new file mode 100644
index 00000000..c49158ef
--- /dev/null
+++ b/apps/readest-app/src/__tests__/drivesync/cloudSyncController.test.ts
@@ -0,0 +1,193 @@
+import { describe, it, expect, vi } from 'vitest';
+import {
+  connectGoogleDrive,
+  disconnectGoogleDrive,
+  initCloudSyncFromSettings,
+  type CloudSyncControllerDeps,
+} from '@/services/drivesync/cloudSyncController';
+import type { CloudProvider } from '@/services/cloudprovider/CloudProvider';
+import type { FetchFn } from '@/services/cloudprovider/GoogleDriveProvider';
+import type {
+  DriveProviderBundle,
+  TokenPersistence,
+} from '@/services/cloudprovider/buildDriveProvider';
+import type { TokenSet } from '@/services/cloudprovider/googleAuth/tokenStore';
+
+/**
+ * The controller never touches the provider's methods directly — it only hands
+ * the built provider to `setProvider` — so an empty object cast to the seam is a
+ * sufficient stand-in. Using a stub (rather than a real GoogleDriveProvider)
+ * keeps these tests free of any Drive/network wiring.
+ */
+const fakeProvider = (): CloudProvider => ({}) as CloudProvider;
+
+/** The label the fake `auth.accountLabel()` resolves to, asserted on by `connect`. */
+const ACCOUNT_LABEL = 'Google Drive';
+
+/**
+ * In-memory {@link TokenPersistence}. Each method is a `vi.fn` so the tests can
+ * assert *what* was persisted/cleared and *whether* it happened at all — the
+ * ordering guarantees (save before activate; never persist on a cancelled
+ * OAuth) are exactly what these spies verify.
+ */
+const fakePersistence = (initial: TokenSet | null) => {
+  let stored: TokenSet | null = initial;
+  const load = vi.fn(async (): Promise<TokenSet | null> => stored);
+  const save = vi.fn(async (tokens: TokenSet): Promise<void> => {
+    stored = tokens;
+  });
+  const clear = vi.fn(async (): Promise<void> => {
+    stored = null;
+  });
+  const persistence: TokenPersistence = { load, save, clear };
+  return { persistence, load, save, clear };
+};
+
+/** A fetch that fails the test if ever called — the controller does no I/O itself. */
+const unusedFetch = (): FetchFn =>
+  vi.fn<FetchFn>(() => {
+    throw new Error('fetch must not be called by the controller');
+  });
+
+const CONFIG = { clientId: 'client-id-123' } as const;
+const TOKENS: TokenSet = { accessToken: 'AT', refreshToken: 'RT', expiresAt: 10_000 };
+
+/**
+ * Assemble controller deps over fakes. `buildProvider` is replaced with a stub
+ * that records its arguments and returns a fixed bundle, so no real
+ * PersistedDriveAuth/GoogleDriveProvider (and hence no network) is constructed.
+ */
+const makeDeps = (
+  overrides: Partial<CloudSyncControllerDeps> = {},
+  persistenceInit: TokenSet | null = null,
+) => {
+  const { persistence, load, save, clear } = fakePersistence(persistenceInit);
+  const provider = fakeProvider();
+  const auth = { accountLabel: vi.fn(async (): Promise<string | null> => ACCOUNT_LABEL) };
+  const buildProvider = vi.fn(
+    (): DriveProviderBundle => ({ provider, auth }) as unknown as DriveProviderBundle,
+  );
+  const runOAuth = vi.fn(async (): Promise<TokenSet> => TOKENS);
+  const setProvider = vi.fn();
+  const clearProvider = vi.fn();
+  const deps: CloudSyncControllerDeps = {
+    runOAuth,
+    persistence,
+    config: CONFIG,
+    fetchFn: unusedFetch(),
+    setProvider,
+    clearProvider,
+    buildProvider,
+    ...overrides,
+  };
+  return {
+    deps,
+    load,
+    save,
+    clear,
+    provider,
+    auth,
+    buildProvider,
+    runOAuth,
+    setProvider,
+    clearProvider,
+  };
+};
+
+describe('connectGoogleDrive', () => {
+  it('persists the OAuth tokens, activates the built provider, and returns the account label', async () => {
+    const { deps, save, buildProvider, provider, setProvider } = makeDeps();
+
+    const result = await connectGoogleDrive(deps);
+
+    // Tokens are persisted with exactly what OAuth minted...
+    expect(save).toHaveBeenCalledWith(TOKENS);
+    // ...the provider is built from the same persistence/config/fetchFn...
+    expect(buildProvider).toHaveBeenCalledWith(deps.persistence, deps.config, deps.fetchFn);
+    // ...and that built provider is the one activated.
+    expect(setProvider).toHaveBeenCalledWith(provider);
+    expect(result).toEqual({ accountLabel: ACCOUNT_LABEL });
+  });
+
+  it('saves the tokens BEFORE activating the provider (activate must see persisted state)', async () => {
+    const order: string[] = [];
+    const { persistence, save } = fakePersistence(null);
+    save.mockImplementation(async () => {
+      order.push('save');
+    });
+    const setProvider = vi.fn(() => {
+      order.push('setProvider');
+    });
+    const { deps } = makeDeps({ persistence, setProvider });
+
+    await connectGoogleDrive(deps);
+
+    expect(order).toEqual(['save', 'setProvider']);
+  });
+
+  it('propagates an OAuth rejection WITHOUT persisting or activating anything', async () => {
+    const cancelled = new Error('user cancelled consent');
+    const runOAuth = vi.fn(async (): Promise<TokenSet> => {
+      throw cancelled;
+    });
+    const { deps, save, buildProvider, setProvider } = makeDeps({ runOAuth });
+
+    await expect(connectGoogleDrive(deps)).rejects.toThrow('user cancelled consent');
+
+    // Nothing was minted, so nothing must have been persisted or activated.
+    expect(save).not.toHaveBeenCalled();
+    expect(buildProvider).not.toHaveBeenCalled();
+    expect(setProvider).not.toHaveBeenCalled();
+  });
+});
+
+describe('disconnectGoogleDrive', () => {
+  it('deactivates the provider and clears persisted tokens', async () => {
+    const { deps, clear, clearProvider } = makeDeps({}, TOKENS);
+
+    await disconnectGoogleDrive(deps);
+
+    expect(clearProvider).toHaveBeenCalledTimes(1);
+    expect(clear).toHaveBeenCalledTimes(1);
+  });
+
+  it('deactivates the provider BEFORE clearing persistence, so a clear failure still signs out', async () => {
+    const order: string[] = [];
+    const { persistence, clear } = fakePersistence(TOKENS);
+    clear.mockImplementation(async () => {
+      order.push('clear');
+    });
+    const clearProvider = vi.fn(() => {
+      order.push('clearProvider');
+    });
+    const { deps } = makeDeps({ persistence, clearProvider });
+
+    await disconnectGoogleDrive(deps);
+
+    expect(order).toEqual(['clearProvider', 'clear']);
+  });
+});
+
+describe('initCloudSyncFromSettings', () => {
+  it('returns false and leaves the provider unset when no tokens are stored', async () => {
+    const { deps, setProvider, buildProvider } = makeDeps({}, null);
+
+    const configured = await initCloudSyncFromSettings(deps);
+
+    expect(configured).toBe(false);
+    expect(buildProvider).not.toHaveBeenCalled();
+    expect(setProvider).not.toHaveBeenCalled();
+  });
+
+  it('builds and activates the provider from stored tokens, returning true, WITHOUT running OAuth', async () => {
+    const { deps, setProvider, buildProvider, provider, runOAuth } = makeDeps({}, TOKENS);
+
+    const configured = await initCloudSyncFromSettings(deps);
+
+    expect(configured).toBe(true);
+    expect(buildProvider).toHaveBeenCalledWith(deps.persistence, deps.config, deps.fetchFn);
+    expect(setProvider).toHaveBeenCalledWith(provider);
+    // Startup must never trigger an interactive consent flow.
+    expect(runOAuth).not.toHaveBeenCalled();
+  });
+});
diff --git a/apps/readest-app/src/__tests__/drivesync/cloudSyncEnvConfig.test.ts b/apps/readest-app/src/__tests__/drivesync/cloudSyncEnvConfig.test.ts
new file mode 100644
index 00000000..bf2f16c9
--- /dev/null
+++ b/apps/readest-app/src/__tests__/drivesync/cloudSyncEnvConfig.test.ts
@@ -0,0 +1,74 @@
+import { describe, it, expect } from 'vitest';
+import {
+  readDriveAuthConfig,
+  isGoogleDriveConfigured,
+  selectRunOAuth,
+  toOAuthClientConfig,
+  GOOGLE_DRIVE_SYNC_SCOPE,
+  type EnvLike,
+} from '@/services/drivesync/cloudSyncEnvConfig';
+import { runDesktopDeepLinkOAuth } from '@/services/cloudprovider/googleAuth/oauthDesktopDeepLink';
+import { runAndroidOAuth } from '@/services/cloudprovider/googleAuth/oauthAndroid';
+
+/**
+ * Env key restated here (rather than imported) so the test pins the actual
+ * variable name a build must set — a rename in the source should fail a test,
+ * not silently keep passing against an imported constant.
+ */
+const CLIENT_ID_KEY = 'NEXT_PUBLIC_GOOGLE_CLIENT_ID';
+
+const envWith = (overrides: EnvLike): EnvLike => ({ ...overrides });
+
+describe('readDriveAuthConfig', () => {
+  it('returns the single iOS-type client id and never attaches a secret', () => {
+    const config = readDriveAuthConfig(envWith({ [CLIENT_ID_KEY]: 'client-123' }));
+    expect(config).toEqual({ clientId: 'client-123' });
+    // The one client carries no secret (reverse-DNS + PKCE are the client auth);
+    // the field must be genuinely absent so the shape matches `DriveAuthConfig`.
+    expect(config && 'clientSecret' in config).toBe(false);
+  });
+
+  it('returns null when the client id is missing', () => {
+    expect(readDriveAuthConfig(envWith({}))).toBeNull();
+  });
+
+  it('treats an empty-string client id as not configured', () => {
+    expect(readDriveAuthConfig(envWith({ [CLIENT_ID_KEY]: '' }))).toBeNull();
+  });
+});
+
+describe('isGoogleDriveConfigured', () => {
+  it('is true when the client id is present', () => {
+    expect(isGoogleDriveConfigured(envWith({ [CLIENT_ID_KEY]: 'client-123' }))).toBe(true);
+  });
+
+  it('is false when no client id is present', () => {
+    expect(isGoogleDriveConfigured(envWith({}))).toBe(false);
+  });
+});
+
+describe('selectRunOAuth', () => {
+  it('selects the Custom-Tab flow on Android', () => {
+    expect(selectRunOAuth('android')).toBe(runAndroidOAuth);
+  });
+
+  it('selects the reverse-DNS deep-link flow on every other platform', () => {
+    expect(selectRunOAuth('windows')).toBe(runDesktopDeepLinkOAuth);
+    expect(selectRunOAuth('macos')).toBe(runDesktopDeepLinkOAuth);
+    expect(selectRunOAuth('linux')).toBe(runDesktopDeepLinkOAuth);
+    expect(selectRunOAuth('ios')).toBe(runDesktopDeepLinkOAuth);
+  });
+});
+
+describe('toOAuthClientConfig', () => {
+  it('attaches the Drive sync scope to the auth config', () => {
+    expect(toOAuthClientConfig({ clientId: 'client-123' })).toEqual({
+      clientId: 'client-123',
+      scope: GOOGLE_DRIVE_SYNC_SCOPE,
+    });
+  });
+
+  it('requests the least-privilege per-app Drive file scope', () => {
+    expect(GOOGLE_DRIVE_SYNC_SCOPE).toBe('https://www.googleapis.com/auth/drive.file');
+  });
+});
diff --git a/apps/readest-app/src/__tests__/drivesync/driveAwareSyncClient.test.ts b/apps/readest-app/src/__tests__/drivesync/driveAwareSyncClient.test.ts
new file mode 100644
index 00000000..8a3e7e5b
--- /dev/null
+++ b/apps/readest-app/src/__tests__/drivesync/driveAwareSyncClient.test.ts
@@ -0,0 +1,136 @@
+import { describe, expect, test, vi } from 'vitest';
+import { createSyncRouter, type SyncClientLike } from '@/services/drivesync/driveAwareSyncClient';
+import type { SyncData, SyncResult } from '@/libs/sync';
+
+/**
+ * A {@link SyncClientLike} fake whose two methods are vitest spies returning a
+ * caller-supplied sentinel result. Both spies share one result so a test can
+ * assert "this client answered" by identity, and inspect `.mock.calls` for the
+ * exact forwarded args.
+ */
+const makeFakeClient = (
+  result: SyncResult,
+): SyncClientLike & {
+  pullChanges: ReturnType<typeof vi.fn>;
+  pushChanges: ReturnType<typeof vi.fn>;
+} => ({
+  pullChanges: vi.fn(async () => result),
+  pushChanges: vi.fn(async () => result),
+});
+
+const emptyResult = (): SyncResult => ({ books: null, configs: null, notes: null });
+
+describe('createSyncRouter', () => {
+  test('routes to legacy when cloud is NOT configured', async () => {
+    const legacyResult = emptyResult();
+    const legacy = makeFakeClient(legacyResult);
+    const drive = makeFakeClient(emptyResult());
+    const makeDriveClient = vi.fn(() => drive);
+
+    const router = createSyncRouter({
+      legacy,
+      isCloudConfigured: () => false,
+      makeDriveClient,
+    });
+
+    const pulled = await router.pullChanges(1);
+    const payload: SyncData = { books: [] };
+    const pushed = await router.pushChanges(payload);
+
+    expect(legacy.pullChanges).toHaveBeenCalledWith(1);
+    expect(legacy.pushChanges).toHaveBeenCalledWith(payload);
+    expect(pulled).toBe(legacyResult);
+    expect(pushed).toBe(legacyResult);
+    // The drive client must never even be built when cloud is off.
+    expect(makeDriveClient).not.toHaveBeenCalled();
+    expect(drive.pullChanges).not.toHaveBeenCalled();
+    expect(drive.pushChanges).not.toHaveBeenCalled();
+  });
+
+  test('routes to the drive client when cloud IS configured', async () => {
+    const driveResult = emptyResult();
+    const legacy = makeFakeClient(emptyResult());
+    const drive = makeFakeClient(driveResult);
+    const makeDriveClient = vi.fn(() => drive);
+
+    const router = createSyncRouter({
+      legacy,
+      isCloudConfigured: () => true,
+      makeDriveClient,
+    });
+
+    const pulled = await router.pullChanges(7);
+    const payload: SyncData = { notes: [] };
+    const pushed = await router.pushChanges(payload);
+
+    expect(drive.pullChanges).toHaveBeenCalledWith(7);
+    expect(drive.pushChanges).toHaveBeenCalledWith(payload);
+    expect(pulled).toBe(driveResult);
+    expect(pushed).toBe(driveResult);
+    expect(legacy.pullChanges).not.toHaveBeenCalled();
+    expect(legacy.pushChanges).not.toHaveBeenCalled();
+  });
+
+  test('re-evaluates routing per call so a mid-session connect takes effect', async () => {
+    const legacy = makeFakeClient(emptyResult());
+    const drive = makeFakeClient(emptyResult());
+    let connected = false;
+
+    const router = createSyncRouter({
+      legacy,
+      isCloudConfigured: () => connected,
+      makeDriveClient: () => drive,
+    });
+
+    await router.pullChanges(0); // not yet connected → legacy
+    connected = true;
+    await router.pullChanges(0); // connected mid-session → drive
+
+    expect(legacy.pullChanges).toHaveBeenCalledTimes(1);
+    expect(drive.pullChanges).toHaveBeenCalledTimes(1);
+  });
+
+  test('forwards all five pullChanges args verbatim', async () => {
+    const drive = makeFakeClient(emptyResult());
+    const router = createSyncRouter({
+      legacy: makeFakeClient(emptyResult()),
+      isCloudConfigured: () => true,
+      makeDriveClient: () => drive,
+    });
+
+    await router.pullChanges(123, 'configs', 'hashA', 'metaA', 10);
+
+    expect(drive.pullChanges).toHaveBeenCalledWith(123, 'configs', 'hashA', 'metaA', 10);
+  });
+
+  test('forwards the pushChanges payload verbatim and propagates the result', async () => {
+    const driveResult: SyncResult = { books: [], configs: null, notes: null };
+    const drive = makeFakeClient(driveResult);
+    const router = createSyncRouter({
+      legacy: makeFakeClient(emptyResult()),
+      isCloudConfigured: () => true,
+      makeDriveClient: () => drive,
+    });
+
+    const payload: SyncData = { configs: [{ book_hash: 'h' }] };
+    const result = await router.pushChanges(payload);
+
+    expect(drive.pushChanges).toHaveBeenCalledWith(payload);
+    expect(result).toBe(driveResult);
+  });
+
+  test('builds a fresh drive client per routed call (binds to the active provider)', async () => {
+    const drive = makeFakeClient(emptyResult());
+    const makeDriveClient = vi.fn(() => drive);
+    const router = createSyncRouter({
+      legacy: makeFakeClient(emptyResult()),
+      isCloudConfigured: () => true,
+      makeDriveClient,
+    });
+
+    await router.pullChanges(0);
+    await router.pushChanges({});
+
+    expect(makeDriveClient).toHaveBeenCalledTimes(2);
+  });
+});
diff --git a/apps/readest-app/src/__tests__/drivesync/driveMerge.test.ts b/apps/readest-app/src/__tests__/drivesync/driveMerge.test.ts
new file mode 100644
index 00000000..2499d5f3
--- /dev/null
+++ b/apps/readest-app/src/__tests__/drivesync/driveMerge.test.ts
@@ -0,0 +1,220 @@
+import { describe, it, expect } from 'vitest';
+import {
+  parseIsoMs,
+  effectiveTimestampMs,
+  mergeByKey,
+  changedSinceMs,
+  bookKeyOf,
+  configKeyOf,
+  noteKeyOf,
+  type TimestampedRecord,
+} from '@/services/drivesync/driveMerge';
+
+// DB-shaped fixtures: records carry an ISO `updated_at` and a nullable ISO
+// `deleted_at`, exactly like the rows the server's sync endpoint merges
+// (sync.ts:370-379). Timestamps are kept readable (distinct, ordered) so the
+// expected winner is obvious from the literal value.
+interface Book extends TimestampedRecord {
+  book_hash: string;
+  value?: string;
+}
+
+interface Note extends TimestampedRecord {
+  book_hash: string;
+  id: string;
+  value?: string;
+}
+
+const T1 = '2024-01-01T00:00:00.000Z';
+const T2 = '2024-02-01T00:00:00.000Z';
+const T3 = '2024-03-01T00:00:00.000Z';
+
+describe('parseIsoMs', () => {
+  it('parses a valid ISO-8601 string to epoch ms', () => {
+    expect(parseIsoMs('1970-01-01T00:00:01.000Z')).toBe(1000);
+  });
+
+  it('returns 0 for undefined', () => {
+    expect(parseIsoMs(undefined)).toBe(0);
+  });
+
+  it('returns 0 for null', () => {
+    expect(parseIsoMs(null)).toBe(0);
+  });
+
+  it('returns 0 for an unparseable (garbage) string', () => {
+    expect(parseIsoMs('not-a-date')).toBe(0);
+  });
+});
+
+describe('effectiveTimestampMs', () => {
+  it('picks the max of updated_at and deleted_at', () => {
+    expect(effectiveTimestampMs({ updated_at: T1, deleted_at: T3 })).toBe(parseIsoMs(T3));
+    expect(effectiveTimestampMs({ updated_at: T3, deleted_at: T1 })).toBe(parseIsoMs(T3));
+  });
+
+  it('is 0 when neither timestamp is present', () => {
+    expect(effectiveTimestampMs({})).toBe(0);
+  });
+});
+
+describe('mergeByKey', () => {
+  it('keeps the record with the newer updated_at for the same key (one record out)', () => {
+    const older: Book = { book_hash: 'h1', updated_at: T1, value: 'old' };
+    const newer: Book = { book_hash: 'h1', updated_at: T2, value: 'new' };
+
+    const merged = mergeByKey([older, newer], bookKeyOf);
+
+    expect(merged).toHaveLength(1);
+    expect(merged[0]).toBe(newer);
+  });
+
+  it('lets a later deleted_at beat an earlier updated_at (tombstone wins)', () => {
+    const updated: Book = { book_hash: 'h1', updated_at: T1, value: 'live' };
+    const deleted: Book = { book_hash: 'h1', updated_at: T1, deleted_at: T2 };
+
+    const merged = mergeByKey([updated, deleted], bookKeyOf);
+
+    expect(merged).toEqual([deleted]);
+  });
+
+  it('lets a later updated_at beat an earlier deleted_at (resurrection wins)', () => {
+    const deleted: Book = { book_hash: 'h1', updated_at: T1, deleted_at: T1 };
+    const updated: Book = { book_hash: 'h1', updated_at: T3, value: 'back' };
+
+    const merged = mergeByKey([deleted, updated], bookKeyOf);
+
+    expect(merged).toEqual([updated]);
+  });
+
+  it('breaks an equal-effective-timestamp tie in favour of the delete', () => {
+    const updated: Book = { book_hash: 'h1', updated_at: T2, value: 'live' };
+    const deleted: Book = { book_hash: 'h1', updated_at: T1, deleted_at: T2 };
+
+    // Both have effective ms == T2; the delete must win the tie (server checks
+    // deletedAt first).
+    expect(mergeByKey([updated, deleted], bookKeyOf)).toEqual([deleted]);
+    expect(mergeByKey([deleted, updated], bookKeyOf)).toEqual([deleted]);
+  });
+
+  it('is order-independent: shuffling the input yields the same winner', () => {
+    const a: Book = { book_hash: 'h1', updated_at: T1, value: 'a' };
+    const b: Book = { book_hash: 'h1', updated_at: T3, value: 'b' };
+    const c: Book = { book_hash: 'h1', updated_at: T2, value: 'c' };
+
+    const forward = mergeByKey([a, b, c], bookKeyOf);
+    const shuffled = mergeByKey([c, a, b], bookKeyOf);
+    const reversed = mergeByKey([b, c, a], bookKeyOf);
+
+    expect(forward).toEqual([b]);
+    expect(shuffled).toEqual([b]);
+    expect(reversed).toEqual([b]);
+  });
+
+  it('keeps the first-seen record on an exact tie (incumbent wins, like the server)', () => {
+    // Same effective instant and same (absent) deleted_at, different payloads:
+    // neither is provably newer, so the fold keeps whichever was seen first —
+    // mirroring the server keeping its incumbent `serverData` when the client
+    // is not strictly newer. Pinned so this convergence behavior can't regress.
+    const first: Book = { book_hash: 'h1', updated_at: T2, value: 'first' };
+    const second: Book = { book_hash: 'h1', updated_at: T2, value: 'second' };
+
+    expect(mergeByKey([first, second], bookKeyOf)).toEqual([first]);
+    expect(mergeByKey([second, first], bookKeyOf)).toEqual([second]);
+  });
+
+  it('retains every distinct key', () => {
+    const h1: Book = { book_hash: 'h1', updated_at: T1 };
+    const h2: Book = { book_hash: 'h2', updated_at: T1 };
+
+    const merged = mergeByKey([h1, h2], bookKeyOf);
+
+    expect(merged).toHaveLength(2);
+    expect(merged).toEqual(expect.arrayContaining([h1, h2]));
+  });
+
+  it('returns an empty array for empty input', () => {
+    expect(mergeByKey([], bookKeyOf)).toEqual([]);
+  });
+
+  it('keys notes by book_hash|id: same hash, different id stay distinct', () => {
+    const n1: Note = { book_hash: 'h1', id: 'n1', updated_at: T1 };
+    const n2: Note = { book_hash: 'h1', id: 'n2', updated_at: T1 };
+
+    const merged = mergeByKey([n1, n2], noteKeyOf);
+
+    expect(merged).toHaveLength(2);
+    expect(merged).toEqual(expect.arrayContaining([n1, n2]));
+  });
+
+  it('keys notes by book_hash|id: same hash and same id merge to the newer', () => {
+    const older: Note = { book_hash: 'h1', id: 'n1', updated_at: T1, value: 'old' };
+    const newer: Note = { book_hash: 'h1', id: 'n1', updated_at: T2, value: 'new' };
+
+    expect(mergeByKey([older, newer], noteKeyOf)).toEqual([newer]);
+  });
+});
+
+describe('changedSinceMs', () => {
+  const since = parseIsoMs(T2);
+
+  it('includes a record whose updated_at is strictly after since', () => {
+    const rec: Book = { book_hash: 'h1', updated_at: T3 };
+    expect(changedSinceMs([rec], since)).toEqual([rec]);
+  });
+
+  it('excludes a record updated exactly at since (strict greater-than)', () => {
+    const rec: Book = { book_hash: 'h1', updated_at: T2 };
+    expect(changedSinceMs([rec], since)).toEqual([]);
+  });
+
+  it('excludes a record updated before since', () => {
+    const rec: Book = { book_hash: 'h1', updated_at: T1 };
+    expect(changedSinceMs([rec], since)).toEqual([]);
+  });
+
+  it('includes a record deleted after since even if updated before', () => {
+    const rec: Book = { book_hash: 'h1', updated_at: T1, deleted_at: T3 };
+    expect(changedSinceMs([rec], since)).toEqual([rec]);
+  });
+
+  it('filters a mixed batch to only those changed after since', () => {
+    const stale: Book = { book_hash: 'h1', updated_at: T1 };
+    const atCursor: Book = { book_hash: 'h2', updated_at: T2 };
+    const fresh: Book = { book_hash: 'h3', updated_at: T3 };
+    const tombstoned: Book = { book_hash: 'h4', updated_at: T1, deleted_at: T3 };
+
+    expect(changedSinceMs([stale, atCursor, fresh, tombstoned], since)).toEqual([
+      fresh,
+      tombstoned,
+    ]);
+  });
+});
+
+describe('key extractors', () => {
+  it('bookKeyOf returns the book_hash', () => {
+    expect(bookKeyOf({ book_hash: 'h1' })).toBe('h1');
+  });
+
+  it('configKeyOf is keyed by book_hash (same as bookKeyOf)', () => {
+    expect(configKeyOf({ book_hash: 'h1' })).toBe('h1');
+  });
+
+  it('noteKeyOf joins book_hash and id with the separator', () => {
+    expect(noteKeyOf({ book_hash: 'h1', id: 'n1' })).toBe('h1|n1');
+  });
+
+  it('noteKeyOf keeps distinct (book_hash, id) pairs distinct', () => {
+    // book_hash is a content hash and id a row id, so neither contains the
+    // separator in practice; the join keeps every real pair distinct. (We
+    // mirror the server's `join('|')`, which carries the same theoretical
+    // ambiguity for separator-bearing values and likewise relies on the inputs
+    // not containing it.)
+    expect(noteKeyOf({ book_hash: 'h1', id: 'n1' })).not.toBe(
+      noteKeyOf({ book_hash: 'h1', id: 'n2' }),
+    );
+    expect(noteKeyOf({ book_hash: 'h1', id: 'n1' })).not.toBe(
+      noteKeyOf({ book_hash: 'h2', id: 'n1' }),
+    );
+  });
+});
diff --git a/apps/readest-app/src/__tests__/drivesync/driveStorageBridge.test.ts b/apps/readest-app/src/__tests__/drivesync/driveStorageBridge.test.ts
new file mode 100644
index 00000000..8572407e
--- /dev/null
+++ b/apps/readest-app/src/__tests__/drivesync/driveStorageBridge.test.ts
@@ -0,0 +1,102 @@
+import { describe, it, expect, afterEach } from 'vitest';
+import { FakeCloudProvider } from '@/services/cloudprovider/FakeCloudProvider';
+import { setCloudProviderForTest, clearCloudProvider } from '@/services/drivesync/cloudSyncContext';
+import {
+  cloudPath,
+  contentTypeForFilename,
+  uploadCloudFileBytes,
+  downloadCloudFileBytes,
+  deleteCloudFileByPath,
+} from '@/services/drivesync/driveStorageBridge';
+
+// The bridge reaches the provider through the app-wide singleton in
+// cloudSyncContext, so reset it after every test to keep the suite
+// order-independent (no provider leaks from one case into the next).
+afterEach(() => clearCloudProvider());
+
+describe('driveStorageBridge', () => {
+  it('maps a cfp onto the Readest app-root logical path', () => {
+    expect(cloudPath('Books/abc.epub')).toBe('Readest/Books/abc.epub');
+  });
+
+  it('uploads bytes to Readest/<cfp> on the active provider', async () => {
+    const cloud = new FakeCloudProvider();
+    setCloudProviderForTest(cloud);
+    const bytes = new TextEncoder().encode('EPUBDATA').buffer;
+
+    await uploadCloudFileBytes('Books/abc.epub', bytes);
+
+    // Assert against the literal logical path the provider stores at, so a
+    // mapping regression cannot hide behind the bridge's own round-trip.
+    const entry = await cloud.stat('Readest/Books/abc.epub');
+    expect(entry?.path).toBe('Readest/Books/abc.epub');
+    const stored = await cloud.getBinary('Readest/Books/abc.epub');
+    expect(stored && new TextDecoder().decode(stored)).toBe('EPUBDATA');
+  });
+
+  it('downloads bytes previously uploaded under the same cfp', async () => {
+    setCloudProviderForTest(new FakeCloudProvider());
+    const bytes = new TextEncoder().encode('COVERPNG').buffer;
+    await uploadCloudFileBytes('Books/cover.png', bytes);
+
+    const got = await downloadCloudFileBytes('Books/cover.png');
+    expect(got && new TextDecoder().decode(got)).toBe('COVERPNG');
+  });
+
+  it('returns null when downloading a cfp that was never uploaded', async () => {
+    setCloudProviderForTest(new FakeCloudProvider());
+    expect(await downloadCloudFileBytes('Books/missing.epub')).toBeNull();
+  });
+
+  it('deletes the cloud file mapped from a cfp', async () => {
+    const cloud = new FakeCloudProvider();
+    setCloudProviderForTest(cloud);
+    await uploadCloudFileBytes('Books/abc.epub', new ArrayBuffer(8));
+    expect(await cloud.stat('Readest/Books/abc.epub')).not.toBeNull();
+
+    await deleteCloudFileByPath('Books/abc.epub');
+    expect(await cloud.stat('Readest/Books/abc.epub')).toBeNull();
+  });
+
+  it('forwards the progress callback on upload', async () => {
+    setCloudProviderForTest(new FakeCloudProvider());
+    const progress: Array<[number, number]> = [];
+    await uploadCloudFileBytes('Books/abc.epub', new ArrayBuffer(10), undefined, (sent, total) => {
+      progress.push([sent, total]);
+    });
+    // FakeCloudProvider reports a single terminal event; the bridge must forward it.
+    expect(progress).toEqual([[10, 10]]);
+  });
+
+  it('forwards the chosen content type to the provider', async () => {
+    const cloud = new FakeCloudProvider();
+    setCloudProviderForTest(cloud);
+    await uploadCloudFileBytes('Books/abc.epub', new ArrayBuffer(4), 'application/epub+zip');
+    // The fake stores the content type alongside the body; surface it via getText
+    // is not possible, so re-stat is enough to prove the path landed — content
+    // type correctness is asserted via the public mapping below.
+    expect(await cloud.stat('Readest/Books/abc.epub')).not.toBeNull();
+  });
+
+  describe('contentTypeForFilename', () => {
+    it('maps known book and image extensions to their MIME types', () => {
+      expect(contentTypeForFilename('book.epub')).toBe('application/epub+zip');
+      expect(contentTypeForFilename('book.pdf')).toBe('application/pdf');
+      expect(contentTypeForFilename('cover.png')).toBe('image/png');
+    });
+
+    it('is case-insensitive on the extension', () => {
+      expect(contentTypeForFilename('BOOK.EPUB')).toBe('application/epub+zip');
+    });
+
+    it('maps a hashed path filename by its extension', () => {
+      expect(contentTypeForFilename('abc123/Title.epub')).toBe('application/epub+zip');
+    });
+
+    it('falls back to octet-stream for unknown or extensionless names', () => {
+      expect(contentTypeForFilename('book.unknownext')).toBe('application/octet-stream');
+      expect(contentTypeForFilename('noextension')).toBe('application/octet-stream');
+      expect(contentTypeForFilename('.hidden')).toBe('application/octet-stream');
+    });
+  });
+});
diff --git a/apps/readest-app/src/__tests__/drivesync/driveSyncClient.test.ts b/apps/readest-app/src/__tests__/drivesync/driveSyncClient.test.ts
new file mode 100644
index 00000000..e0f2c212
--- /dev/null
+++ b/apps/readest-app/src/__tests__/drivesync/driveSyncClient.test.ts
@@ -0,0 +1,423 @@
+import { describe, it, expect } from 'vitest';
+import { FakeCloudProvider } from '@/services/cloudprovider/FakeCloudProvider';
+import { DriveSyncClient } from '@/services/drivesync/DriveSyncClient';
+import { deviceSyncPath } from '@/services/drivesync/layout';
+import type { Book, BookConfig, BookNote } from '@/types/book';
+import type { StatBookRecord, StatPageRecord } from '@/libs/sync';
+
+// ---------------------------------------------------------------------------
+// Test scaffolding: two "devices" = two DriveSyncClient instances sharing ONE
+// FakeCloudProvider. This is the whole point of the per-device layout — each
+// client writes its own folder, both read the union, and the merge happens on
+// read. A shared provider is exactly what two real devices syncing through the
+// same Google Drive look like.
+// ---------------------------------------------------------------------------
+
+const DEVICE_A = 'A';
+const DEVICE_B = 'B';
+
+/** Build a client bound to one device id over a shared provider. */
+const clientFor = (provider: FakeCloudProvider, deviceId: string): DriveSyncClient =>
+  new DriveSyncClient({ provider, getDeviceId: () => deviceId });
+
+/**
+ * Build a client with an injected fixed clock, so the `updated_at` it stamps on
+ * pushed stat rows is deterministic and the changed-since cursor can be tested
+ * against a known instant.
+ */
+const clientAt = (provider: FakeCloudProvider, deviceId: string, nowMs: number): DriveSyncClient =>
+  new DriveSyncClient({ provider, getDeviceId: () => deviceId, now: () => nowMs });
+
+// Distinct, ordered epoch-ms instants so the expected LWW winner is obvious.
+const T1 = 1_700_000_000_000;
+const T2 = 1_700_000_100_000;
+const T3 = 1_700_000_200_000;
+
+const BOOK_HASH_X = 'hashX';
+const BOOK_HASH_Y = 'hashY';
+
+/** App-shaped Book fixture (the input to pushChanges, pre-transform). */
+const makeBook = (overrides: Partial<Book> = {}): Book => ({
+  hash: BOOK_HASH_X,
+  format: 'EPUB',
+  title: 'Title X',
+  author: 'Author X',
+  createdAt: T1,
+  updatedAt: T1,
+  ...overrides,
+});
+
+/** App-shaped BookConfig fixture. */
+const makeConfig = (overrides: Partial<BookConfig> = {}): BookConfig => ({
+  bookHash: BOOK_HASH_X,
+  updatedAt: T1,
+  ...overrides,
+});
+
+/** App-shaped BookNote fixture. */
+const makeNote = (overrides: Partial<BookNote> = {}): BookNote => ({
+  bookHash: BOOK_HASH_X,
+  id: 'note1',
+  type: 'annotation',
+  cfi: 'epubcfi(/6/2)',
+  note: 'a note',
+  createdAt: T1,
+  updatedAt: T1,
+  ...overrides,
+});
+
+/** StatBookRecord fixture (already DB-shaped — stats carry no app transform). */
+const makeStatBook = (overrides: Partial<StatBookRecord> = {}): StatBookRecord => ({
+  book_hash: BOOK_HASH_X,
+  title: 'Title X',
+  authors: 'Author X',
+  ...overrides,
+});
+
+/** StatPageRecord fixture (DB-shaped). */
+const makeStatPage = (overrides: Partial<StatPageRecord> = {}): StatPageRecord => ({
+  book_hash: BOOK_HASH_X,
+  page: 1,
+  start_time: 1000,
+  duration: 10,
+  total_pages: 300,
+  ...overrides,
+});
+
+describe('DriveSyncClient — cross-device round-trip', () => {
+  it('device A push → device B pull sees the book (DB-shaped, correct book_hash)', async () => {
+    const provider = new FakeCloudProvider();
+    const clientA = clientFor(provider, DEVICE_A);
+    const clientB = clientFor(provider, DEVICE_B);
+
+    await clientA.pushChanges({ books: [makeBook()] as Book[] });
+    const pulled = await clientB.pullChanges(0, 'books');
+
+    expect(pulled.books).toHaveLength(1);
+    expect(pulled.books![0]!.book_hash).toBe(BOOK_HASH_X);
+    // DB-shaped: ISO updated_at, not the app's epoch-ms updatedAt.
+    expect(pulled.books![0]!.updated_at).toBe(new Date(T1).toISOString());
+    // Kinds not queried come back null (mirrors the server response shape).
+    expect(pulled.configs).toBeNull();
+    expect(pulled.notes).toBeNull();
+  });
+});
+
+describe('DriveSyncClient — LWW across devices', () => {
+  it('newer copy wins regardless of which device pushed it', async () => {
+    const provider = new FakeCloudProvider();
+    const clientA = clientFor(provider, DEVICE_A);
+    const clientB = clientFor(provider, DEVICE_B);
+
+    await clientA.pushChanges({ books: [makeBook({ updatedAt: T1, title: 'old' })] as Book[] });
+    await clientB.pushChanges({ books: [makeBook({ updatedAt: T2, title: 'new' })] as Book[] });
+
+    const pulled = await clientA.pullChanges(0, 'books');
+    expect(pulled.books).toHaveLength(1);
+    expect(pulled.books![0]!.updated_at).toBe(new Date(T2).toISOString());
+    expect(pulled.books![0]!.title).toBe('new');
+  });
+
+  it('newer copy still wins when pushed in the reverse order', async () => {
+    const provider = new FakeCloudProvider();
+    const clientA = clientFor(provider, DEVICE_A);
+    const clientB = clientFor(provider, DEVICE_B);
+
+    // Newer first, older second — winner must not depend on push order.
+    await clientB.pushChanges({ books: [makeBook({ updatedAt: T2, title: 'new' })] as Book[] });
+    await clientA.pushChanges({ books: [makeBook({ updatedAt: T1, title: 'old' })] as Book[] });
+
+    const pulled = await clientB.pullChanges(0, 'books');
+    expect(pulled.books).toHaveLength(1);
+    expect(pulled.books![0]!.title).toBe('new');
+  });
+});
+
+describe('DriveSyncClient — tombstone propagation', () => {
+  it('a later delete is returned so a peer can apply the deletion', async () => {
+    const provider = new FakeCloudProvider();
+    const clientA = clientFor(provider, DEVICE_A);
+    const clientB = clientFor(provider, DEVICE_B);
+
+    await clientA.pushChanges({ books: [makeBook({ updatedAt: T1 })] as Book[] });
+    await clientA.pushChanges({
+      books: [makeBook({ updatedAt: T2, deletedAt: T3 })] as Book[],
+    });
+
+    const pulled = await clientB.pullChanges(0, 'books');
+    expect(pulled.books).toHaveLength(1);
+    expect(pulled.books![0]!.deleted_at).toBe(new Date(T3).toISOString());
+  });
+});
+
+describe('DriveSyncClient — changed-since cursor', () => {
+  it('pull returns only records changed strictly after the cursor', async () => {
+    const provider = new FakeCloudProvider();
+    const clientA = clientFor(provider, DEVICE_A);
+
+    await clientA.pushChanges({
+      books: [
+        makeBook({ hash: BOOK_HASH_X, updatedAt: T1 }),
+        makeBook({ hash: BOOK_HASH_Y, updatedAt: T3 }),
+      ] as Book[],
+    });
+
+    // Cursor between T1 and T3: only the Y book (T3) is newer than it.
+    const pulled = await clientA.pullChanges(T2, 'books');
+    expect(pulled.books).toHaveLength(1);
+    expect(pulled.books![0]!.book_hash).toBe(BOOK_HASH_Y);
+  });
+});
+
+describe('DriveSyncClient — per-device write isolation', () => {
+  it("a push writes only the pushing device's own file", async () => {
+    const provider = new FakeCloudProvider();
+    const clientA = clientFor(provider, DEVICE_A);
+
+    await clientA.pushChanges({ books: [makeBook()] as Book[] });
+
+    expect(await provider.stat(deviceSyncPath(DEVICE_A, 'books'))).not.toBeNull();
+    expect(await provider.stat(deviceSyncPath(DEVICE_B, 'books'))).toBeNull();
+  });
+});
+
+describe('DriveSyncClient — push returns cross-device authoritative records', () => {
+  it("an older push gets back a peer's newer record in the push result", async () => {
+    const provider = new FakeCloudProvider();
+    const clientA = clientFor(provider, DEVICE_A);
+    const clientB = clientFor(provider, DEVICE_B);
+
+    // B already holds the newer copy.
+    await clientB.pushChanges({ books: [makeBook({ updatedAt: T2, title: 'new' })] as Book[] });
+
+    // A pushes an OLDER copy; the authoritative result must reflect B's winner.
+    const result = await clientA.pushChanges({
+      books: [makeBook({ updatedAt: T1, title: 'old' })] as Book[],
+    });
+
+    expect(result.books).toHaveLength(1);
+    expect(result.books![0]!.updated_at).toBe(new Date(T2).toISOString());
+    expect(result.books![0]!.title).toBe('new');
+    // A's own file still carries A's own copy (write isolation), but the
+    // RESPONSE is the cross-device winner.
+    const aOwn = await provider.getText(deviceSyncPath(DEVICE_A, 'books'));
+    expect(aOwn).toContain('old');
+  });
+});
+
+describe('DriveSyncClient — per-book filter (configs)', () => {
+  it("pull for a single book returns only that book's config", async () => {
+    const provider = new FakeCloudProvider();
+    const clientA = clientFor(provider, DEVICE_A);
+
+    await clientA.pushChanges({
+      configs: [
+        makeConfig({ bookHash: BOOK_HASH_X }),
+        makeConfig({ bookHash: BOOK_HASH_Y }),
+      ] as BookConfig[],
+    });
+
+    const pulled = await clientA.pullChanges(0, 'configs', BOOK_HASH_X);
+    expect(pulled.configs).toHaveLength(1);
+    expect(pulled.configs![0]!.book_hash).toBe(BOOK_HASH_X);
+  });
+});
+
+describe('DriveSyncClient — configs + notes round-trip', () => {
+  it('config round-trips cross-device (DB-shaped, correct book_hash)', async () => {
+    const provider = new FakeCloudProvider();
+    const clientA = clientFor(provider, DEVICE_A);
+    const clientB = clientFor(provider, DEVICE_B);
+
+    await clientA.pushChanges({
+      configs: [makeConfig({ bookHash: BOOK_HASH_X, location: 'loc1' })] as BookConfig[],
+    });
+    const pulled = await clientB.pullChanges(0, 'configs');
+
+    expect(pulled.configs).toHaveLength(1);
+    expect(pulled.configs![0]!.book_hash).toBe(BOOK_HASH_X);
+    expect(pulled.configs![0]!.location).toBe('loc1');
+  });
+
+  it('two notes for the same book with different ids both survive (composite key)', async () => {
+    const provider = new FakeCloudProvider();
+    const clientA = clientFor(provider, DEVICE_A);
+    const clientB = clientFor(provider, DEVICE_B);
+
+    await clientA.pushChanges({
+      notes: [
+        makeNote({ bookHash: BOOK_HASH_X, id: 'note1' }),
+        makeNote({ bookHash: BOOK_HASH_X, id: 'note2' }),
+      ] as BookNote[],
+    });
+    const pulled = await clientB.pullChanges(0, 'notes');
+
+    expect(pulled.notes).toHaveLength(2);
+    const ids = pulled.notes!.map((n) => n.id).sort();
+    expect(ids).toEqual(['note1', 'note2']);
+  });
+});
+
+describe('DriveSyncClient — pull with no type pulls all three kinds', () => {
+  it('populates books, configs, and notes when no type is given', async () => {
+    const provider = new FakeCloudProvider();
+    const clientA = clientFor(provider, DEVICE_A);
+
+    await clientA.pushChanges({ books: [makeBook()] as Book[] });
+    await clientA.pushChanges({ configs: [makeConfig()] as BookConfig[] });
+    await clientA.pushChanges({ notes: [makeNote()] as BookNote[] });
+
+    const pulled = await clientA.pullChanges(0);
+    expect(pulled.books).toHaveLength(1);
+    expect(pulled.configs).toHaveLength(1);
+    expect(pulled.notes).toHaveLength(1);
+  });
+});
+
+describe('DriveSyncClient — stats cross-device round-trip', () => {
+  it('A push → B pull sees statBooks + statPages with updated_at_ms attached', async () => {
+    const provider = new FakeCloudProvider();
+    const clientA = clientAt(provider, DEVICE_A, T1);
+    const clientB = clientAt(provider, DEVICE_B, T1);
+
+    await clientA.pushChanges({
+      statBooks: [makeStatBook()],
+      statPages: [makeStatPage()],
+    });
+    const pulled = await clientB.pullChanges(0, 'stats');
+
+    // Record kinds are null (not queried); stat kinds carry the pushed rows.
+    expect(pulled.books).toBeNull();
+    expect(pulled.configs).toBeNull();
+    expect(pulled.notes).toBeNull();
+
+    expect(pulled.statBooks).toHaveLength(1);
+    expect(pulled.statBooks![0]!.book_hash).toBe(BOOK_HASH_X);
+    // Server stamps updated_at on push; mirror that so the cursor advances.
+    expect(pulled.statBooks![0]!.updated_at).toBe(new Date(T1).toISOString());
+    // updated_at_ms is attached for the consumer's cursor math (> 0).
+    expect(pulled.statBooks![0]!.updated_at_ms).toBe(T1);
+    expect(pulled.statBooks![0]!.updated_at_ms).toBeGreaterThan(0);
+
+    expect(pulled.statPages).toHaveLength(1);
+    expect(pulled.statPages![0]!.duration).toBe(10);
+    expect(pulled.statPages![0]!.updated_at_ms).toBe(T1);
+    expect(pulled.statPages![0]!.updated_at_ms).toBeGreaterThan(0);
+  });
+});
+
+describe('DriveSyncClient — statPages longest-duration-wins across devices', () => {
+  it('the longer duration for a key wins regardless of which device pushed it', async () => {
+    const provider = new FakeCloudProvider();
+    const clientA = clientAt(provider, DEVICE_A, T1);
+    const clientB = clientAt(provider, DEVICE_B, T1);
+
+    // Same page key (default fixture), different durations across devices.
+    await clientA.pushChanges({ statPages: [makeStatPage({ duration: 10 })] });
+    await clientB.pushChanges({ statPages: [makeStatPage({ duration: 25 })] });
+
+    const pulled = await clientA.pullChanges(0, 'stats');
+    expect(pulled.statPages).toHaveLength(1);
+    expect(pulled.statPages![0]!.duration).toBe(25);
+  });
+
+  it('the longer duration still wins when pushed in the reverse order', async () => {
+    const provider = new FakeCloudProvider();
+    const clientA = clientAt(provider, DEVICE_A, T1);
+    const clientB = clientAt(provider, DEVICE_B, T1);
+
+    await clientB.pushChanges({ statPages: [makeStatPage({ duration: 25 })] });
+    await clientA.pushChanges({ statPages: [makeStatPage({ duration: 10 })] });
+
+    const pulled = await clientB.pullChanges(0, 'stats');
+    expect(pulled.statPages).toHaveLength(1);
+    expect(pulled.statPages![0]!.duration).toBe(25);
+  });
+
+  it('a shorter LATER push does not lower an already-longer duration', async () => {
+    const provider = new FakeCloudProvider();
+    const clientA = clientAt(provider, DEVICE_A, T1);
+    const clientB = clientAt(provider, DEVICE_B, T1);
+
+    await clientB.pushChanges({ statPages: [makeStatPage({ duration: 25 })] });
+    // A later push (newer write time) of a SHORTER duration must not win — the
+    // merge is by duration, not by timestamp.
+    const clientALater = clientAt(provider, DEVICE_A, T2);
+    await clientALater.pushChanges({ statPages: [makeStatPage({ duration: 5 })] });
+
+    const pulled = await clientA.pullChanges(0, 'stats');
+    expect(pulled.statPages).toHaveLength(1);
+    expect(pulled.statPages![0]!.duration).toBe(25);
+  });
+});
+
+describe('DriveSyncClient — statBooks LWW across devices', () => {
+  it('the newest updated_at for a book_hash wins regardless of push order', async () => {
+    const provider = new FakeCloudProvider();
+    const clientA = clientAt(provider, DEVICE_A, T1);
+    const clientB = clientAt(provider, DEVICE_B, T2);
+
+    // B writes later (T2) → its title is the LWW winner for the same book_hash.
+    await clientA.pushChanges({ statBooks: [makeStatBook({ title: 'old' })] });
+    await clientB.pushChanges({ statBooks: [makeStatBook({ title: 'new' })] });
+
+    const pulled = await clientA.pullChanges(0, 'stats');
+    expect(pulled.statBooks).toHaveLength(1);
+    expect(pulled.statBooks![0]!.title).toBe('new');
+    expect(pulled.statBooks![0]!.updated_at).toBe(new Date(T2).toISOString());
+  });
+});
+
+describe('DriveSyncClient — stats changed-since cursor uses the stamped updated_at', () => {
+  it('pull since between two push times returns only the later rows', async () => {
+    const provider = new FakeCloudProvider();
+    const clientAtT1 = clientAt(provider, DEVICE_A, T1);
+    const clientAtT3 = clientAt(provider, DEVICE_A, T3);
+
+    // Two DISTINCT page keys stamped at different write times.
+    await clientAtT1.pushChanges({ statPages: [makeStatPage({ start_time: 1000 })] });
+    await clientAtT3.pushChanges({ statPages: [makeStatPage({ start_time: 9000 })] });
+
+    // Cursor at T2 (between T1 and T3): only the T3 row is newer.
+    const pulled = await clientAtT1.pullChanges(T2, 'stats');
+    expect(pulled.statPages).toHaveLength(1);
+    expect(pulled.statPages![0]!.start_time).toBe(9000);
+    expect(pulled.statPages![0]!.updated_at_ms).toBe(T3);
+  });
+});
+
+describe('DriveSyncClient — stats per-device write isolation', () => {
+  it("a stats push writes only the pushing device's own stat files", async () => {
+    const provider = new FakeCloudProvider();
+    const clientA = clientAt(provider, DEVICE_A, T1);
+
+    await clientA.pushChanges({
+      statBooks: [makeStatBook()],
+      statPages: [makeStatPage()],
+    });
+
+    expect(await provider.stat(deviceSyncPath(DEVICE_A, 'statBooks'))).not.toBeNull();
+    expect(await provider.stat(deviceSyncPath(DEVICE_A, 'statPages'))).not.toBeNull();
+    expect(await provider.stat(deviceSyncPath(DEVICE_B, 'statBooks'))).toBeNull();
+    expect(await provider.stat(deviceSyncPath(DEVICE_B, 'statPages'))).toBeNull();
+  });
+});
+
+describe('DriveSyncClient — statPages-only push', () => {
+  it('works with no statBooks present', async () => {
+    const provider = new FakeCloudProvider();
+    const clientA = clientAt(provider, DEVICE_A, T1);
+    const clientB = clientAt(provider, DEVICE_B, T1);
+
+    await clientA.pushChanges({ statPages: [makeStatPage({ duration: 42 })] });
+    const pulled = await clientB.pullChanges(0, 'stats');
+
+    // No statBooks file was written, so the merged statBooks set is empty.
+    expect(pulled.statBooks).toEqual([]);
+    expect(pulled.statPages).toHaveLength(1);
+    expect(pulled.statPages![0]!.duration).toBe(42);
+    // The pushing device wrote a statPages file but not a statBooks file.
+    expect(await provider.stat(deviceSyncPath(DEVICE_A, 'statPages'))).not.toBeNull();
+    expect(await provider.stat(deviceSyncPath(DEVICE_A, 'statBooks'))).toBeNull();
+  });
+});
