+import { isCloudConfigured } from './cloudSyncContext';
+
+/**
+ * Whether sync should run. Readest's stock gates require a logged-in `user`;
+ * this also enables sync when the user has connected their own cloud (Drive),
+ * so the mod works fully standalone with NO Readest account. A logged-in user
