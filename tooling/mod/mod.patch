+describe('GoogleDriveProvider auth header', () => {
+  it('sends Bearer <token> on every call', async () => {
+    const tree = new Map<string, MockFile>([['root/a', { id: 'A' }]]);
+    const bodies = new Map([['A', 'X']]);
+    const { fetchFn, calls } = makeFetch(tree, bodies);
+    const p = new GoogleDriveProvider(mockAuth, fetchFn);
+    await p.getText('a');
+    expect(calls.length).toBeGreaterThan(0);
+    for (const c of calls) {
