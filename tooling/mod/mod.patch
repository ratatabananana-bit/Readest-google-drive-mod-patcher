diff --git a/apps/readest-app/src/services/drivesync/DriveBlobStore.ts b/apps/readest-app/src/services/drivesync/DriveBlobStore.ts
new file mode 100644
index 00000000..bc9a4c1d
--- /dev/null
+++ b/apps/readest-app/src/services/drivesync/DriveBlobStore.ts
@@ -0,0 +1,111 @@
+import type { CloudProvider, ProgressHandler } from '../cloudprovider/CloudProvider';
+import { bookBlobPath, coverBlobPath } from './layout';
+
+/**
+ * MIME types for the book formats Readest knows how to store. The cloud file's
+ * content type matters: providers (and any future direct-share links) serve the
+ * blob back with it, so a wrong type can make a download open as plain bytes
+ * instead of an EPUB/PDF. Keyed by the *normalized* (lower-case) extension.
+ *
+ * Typed with a `| undefined` value so an unknown extension is statically known
+ * to miss (this project does not enable `noUncheckedIndexedAccess`), which keeps
+ * the fallback in {@link bookContentType} type-justified rather than dead code.
+ */
+const BOOK_CONTENT_TYPES: Readonly<Record<string, string | undefined>> = {
+  epub: 'application/epub+zip',
+  pdf: 'application/pdf',
+};
+
+/**
+ * Fallback content type for book formats not in {@link BOOK_CONTENT_TYPES} — the
+ * standard "opaque byte stream" type. The blob still round-trips correctly; only
+ * the advertised MIME type is generic.
+ */
+const FALLBACK_BOOK_CONTENT_TYPE = 'application/octet-stream';
+
+/**
+ * Content type for cover blobs. Covers are always PNG (see {@link coverBlobPath}
+ * / layout), so this is a constant rather than a per-call argument.
+ */
+const COVER_CONTENT_TYPE = 'image/png';
+
+/**
+ * Readest's book/cover binary storage API, expressed over a {@link CloudProvider}.
+ *
+ * This is the drop-in replacement for the old server-backed `/api/storage/*`
+ * transfer: it maps a book's content hash + format to a stable logical blob path
+ * and delegates every transfer to the injected provider. Because it depends only
+ * on the {@link CloudProvider} seam it is fully unit-testable against the
+ * in-memory `FakeCloudProvider` with no network. Identity and quota are no longer
+ * its concern — the user's own cloud account is the namespace and enforces quota.
+ */
+export class DriveBlobStore {
+  constructor(private readonly cloud: CloudProvider) {}
+
+  /**
+   * Upload a book body, keyed by its content hash and format extension.
+   *
+   * @param hash - Content hash uniquely identifying the book.
+   * @param ext - Format extension (case-insensitive; normalized internally).
+   * @param bytes - The book body.
+   * @param onProgress - Optional upload-progress callback, forwarded verbatim.
+   */
+  async uploadBook(
+    hash: string,
+    ext: string,
+    bytes: ArrayBuffer,
+    onProgress?: ProgressHandler,
+  ): Promise<void> {
+    const normalizedExt = normalizeExt(ext);
+    await this.cloud.putBinary(
+      bookBlobPath(hash, normalizedExt),
+      bytes,
+      bookContentType(normalizedExt),
+      onProgress,
+    );
+  }
+
+  /**
+   * Download a book body.
+   *
+   * @returns The book body, or `null` when no blob exists for this hash+ext.
+   */
+  async downloadBook(hash: string, ext: string): Promise<ArrayBuffer | null> {
+    return this.cloud.getBinary(bookBlobPath(hash, normalizeExt(ext)));
+  }
+
+  /** Whether a book body exists in the cloud for this hash+ext. */
+  async hasBook(hash: string, ext: string): Promise<boolean> {
+    const entry = await this.cloud.stat(bookBlobPath(hash, normalizeExt(ext)));
+    return entry !== null;
+  }
+
+  /**
+   * Upload a cover image. Always stored as PNG (see layout), so no extension or
+   * content type is taken from the caller.
+   */
+  async uploadCover(hash: string, bytes: ArrayBuffer): Promise<void> {
+    await this.cloud.putBinary(coverBlobPath(hash), bytes, COVER_CONTENT_TYPE);
+  }
+
+  /**
+   * Download a cover image.
+   *
+   * @returns The cover bytes, or `null` when no cover exists for this hash.
+   */
+  async downloadCover(hash: string): Promise<ArrayBuffer | null> {
+    return this.cloud.getBinary(coverBlobPath(hash));
+  }
+}
+
+/**
+ * Normalize a format extension to lower-case. Readest book formats can arrive
+ * upper/mixed case (e.g. `EPUB`); normalizing here — the single place every blob
+ * path is derived from — guarantees upload, download, and existence checks agree
+ * on one path.
+ */
+const normalizeExt = (ext: string): string => ext.toLowerCase();
+
+/** MIME type for a (normalized) book extension, falling back to octet-stream. */
+const bookContentType = (normalizedExt: string): string =>
+  BOOK_CONTENT_TYPES[normalizedExt] ?? FALLBACK_BOOK_CONTENT_TYPE;
diff --git a/apps/readest-app/src/services/drivesync/DriveSyncClient.ts b/apps/readest-app/src/services/drivesync/DriveSyncClient.ts
new file mode 100644
index 00000000..3f7cfce5
--- /dev/null
+++ b/apps/readest-app/src/services/drivesync/DriveSyncClient.ts
@@ -0,0 +1,506 @@
+/**
+ * {@link DriveSyncClient} — a drop-in replacement for Readest's server-backed
+ * {@link import('@/libs/sync').SyncClient}, syncing books / reading-position
+ * (configs) / notes through the user's OWN cloud storage instead of Readest's
+ * backend.
+ *
+ * Shape of the world (see {@link import('./layout').deviceSyncPath}): every
+ * device owns one folder under `Readest/sync/<deviceId>/` and writes only its
+ * own `<kind>.jsonl` replica there. The two halves of sync map onto that layout
+ * as follows:
+ *
+ *   - push: transform the app records to DB rows, LWW-merge them into THIS
+ *     device's own replica, and write only that file. Per-device write
+ *     isolation is what makes concurrent multi-device pushes safe — no device
+ *     ever overwrites a peer's file, so there are no lost updates.
+ *   - pull (and the push response): fan out across EVERY device's replica for
+ *     the kind and LWW-merge the union. A record is authoritative the instant
+ *     any device has written its newest copy; merge-on-read is what surfaces a
+ *     peer's newer record immediately, mirroring the server returning
+ *     post-merge authoritative rows.
+ *
+ * This client owns all the storage/merge orchestration; the pure pieces it
+ * composes — the LWW engine ({@link import('./driveMerge')}) and the JSONL codec
+ * ({@link import('./jsonl')}) — are unit-tested in isolation.
+ *
+ * KNOWN LIMITATION (do not fix here; see reference design R2): a single `since`
+ * cursor shared across devices can miss a peer record whose timestamp is older
+ * than the cursor but which only becomes visible after the cursor was advanced
+ * (the peer pushed late). This is mitigated by the existing boot
+ * full-resync/rewind in `useSync`, which periodically pulls from `since = 0`.
+ */
+
+import type { CloudProvider } from '../cloudprovider/CloudProvider';
+import type { StatBookRecord, StatPageRecord, SyncData, SyncResult, SyncType } from '@/libs/sync';
+import type { DBBook, DBBookConfig, DBBookNote } from '@/types/records';
+import {
+  transformBookToDB,
+  transformBookConfigToDB,
+  transformBookNoteToDB,
+} from '@/utils/transform';
+import {
+  bookKeyOf,
+  changedSinceMs,
+  configKeyOf,
+  mergeByKey,
+  noteKeyOf,
+  parseIsoMs,
+  type TimestampedRecord,
+} from './driveMerge';
+import { mergeStatPagesByDuration } from './statsMerge';
+import { parseJsonl, serializeJsonl } from './jsonl';
+import {
+  deviceSyncPath,
+  syncRootPath,
+  type StatKind,
+  type SyncKind,
+  type SyncRecordKind,
+} from './layout';
+
+/**
+ * Cosmetic `user_id` stamped onto every DB row this client writes.
+ *
+ * On the user's OWN cloud storage the account IS the namespace — there is no
+ * multi-tenant server table to partition by user. The DB `user_id` field exists
+ * only because the shared record shapes (and the app↔DB transforms) carry it;
+ * nothing in this sync path reads it. The merge keys are `book_hash` (+ `id` for
+ * notes), never `user_id`, and the reverse `transform*FromDB` the CALLER runs
+ * drops it. So a single stable constant is correct and keeps the rows uniform.
+ */
+export const DRIVE_NAMESPACE_USER_ID = 'drive';
+
+/** Union of the DB-shaped rows this client stores and returns. */
+type DBSyncRecord = DBBook | DBBookConfig | DBBookNote;
+
+/**
+ * Bridge a DB-shaped row array into a {@link SyncResult} slot.
+ *
+ * WHY a cast is needed: `SyncResult`'s slots are statically typed as the
+ * APP-shaped `BookRecord[]`/`BookConfigRecord[]`/`BookNoteRecord[]`, but the
+ * actual sync wire payload — and what this drop-in client returns, exactly like
+ * the server endpoint it replaces — is DB-shaped rows. The caller's reverse
+ * `transform*FromDB` re-hydrates them. The two shapes do not structurally
+ * overlap, so the hop goes through `unknown`. Centralised here so this single
+ * deliberate, documented bridge is the only place the shapes are reconciled —
+ * no bare casts scattered across the per-kind table.
+ */
+const toResultRows = <Slot>(records: DBSyncRecord[]): Slot => records as unknown as Slot;
+
+/**
+ * Per-kind wiring that drives BOTH push and pull, so neither path repeats
+ * per-kind logic (DRY). For each kind it captures, in one place:
+ *   - `kind`: the storage kind → its `<kind>.jsonl` replica path.
+ *   - `toDB`: the app→DB transform that stamps `updated_at`/`deleted_at` and the
+ *     cosmetic `user_id`.
+ *   - `keyOf`: the LWW primary key (book_hash, or book_hash+id for notes).
+ *   - `dataKey`: where incoming app records are read from a {@link SyncData}.
+ *   - `assignResult`: writes merged rows into the kind's {@link SyncResult} slot.
+ *     A method (rather than a bare key) because each slot has a DISTINCT element
+ *     type; indexing `SyncResult` by a union key would collapse to the
+ *     intersection of all three and reject the assignment. Writing through the
+ *     kind's own concrete `DB` type keeps every slot typed and `any`-free.
+ *
+ * The transform and key are typed to the kind's concrete record, so there is no
+ * `any` anywhere in the table; the shared merge/store machinery works over the
+ * {@link DBSyncRecord} union and each kind narrows back via `assignResult`.
+ */
+interface KindConfig<App, DB extends TimestampedRecord> {
+  readonly kind: SyncRecordKind;
+  readonly toDB: (record: App, userId: string) => DB;
+  readonly keyOf: (record: DB) => string;
+  readonly dataKey: 'books' | 'configs' | 'notes';
+  readonly assignResult: (result: SyncResult, records: DB[]) => void;
+}
+
+const BOOKS_CONFIG: KindConfig<Parameters<typeof transformBookToDB>[0], DBBook> = {
+  kind: 'books',
+  toDB: transformBookToDB,
+  keyOf: bookKeyOf,
+  dataKey: 'books',
+  assignResult: (result, records) => {
+    result.books = toResultRows(records);
+  },
+};
+
+const CONFIGS_CONFIG: KindConfig<Parameters<typeof transformBookConfigToDB>[0], DBBookConfig> = {
+  kind: 'configs',
+  toDB: transformBookConfigToDB,
+  keyOf: configKeyOf,
+  dataKey: 'configs',
+  assignResult: (result, records) => {
+    result.configs = toResultRows(records);
+  },
+};
+
+const NOTES_CONFIG: KindConfig<Parameters<typeof transformBookNoteToDB>[0], DBBookNote> = {
+  kind: 'notes',
+  toDB: transformBookNoteToDB,
+  keyOf: noteKeyOf,
+  dataKey: 'notes',
+  assignResult: (result, records) => {
+    result.notes = toResultRows(records);
+  },
+};
+
+/**
+ * One existential view over a {@link KindConfig} so the three differently-typed
+ * configs can share an array and the push/pull loops. `App` is erased to
+ * `never` (the loops only ever feed it values they immediately re-widen) and
+ * `DB` to the {@link DBSyncRecord} union the shared machinery operates on.
+ */
+type AnyKindConfig = KindConfig<never, DBSyncRecord>;
+
+/**
+ * The record kinds this client syncs, in a stable order. Stats are handled by a
+ * separate table ({@link STAT_KIND_CONFIGS}) because they merge by different
+ * rules and stamp a write-time cursor. The per-entry casts erase only the
+ * generic parameters (the runtime objects are unchanged); each config's own
+ * transform/key/assign stay internally type-checked at their definition above.
+ */
+const KIND_CONFIGS: ReadonlyArray<AnyKindConfig> = [
+  BOOKS_CONFIG as AnyKindConfig,
+  CONFIGS_CONFIG as AnyKindConfig,
+  NOTES_CONFIG as AnyKindConfig,
+];
+
+/** Look up a record kind's wiring by its {@link SyncType}, or `undefined`. */
+const kindConfigFor = (type: SyncType): AnyKindConfig | undefined =>
+  KIND_CONFIGS.find((config) => config.kind === type);
+
+// ---------------------------------------------------------------------------
+// Phase 3: reading stats. Stats ride the SAME per-device JSONL layout as records
+// but with two differences that keep them on their own code path:
+//   - they merge by their own rules, captured per-kind in {@link STAT_KIND_CONFIGS}:
+//     statBooks are LWW by book_hash (reuse mergeByKey + bookKeyOf); statPages
+//     are longest-duration-wins (mergeStatPagesByDuration) — mirroring the
+//     server's pickWinningPages, which is KOReader-compatible.
+//   - a WRITE-TIME cursor: the server stamps `updated_at = now` on every pushed
+//     stat row (sync.ts:496,537) and attaches `updated_at_ms` on pull
+//     (sync.ts:259-269) so the consumer (statsSync.pullStats) advances its cursor
+//     by max(updated_at_ms). We mirror both here.
+// ---------------------------------------------------------------------------
+
+/** Union of the stat rows this client stores and returns. */
+type StatRecord = StatBookRecord | StatPageRecord;
+
+/**
+ * Per-kind wiring for a stat stream, driving BOTH push and pull (DRY), parallel
+ * to {@link KindConfig} but stat-shaped. Stats carry no app→DB transform (they
+ * arrive DB-shaped already), so the table captures only:
+ *   - `kind`: the storage kind → its `<kind>.jsonl` replica path.
+ *   - `dataKey`: where incoming stat rows are read from a {@link SyncData}.
+ *   - `merge`: the kind's fold rule (LWW for books, duration for pages).
+ *   - `assignResult`: writes the cursor-stamped winners into the {@link SyncResult}.
+ * Typed to the kind's concrete record (`Stat`), so there is no `any`.
+ */
+interface StatKindConfig<Stat extends StatRecord> {
+  readonly kind: StatKind;
+  readonly dataKey: 'statBooks' | 'statPages';
+  readonly merge: (rows: Stat[]) => Stat[];
+  readonly assignResult: (result: SyncResult, records: Stat[]) => void;
+}
+
+const STAT_BOOKS_CONFIG: StatKindConfig<StatBookRecord> = {
+  kind: 'statBooks',
+  dataKey: 'statBooks',
+  // statBooks upsert by book_hash, newest write wins — plain LWW (sync.ts:490-503).
+  merge: (rows) => mergeByKey(rows, bookKeyOf),
+  assignResult: (result, records) => {
+    result.statBooks = records;
+  },
+};
+
+const STAT_PAGES_CONFIG: StatKindConfig<StatPageRecord> = {
+  kind: 'statPages',
+  dataKey: 'statPages',
+  // statPages merge by longest-duration-wins, NOT timestamp (sync.ts:28-38).
+  merge: mergeStatPagesByDuration,
+  assignResult: (result, records) => {
+    result.statPages = records;
+  },
+};
+
+/**
+ * One existential view over a {@link StatKindConfig} so the two differently-typed
+ * stat configs share an array and the push/pull loops. `Stat` is erased to the
+ * {@link StatRecord} union the shared machinery operates on; each config's own
+ * merge/assign stay internally type-checked at their definition above.
+ */
+type AnyStatKindConfig = StatKindConfig<StatRecord>;
+
+/** The stat kinds this client syncs, in a stable order. */
+const STAT_KIND_CONFIGS: ReadonlyArray<AnyStatKindConfig> = [
+  STAT_BOOKS_CONFIG as AnyStatKindConfig,
+  STAT_PAGES_CONFIG as AnyStatKindConfig,
+];
+
+/**
+ * An empty {@link SyncResult}: every record kind null (the "not queried" signal
+ * the server uses) and no stat slots. A push/pull fills in only what it touched.
+ */
+const emptySyncResult = (): SyncResult => ({ books: null, configs: null, notes: null });
+
+/** Constructor dependencies, injected so the client is testable without I/O. */
+export interface DriveSyncClientOptions {
+  /** Backing cloud storage (Drive in production, the fake under test). */
+  provider: CloudProvider;
+  /** Resolves the stable id of THIS device — the only file this client writes. */
+  getDeviceId: () => string;
+  /** Override the cosmetic DB `user_id`; defaults to {@link DRIVE_NAMESPACE_USER_ID}. */
+  userId?: string;
+  /**
+   * Clock used to stamp `updated_at` on pushed STAT rows (so the pull cursor
+   * advances; see {@link STAT_KIND_CONFIGS}). Injectable for deterministic tests;
+   * defaults to {@link Date.now}. Records don't use this — their `updated_at`
+   * comes from the app→DB transform, not a server-side write time.
+   */
+  now?: () => number;
+}
+
+export class DriveSyncClient {
+  private readonly provider: CloudProvider;
+  private readonly getDeviceId: () => string;
+  private readonly userId: string;
+  private readonly now: () => number;
+
+  constructor({
+    provider,
+    getDeviceId,
+    userId = DRIVE_NAMESPACE_USER_ID,
+    now = () => Date.now(),
+  }: DriveSyncClientOptions) {
+    this.provider = provider;
+    this.getDeviceId = getDeviceId;
+    this.userId = userId;
+    this.now = now;
+  }
+
+  /**
+   * Push local changes. For each record kind present in `payload`, merge the
+   * incoming rows into THIS device's own replica (LWW: a newer re-push of a key
+   * replaces this device's older copy) and write only that file. The returned
+   * {@link SyncResult} carries, for each pushed kind, the CROSS-DEVICE
+   * authoritative winners for the pushed keys — so if a peer already holds a
+   * newer copy of a pushed record, the caller learns it immediately (mirroring
+   * the server returning post-merge rows). Stat payloads (`statBooks`/
+   * `statPages`) are stamped with a write-time `updated_at` and merged into this
+   * device's own stat replica by their own rule (see {@link pushStatKind}).
+   */
+  async pushChanges(payload: SyncData): Promise<SyncResult> {
+    const result = emptySyncResult();
+
+    for (const config of KIND_CONFIGS) {
+      const incomingApp = payload[config.dataKey];
+      if (incomingApp === undefined) {
+        continue;
+      }
+
+      // 1. app → DB rows (stamps updated_at/deleted_at + cosmetic user_id). The
+      // `as never` only satisfies the erased `App` param of the existential
+      // AnyKindConfig; the concrete transforms all accept `unknown`, so this is
+      // a no-op widening, not a real coercion.
+      const incoming = incomingApp.map((record) =>
+        config.toDB(record as never, this.userId),
+      ) as DBSyncRecord[];
+
+      // 2-3. Merge into this device's own replica and write ONLY that file.
+      // Reading-then-merging (rather than blind append) keeps the device's file
+      // de-duplicated: a re-push of an existing key replaces the older copy
+      // instead of growing the file unbounded.
+      // Not atomic: two concurrent pushes on this SAME device both read the old
+      // file and the later putText wins, dropping the earlier push's rows from
+      // this device's replica. Acceptable in Phase 2 — the dropped row
+      // re-propagates on its next push, and a peer that already merged it still
+      // wins on read, so no cross-device data is lost. (Cf. the cross-device
+      // single-cursor R2 limitation in the class header.)
+      const ownPath = deviceSyncPath(this.getDeviceId(), config.kind);
+      const existing = await this.readDeviceRecords(ownPath);
+      const ownMerged = mergeByKey([...existing, ...incoming], config.keyOf);
+      await this.provider.putText(ownPath, serializeJsonl(ownMerged));
+
+      // 4. Authoritative response: merge across ALL devices and return the
+      // winners for exactly the keys this push touched. A peer's newer record
+      // for a pushed key wins here even though we only wrote our own file.
+      const pushedKeys = new Set(incoming.map(config.keyOf));
+      const authoritative = await this.readMergedAcrossDevices<DBSyncRecord>(config.kind, (rows) =>
+        mergeByKey(rows, config.keyOf),
+      );
+      const winners = authoritative.filter((record) => pushedKeys.has(config.keyOf(record)));
+      config.assignResult(result, winners);
+    }
+
+    for (const statConfig of STAT_KIND_CONFIGS) {
+      const incoming = payload[statConfig.dataKey];
+      if (incoming === undefined) {
+        continue;
+      }
+      await this.pushStatKind(statConfig, incoming);
+    }
+
+    return result;
+  }
+
+  /**
+   * Push one stat kind: stamp every incoming row with a write-time `updated_at`,
+   * merge into THIS device's own replica by the kind's rule, and write only that
+   * file. (`updated_at_ms` is NOT stored — it is derived and attached on pull.)
+   *
+   * WHY stamp `updated_at = now` here: the server stamps it on every pushed stat
+   * row (sync.ts:496,537) so the pull cursor — which advances by the max
+   * `updated_at` seen — moves forward on each push. Mirroring it is what lets the
+   * consumer's incremental pull pick up freshly-pushed stats. (Record kinds, by
+   * contrast, carry an app-supplied `updated_at` from their transform.)
+   *
+   * The push result intentionally does NOT carry a cross-device authoritative
+   * stat response: the consumer (`statsSync.pushStats`) ignores the push result
+   * and re-reads via pull, so computing it would be dead work. The own-file merge
+   * still de-duplicates this device's replica exactly like the record path.
+   */
+  private async pushStatKind(config: AnyStatKindConfig, incoming: StatRecord[]): Promise<void> {
+    const nowIso = new Date(this.now()).toISOString();
+    const stamped = incoming.map((row) => ({ ...row, updated_at: nowIso }));
+
+    const ownPath = deviceSyncPath(this.getDeviceId(), config.kind);
+    const existing = await this.readDeviceRecords<StatRecord>(ownPath);
+    const ownMerged = config.merge([...existing, ...stamped]);
+    await this.provider.putText(ownPath, serializeJsonl(ownMerged));
+  }
+
+  /**
+   * Pull incremental changes since `since` (epoch ms). With a `type` it pulls
+   * just that kind (and `type === 'stats'` pulls both stat kinds); with no `type`
+   * it pulls all three record kinds. `book`/`metaHash` scope a configs/notes pull
+   * to a single book (mirroring the server's per-book pull).
+   *
+   * `limit` (the server's stats page size) is intentionally ignored: we return
+   * ALL changed stat rows in one response rather than paging. The consumer's
+   * `pullStats` loop still terminates because it stops as soon as a pull yields
+   * no rows / no cursor advance — and on Drive every changed row is already in
+   * that first response, so the next loop iteration finds nothing past the
+   * advanced cursor.
+   */
+  async pullChanges(
+    since: number,
+    type?: SyncType,
+    book?: string,
+    metaHash?: string,
+    _limit?: number,
+  ): Promise<SyncResult> {
+    if (type === 'stats') {
+      return this.pullStats(since);
+    }
+
+    const result = emptySyncResult();
+    const configs = type ? [kindConfigFor(type)].filter(isDefined) : KIND_CONFIGS;
+
+    for (const config of configs) {
+      // 1-2. Union every device's replica for the kind and LWW-merge it.
+      const merged = await this.readMergedAcrossDevices<DBSyncRecord>(config.kind, (rows) =>
+        mergeByKey(rows, config.keyOf),
+      );
+      // 3. Optional per-book scope (configs/notes): keep rows whose book_hash or
+      // meta_hash matches the request; with neither given, keep all. Mirrors the
+      // server's per-book pull filter (sync.ts:105-111).
+      const scoped = scopeToBook(merged, book, metaHash);
+      // 4. Incremental cursor: only rows changed strictly after `since`.
+      config.assignResult(result, changedSinceMs(scoped, since));
+    }
+
+    return result;
+  }
+
+  /**
+   * Pull both stat kinds since `since`. For each kind: union every device's
+   * replica, fold by the kind's rule (statBooks LWW; statPages
+   * longest-duration-wins), keep only rows changed strictly after the cursor, and
+   * attach `updated_at_ms` to every returned row.
+   *
+   * WHY attach `updated_at_ms`: the consumer (`statsSync.pullStats`) advances its
+   * cursor by `max(updated_at_ms)` over the returned rows (the server attaches it
+   * for exactly this reason, sync.ts:259-269). We compute it from the same
+   * `updated_at` the merge/cursor already use, so the cursor the consumer derives
+   * is consistent with the rows we filtered on.
+   *
+   * Record kinds come back null (this pull queried only stats), matching the
+   * server's "not queried ⇒ null" convention.
+   */
+  private async pullStats(since: number): Promise<SyncResult> {
+    const result: SyncResult = { ...emptySyncResult() };
+
+    for (const config of STAT_KIND_CONFIGS) {
+      const merged = await this.readMergedAcrossDevices<StatRecord>(config.kind, config.merge);
+      const changed = changedSinceMs(merged, since);
+      const withMs = changed.map((row) => ({ ...row, updated_at_ms: parseIsoMs(row.updated_at) }));
+      config.assignResult(result, withMs);
+    }
+
+    return result;
+  }
+
+  /**
+   * Read every device's replica for one kind and fold the union with `merge`,
+   * yielding the cross-device winners. The "list devices → read each →
+   * concat" half is identical for record and stat kinds; only the fold rule
+   * differs (record kinds and statBooks use LWW via {@link mergeByKey}; statPages
+   * uses longest-duration-wins via {@link mergeStatPagesByDuration}), so it is
+   * injected. Shared by push (authoritative response), record pull, and stat
+   * pull so the device-listing logic lives in exactly one place (DRY).
+   *
+   * Generic over the row type `T` so each caller keeps its precise record/stat
+   * type — no `any` leaks across the seam.
+   */
+  private async readMergedAcrossDevices<T>(
+    kind: SyncKind,
+    merge: (rows: T[]) => T[],
+  ): Promise<T[]> {
+    const allRows = await this.readAllDeviceRecords<T>(kind);
+    return merge(allRows);
+  }
+
+  /**
+   * The union of every device's replica for one kind, un-merged. Lists the sync
+   * root's immediate child folders (one per device, see {@link deviceSyncPath}),
+   * reads each device's `<kind>.jsonl`, and concatenates. The merge rule is left
+   * to the caller via {@link readMergedAcrossDevices}.
+   */
+  private async readAllDeviceRecords<T>(kind: SyncKind): Promise<T[]> {
+    const entries = await this.provider.list(syncRootPath());
+    // Each immediate child folder is one device (see deviceSyncPath); files (if
+    // any leaked in) are ignored — only the device folders carry replicas.
+    const deviceFolders = entries.filter((entry) => entry.isFolder);
+
+    const perDevice = await Promise.all(
+      deviceFolders.map((folder) => this.readDeviceRecords<T>(deviceSyncPath(folder.name, kind))),
+    );
+
+    return perDevice.flat();
+  }
+
+  /** Read and parse a single replica file (absent file → no records). */
+  private async readDeviceRecords<T = DBSyncRecord>(path: string): Promise<T[]> {
+    const text = await this.provider.getText(path);
+    return parseJsonl<T>(text, path);
+  }
+}
+
+/** Type guard dropping `undefined` from an array (e.g. an unknown sync type). */
+const isDefined = <T>(value: T | undefined): value is T => value !== undefined;
+
+/**
+ * Keep only records matching the requested book scope. When `book` and/or
+ * `metaHash` is given, a record is kept if its `book_hash === book` OR its
+ * `meta_hash === metaHash` (the server's per-book selector, sync.ts:105-111).
+ * When neither is given the scope is the whole set. Books never carry a query
+ * scope (the server only scopes configs/notes), so an all-books pull passes
+ * through untouched.
+ */
+const scopeToBook = (records: DBSyncRecord[], book?: string, metaHash?: string): DBSyncRecord[] => {
+  if (book === undefined && metaHash === undefined) {
+    return records;
+  }
+  return records.filter(
+    (record) =>
+      (book !== undefined && record.book_hash === book) ||
+      (metaHash !== undefined && record.meta_hash === metaHash),
+  );
+};
diff --git a/apps/readest-app/src/services/drivesync/cloudAccount.ts b/apps/readest-app/src/services/drivesync/cloudAccount.ts
new file mode 100644
index 00000000..a46f95af
--- /dev/null
+++ b/apps/readest-app/src/services/drivesync/cloudAccount.ts
@@ -0,0 +1,38 @@
+import type { SystemSettings } from '@/types/settings';
+
+/**
+ * The cloud-sync account state the UI needs to present "Drive connected" as the
+ * signed-in state, derived purely from {@link SystemSettings}.
+ *
+ * Why read from settings rather than {@link isCloudConfigured}: the active
+ * provider in `cloudSyncContext` is module-level state that React does not
+ * observe, so a menu reading it would not re-render when an account connects or
+ * disconnects. The persisted token set lives in the settings store, which *is*
+ * reactive, so deriving connection state from settings lets account UI light up
+ * and tear down in lock-step with connect/disconnect — exactly as the Readest
+ * `user` object drives the stock account UI.
+ */
+export interface CloudAccountState {
+  /** Whether a Google Drive account is currently connected. */
+  connected: boolean;
+  /** Human-readable account label (e.g. the email), or `null` when unknown. */
+  label: string | null;
+}
+
+/**
+ * Derive the {@link CloudAccountState} from the persisted settings.
+ *
+ * Connection is keyed on a non-empty `accessToken`: that is the load-bearing
+ * credential without which no Drive call can be made, so its presence is the
+ * honest signal that an account is connected. (`expiresAt` is intentionally not
+ * required here — an expired-but-refreshable account is still connected; the
+ * auth layer refreshes it on demand.) The label is best-effort: it is shown
+ * when persisted and falls back to `null`, leaving the caller to render a
+ * generic "connected" string.
+ */
+export const readCloudAccount = (settings: SystemSettings): CloudAccountState => {
+  const google = settings.cloudSync?.google;
+  const accessToken = google?.tokens?.accessToken;
+  const connected = typeof accessToken === 'string' && accessToken.length > 0;
+  return { connected, label: google?.accountLabel ?? null };
+};
diff --git a/apps/readest-app/src/services/drivesync/cloudSyncContext.ts b/apps/readest-app/src/services/drivesync/cloudSyncContext.ts
new file mode 100644
index 00000000..43af398a
--- /dev/null
+++ b/apps/readest-app/src/services/drivesync/cloudSyncContext.ts
@@ -0,0 +1,105 @@
+import type { CloudProvider } from '../cloudprovider/CloudProvider';
+import { DriveBlobStore } from './DriveBlobStore';
+
+/**
+ * App-wide registration point for the cloud-sync mod's active provider.
+ *
+ * The application connects exactly one cloud account at a time, and many call
+ * sites — book/cover transfers, replica sync, settings UI — need to reach that
+ * single provider. Threading a `CloudProvider` (and a `DriveBlobStore` built
+ * over it) as parameters through every one of those layers would be invasive
+ * prop-drilling for a value that is genuinely a singleton: there is only ever
+ * one active account for the running app. So this module deliberately holds
+ * module-level state — it is the one place the chosen provider is registered,
+ * and call sites read it back from here.
+ *
+ * The trade-off (global state is harder to reason about and isolate in tests) is
+ * paid down by keeping that state private, exposing it only through the small
+ * typed API below, and providing {@link clearCloudProvider} so sign-out and test
+ * setup can reset cleanly.
+ */
+
+/**
+ * Message thrown by the getters when no provider has been registered yet.
+ * Defined once and reused by both {@link getCloudProvider} and
+ * {@link getBlobStore} so the two error paths cannot drift (DRY).
+ */
+const CLOUD_NOT_CONFIGURED_MESSAGE =
+  'Cloud provider not configured: call setCloudProvider() before using cloud sync.';
+
+/**
+ * The active provider, or `null` when no account is connected. Private to this
+ * module; reachable only through the exported accessors.
+ */
+let activeProvider: CloudProvider | null = null;
+
+/**
+ * The `DriveBlobStore` built over {@link activeProvider}, memoized alongside it.
+ *
+ * The store is stateless apart from the provider it wraps, so it is built once
+ * in {@link setCloudProvider} rather than reconstructed on every
+ * {@link getBlobStore} call. This both avoids needless allocation on hot
+ * transfer paths and guarantees every caller shares one instance over the same
+ * provider. It is cleared in lock-step with the provider so the two can never
+ * disagree about which account is active.
+ */
+let activeBlobStore: DriveBlobStore | null = null;
+
+/**
+ * Register the active cloud provider and build the {@link DriveBlobStore} over
+ * it. Call this once after the app connects an account (e.g. on sign-in).
+ */
+export function setCloudProvider(provider: CloudProvider): void {
+  activeProvider = provider;
+  // Build the store eagerly and memoize it: see activeBlobStore's rationale.
+  activeBlobStore = new DriveBlobStore(provider);
+}
+
+/**
+ * Alias of {@link setCloudProvider}, named so test setup reads as intent —
+ * `setCloudProviderForTest(new FakeCloudProvider())` — rather than looking like
+ * production wiring.
+ */
+export const setCloudProviderForTest = setCloudProvider;
+
+/**
+ * Reset the active provider and its blob store to the unconfigured state. Used
+ * on sign-out, and by tests to keep module-level state from leaking between
+ * cases.
+ */
+export function clearCloudProvider(): void {
+  activeProvider = null;
+  activeBlobStore = null;
+}
+
+/**
+ * Return the active provider.
+ *
+ * @throws Error with {@link CLOUD_NOT_CONFIGURED_MESSAGE} when no provider has
+ *   been registered — surfacing a misuse loudly rather than failing later with
+ *   an opaque null dereference.
+ */
+export function getCloudProvider(): CloudProvider {
+  if (activeProvider === null) {
+    throw new Error(CLOUD_NOT_CONFIGURED_MESSAGE);
+  }
+  return activeProvider;
+}
+
+/**
+ * Return the memoized {@link DriveBlobStore} over the active provider.
+ *
+ * @throws Error with {@link CLOUD_NOT_CONFIGURED_MESSAGE} when no provider has
+ *   been registered.
+ */
+export function getBlobStore(): DriveBlobStore {
+  if (activeBlobStore === null) {
+    throw new Error(CLOUD_NOT_CONFIGURED_MESSAGE);
+  }
+  return activeBlobStore;
+}
+
+/** Whether a cloud provider is currently registered. */
+export function isCloudConfigured(): boolean {
+  return activeProvider !== null;
+}
diff --git a/apps/readest-app/src/services/drivesync/cloudSyncController.ts b/apps/readest-app/src/services/drivesync/cloudSyncController.ts
new file mode 100644
index 00000000..26f354e8
--- /dev/null
+++ b/apps/readest-app/src/services/drivesync/cloudSyncController.ts
@@ -0,0 +1,184 @@
+/**
+ * Orchestration for connecting, disconnecting, and restoring the cloud-sync
+ * mod's single Google Drive account.
+ *
+ * The lower layers each own one concern — `runDesktopDeepLinkOAuth`/`runAndroidOAuth`
+ * mint a {@link TokenSet}, {@link TokenPersistence} keeps it between runs,
+ * {@link buildDriveProvider} turns it into a usable provider, and
+ * {@link cloudSyncContext} holds the one active provider for the running app.
+ * This controller is the conductor that sequences those steps for the three
+ * user-facing moments: pressing "Connect", pressing "Disconnect", and launching
+ * the app with an account already connected.
+ *
+ * Every collaborator is injected via {@link CloudSyncControllerDeps} — OAuth
+ * runner, persistence, fetch, the activate/clear hooks, and even
+ * {@link buildDriveProvider} itself — so the orchestration is exercised with
+ * in-memory fakes and no Tauri, network, or UI. The caller (the wiring layer)
+ * owns the platform choices: which OAuth flow to run, the real secure-store
+ * persistence, env-sourced client id/secret, and the platform `fetch`.
+ */
+
+import type { CloudProvider } from '../cloudprovider/CloudProvider';
+// `FetchFn` is imported from GoogleDriveProvider (not tokenStore) because it is
+// the exact type `buildDriveProvider` consumes; tokenStore's same-named alias
+// requires `init` and so is not assignable here. One source of truth for the
+// `fetch` we inject keeps the dependency chain type-consistent end to end.
+import { type FetchFn } from '../cloudprovider/GoogleDriveProvider';
+import {
+  buildDriveProvider,
+  type DriveAuthConfig,
+  type DriveProviderBundle,
+  type TokenPersistence,
+} from '../cloudprovider/buildDriveProvider';
+import type { TokenSet } from '../cloudprovider/googleAuth/tokenStore';
+import { setCloudProvider, clearCloudProvider } from './cloudSyncContext';
+
+/**
+ * Everything the controller needs, injected so it stays pure and unit-testable.
+ *
+ * The first group (`runOAuth`, `persistence`, `config`, `fetchFn`) is the real
+ * work the caller wires from the platform; the second group
+ * (`setProvider`, `clearProvider`, `buildProvider`) defaults to the production
+ * implementations and exists chiefly so tests can substitute fakes.
+ */
+export interface CloudSyncControllerDeps {
+  /**
+   * Run the interactive OAuth consent flow and resolve with the minted tokens.
+   * The caller picks the platform flow (desktop loopback vs. Android deep link)
+   * before constructing these deps, so the controller stays platform-agnostic.
+   * Rejects when the user cancels or denies consent.
+   */
+  runOAuth: () => Promise<TokenSet>;
+  /** Secure store the token set is read from and written to across app runs. */
+  persistence: TokenPersistence;
+  /** OAuth client id/secret, sourced from env by the caller. */
+  config: DriveAuthConfig;
+  /** Platform `fetch` used by the built provider for Drive/token calls. */
+  fetchFn: FetchFn;
+  /** Register the active provider; defaults to the real {@link setCloudProvider}. */
+  setProvider: (provider: CloudProvider) => void;
+  /** Deregister the active provider; defaults to the real {@link clearCloudProvider}. */
+  clearProvider: () => void;
+  /**
+   * Assemble a provider over the persisted tokens; defaults to the real
+   * {@link buildDriveProvider}. Injectable so tests can return a stub bundle and
+   * avoid constructing a network-backed GoogleDriveProvider.
+   */
+  buildProvider: typeof buildDriveProvider;
+}
+
+/**
+ * Defaults for the substitutable collaborators. Spread by {@link withDefaults}
+ * so production callers only have to supply the platform-specific pieces
+ * (`runOAuth`, `persistence`, `config`, `fetchFn`) while tests can override any
+ * field. Kept as one object so the default wiring lives in exactly one place.
+ */
+const CONTROLLER_DEFAULTS = {
+  setProvider: setCloudProvider,
+  clearProvider: clearCloudProvider,
+  buildProvider: buildDriveProvider,
+} as const satisfies Pick<
+  CloudSyncControllerDeps,
+  'setProvider' | 'clearProvider' | 'buildProvider'
+>;
+
+/** Caller-facing deps: the platform pieces are required, the rest default. */
+export type CloudSyncControllerInput = Pick<
+  CloudSyncControllerDeps,
+  'runOAuth' | 'persistence' | 'config' | 'fetchFn'
+> &
+  Partial<CloudSyncControllerDeps>;
+
+/** Fill in the production defaults for any collaborator the caller omits. */
+const withDefaults = (input: CloudSyncControllerInput): CloudSyncControllerDeps => ({
+  ...CONTROLLER_DEFAULTS,
+  ...input,
+});
+
+/** Result of {@link connectGoogleDrive}: the label to show in settings. */
+export interface ConnectResult {
+  /** Connected-account label for the UI, or `null` when none is available. */
+  accountLabel: string | null;
+}
+
+/**
+ * Build a provider over the *persisted* tokens and register it as active,
+ * returning the whole bundle so the caller can also reach the backing auth.
+ *
+ * Shared by connect (after it persists fresh tokens) and startup (over tokens
+ * already on disk) so the "assemble + activate" step lives in one place and the
+ * two paths cannot drift. It deliberately reads through the same `persistence`
+ * the tokens were written to: the built {@link PersistedDriveAuth} hydrates and
+ * refreshes from there, so connect must save *before* calling this.
+ */
+const buildAndActivate = (deps: CloudSyncControllerDeps): DriveProviderBundle => {
+  const bundle = deps.buildProvider(deps.persistence, deps.config, deps.fetchFn);
+  deps.setProvider(bundle.provider);
+  return bundle;
+};
+
+/**
+ * Connect a Google Drive account: run consent, persist the tokens, then build
+ * and activate the provider.
+ *
+ * Ordering is load-bearing. OAuth runs first and we only persist *after* it
+ * resolves, so a cancelled/denied flow (a rejection) propagates having written
+ * nothing and activated nothing — there is no half-connected state to clean up.
+ * Tokens are then saved *before* {@link buildAndActivate} because the provider's
+ * auth hydrates from persistence; activating against an empty store would yield
+ * a provider that believes it is signed out.
+ */
+export const connectGoogleDrive = async (
+  input: CloudSyncControllerInput,
+): Promise<ConnectResult> => {
+  const deps = withDefaults(input);
+
+  const tokens = await deps.runOAuth();
+  // Persist before activating: the provider's auth reads its tokens back from
+  // this same store (see buildAndActivate).
+  await deps.persistence.save(tokens);
+  const { auth } = buildAndActivate(deps);
+
+  return { accountLabel: await auth.accountLabel() };
+};
+
+/**
+ * Disconnect the current account: deactivate the provider, then forget the
+ * stored tokens.
+ *
+ * Provider first, persistence second, on purpose: deactivating is the step that
+ * actually stops the app from using the account, so even if clearing the secure
+ * store rejects, the running app is already signed out rather than left holding
+ * a live provider over tokens we failed to erase.
+ */
+export const disconnectGoogleDrive = async (input: CloudSyncControllerInput): Promise<void> => {
+  const deps = withDefaults(input);
+  deps.clearProvider();
+  await deps.persistence.clear();
+};
+
+/**
+ * Restore a previously connected account on app startup.
+ *
+ * Loads the persisted tokens and, if present, builds and activates the provider
+ * over them — returning whether cloud sync ended up configured. Crucially it
+ * never calls `runOAuth`: the tokens already exist, and the
+ * {@link PersistedDriveAuth} the provider wraps refreshes the access token on
+ * demand, so no interactive consent is needed (or wanted) at launch. When
+ * nothing is stored it leaves the provider unset and reports `false`.
+ */
+export const initCloudSyncFromSettings = async (
+  input: CloudSyncControllerInput,
+): Promise<boolean> => {
+  const deps = withDefaults(input);
+
+  const tokens = await deps.persistence.load();
+  if (tokens === null) {
+    // No stored account: leave the provider unset; the app runs cloud-less.
+    return false;
+  }
+
+  // Tokens exist — activate without OAuth; the auth refreshes them as needed.
+  buildAndActivate(deps);
+  return true;
+};
diff --git a/apps/readest-app/src/services/drivesync/cloudSyncEnvConfig.ts b/apps/readest-app/src/services/drivesync/cloudSyncEnvConfig.ts
new file mode 100644
index 00000000..96b0b609
--- /dev/null
+++ b/apps/readest-app/src/services/drivesync/cloudSyncEnvConfig.ts
@@ -0,0 +1,121 @@
+/**
+ * Cloud-sync mod: assemble what {@link cloudSyncController} needs from the build
+ * environment and the runtime platform.
+ *
+ * The controller and the OAuth runners are deliberately env-agnostic — they take
+ * their client id/secret, scope, and platform OAuth flow as plain inputs so they
+ * stay pure and unit-testable. This module is the one place that knows where
+ * those inputs actually come from: the `NEXT_PUBLIC_GOOGLE_*` build vars and the
+ * Tauri platform name. Keeping that knowledge here (behind injectable `env` /
+ * `platformName` seams) lets the wiring layer (settings form, startup) read a
+ * single source of truth while these functions stay testable without a real
+ * environment or a native platform.
+ */
+
+import { runDesktopDeepLinkOAuth } from '../cloudprovider/googleAuth/oauthDesktopDeepLink';
+import { runAndroidOAuth } from '../cloudprovider/googleAuth/oauthAndroid';
+import type { OAuthClientConfig } from '../cloudprovider/googleAuth/oauthFlow';
+import type { FetchFn, TokenSet } from '../cloudprovider/googleAuth/tokenStore';
+import type { DriveAuthConfig } from '../cloudprovider/buildDriveProvider';
+
+/**
+ * Build-time environment variable names holding the Google OAuth client
+ * credentials. Named so the lookups below read as a checklist and there is a
+ * single source of truth for the keys the deploy/build must set.
+ *
+ * `NEXT_PUBLIC_`-prefixed so Next.js inlines them into the client bundle at
+ * build time — they are read off `process.env.<LITERAL>` (never a dynamic
+ * `process.env[key]`), which is what lets the inlining work.
+ */
+const GOOGLE_CLIENT_ID_ENV_KEY = 'NEXT_PUBLIC_GOOGLE_CLIENT_ID';
+
+/**
+ * Tauri platform name for Android, matched by {@link selectRunOAuth} to pick the
+ * Custom-Tab runner. Exported so the wiring layer (e.g. CloudSyncForm) derives its
+ * platform string from the same constant the branch checks against.
+ */
+export const ANDROID_PLATFORM_NAME = 'android';
+
+/**
+ * The narrow, read-only slice of the environment this module consumes. Modeled
+ * as an injectable record (rather than reaching into `process.env` directly)
+ * so the helpers can be exercised with a plain object and no global mutation.
+ */
+export type EnvLike = Record<string, string | undefined>;
+
+/**
+ * OAuth scope for the cloud-sync mod: Drive's per-app file scope. With
+ * `drive.file` the app sees only the files it created (see
+ * {@link GoogleDriveProvider}), so this is the least-privilege scope that still
+ * lets us store the sync data. Centralised here as the single scope the connect
+ * + startup flows request.
+ */
+export const GOOGLE_DRIVE_SYNC_SCOPE = 'https://www.googleapis.com/auth/drive.file';
+
+/**
+ * Signature shared by both platform OAuth runners ({@link runDesktopDeepLinkOAuth}
+ * / {@link runAndroidOAuth}): given the client config (id + scope) and a platform
+ * `fetch`, run interactive consent and resolve with the minted tokens.
+ */
+export type RunOAuth = (config: OAuthClientConfig, fetchFn: FetchFn) => Promise<TokenSet>;
+
+/**
+ * Read the Google OAuth client id from the (injected) environment.
+ *
+ * Returns `null` when no client id is configured, which is the signal the UI uses
+ * to render a "not configured" state and the signal startup uses to no-op — the
+ * app is simply built without cloud sync wired up. ONE iOS-type client serves every
+ * platform (Windows + Android) via its reverse-DNS redirect; it carries NO secret
+ * (the reverse-DNS scheme + PKCE are the client auth), so a single client id is all
+ * the build needs.
+ *
+ * The default argument reads the literal `process.env['NEXT_PUBLIC_GOOGLE_CLIENT_ID']`
+ * key (string-literal bracket access, which Next.js statically inlines just like dot
+ * access — and which the strict tsconfig requires for `process.env`'s index
+ * signature); the `env` parameter exists purely so tests can inject a fake
+ * environment.
+ */
+export const readDriveAuthConfig = (
+  env: EnvLike = {
+    [GOOGLE_CLIENT_ID_ENV_KEY]: process.env['NEXT_PUBLIC_GOOGLE_CLIENT_ID'],
+  },
+): DriveAuthConfig | null => {
+  const clientId = env[GOOGLE_CLIENT_ID_ENV_KEY];
+  return clientId ? { clientId } : null;
+};
+
+/**
+ * Whether cloud sync is configured for this build — i.e. a client id is present.
+ *
+ * A thin predicate over {@link readDriveAuthConfig} so the form and the startup
+ * guard share one definition of "configured" rather than each re-checking the
+ * env key.
+ */
+export const isGoogleDriveConfigured = (env?: EnvLike): boolean =>
+  readDriveAuthConfig(env) !== null;
+
+/**
+ * Pick the OAuth runner for the running platform — both use the SAME iOS-type
+ * client and its reverse-DNS redirect, differing only in how they host consent and
+ * capture the redirect. Android opens a Chrome Custom Tab ({@link runAndroidOAuth});
+ * every other platform opens the system browser and captures the reverse-DNS
+ * redirect via a deep link ({@link runDesktopDeepLinkOAuth}). The platform name is
+ * passed in (from `@tauri-apps/plugin-os`'s `platform()`) so this stays testable.
+ */
+export const selectRunOAuth = (platformName: string): RunOAuth =>
+  platformName === ANDROID_PLATFORM_NAME ? runAndroidOAuth : runDesktopDeepLinkOAuth;
+
+/**
+ * Lift a {@link DriveAuthConfig} (id/secret) into the {@link OAuthClientConfig}
+ * the platform runners need, attaching {@link GOOGLE_DRIVE_SYNC_SCOPE}.
+ *
+ * The controller is handed the bare {@link DriveAuthConfig} (it only refreshes
+ * tokens, which needs no scope), while the interactive OAuth call additionally
+ * needs the scope to request — so the wiring layer derives the runner's config
+ * from the controller's config through this single helper rather than restating
+ * the scope at each call site.
+ */
+export const toOAuthClientConfig = (config: DriveAuthConfig): OAuthClientConfig => ({
+  ...config,
+  scope: GOOGLE_DRIVE_SYNC_SCOPE,
+});
diff --git a/apps/readest-app/src/services/drivesync/cloudSyncStartup.ts b/apps/readest-app/src/services/drivesync/cloudSyncStartup.ts
new file mode 100644
index 00000000..add8f77b
--- /dev/null
+++ b/apps/readest-app/src/services/drivesync/cloudSyncStartup.ts
@@ -0,0 +1,66 @@
+/**
+ * Cloud-sync mod: app-startup restoration of a previously connected Google Drive
+ * account.
+ *
+ * On launch the app must re-activate the Drive provider over the tokens already
+ * persisted in settings, *without* any interactive OAuth — that is exactly what
+ * {@link initCloudSyncFromSettings} does. This module is the thin wiring that the
+ * upstream boot path calls once: it no-ops when the build ships without a Google
+ * client (so unconfigured builds pay nothing) and otherwise assembles the same
+ * persistence/config/fetch the settings form uses, keeping the connect and
+ * restore paths on one set of deps.
+ *
+ * Kept out of the React boot file so that file's MOD edit is a single guarded
+ * call; the build-the-deps logic and the run-once latch live here.
+ */
+
+import type { EnvConfigType } from '@/services/environment';
+import { initCloudSyncFromSettings } from './cloudSyncController';
+import { getSettingsTokenPersistence } from './settingsTokenPersistence';
+import { readDriveAuthConfig } from './cloudSyncEnvConfig';
+// Shared WebView fetch for all Google calls — see driveFetch.ts for why it is
+// the WebView fetch and not @tauri-apps/plugin-http (reqwest / os error 10061).
+import { driveFetch } from './driveFetch';
+
+/**
+ * Run-once latch. The library boot effect can re-run (remount, return from the
+ * reader), but restoring the provider need happen only once per app session —
+ * re-running is harmless (it just rebuilds the provider over the same tokens),
+ * but the latch avoids the redundant work on every library mount.
+ */
+let started = false;
+
+/**
+ * Restore the cloud-sync provider from persisted settings, exactly once.
+ *
+ * Call from the boot path *after* the settings store has been seeded, since the
+ * persistence reads the connected tokens from that store. No-ops (returning
+ * `false`) when the build is unconfigured or when this has already run.
+ *
+ * @returns whether cloud sync ended up active (a provider was restored).
+ */
+export const startCloudSyncFromSettings = async (envConfig: EnvConfigType): Promise<boolean> => {
+  if (started) return false;
+  // Unconfigured builds carry no Google client, so there is nothing to restore.
+  // One iOS-type client serves every platform — this is platform-independent.
+  const config = readDriveAuthConfig();
+  if (config === null) return false;
+  started = true;
+
+  try {
+    return await initCloudSyncFromSettings({
+      // `runOAuth` is never called on the restore path (tokens already exist and
+      // are refreshed non-interactively), so a throwing stub documents that.
+      runOAuth: () => Promise.reject(new Error('runOAuth must not be called on startup restore')),
+      persistence: getSettingsTokenPersistence(envConfig),
+      config,
+      fetchFn: driveFetch,
+    });
+  } catch (e) {
+    // Restoration is best-effort: a malformed stored token or a provider-build
+    // failure must not break library boot. The user can reconnect in Settings;
+    // until then the app simply runs without cloud sync.
+    console.warn('Cloud sync: startup restore failed', e);
+    return false;
+  }
+};
diff --git a/apps/readest-app/src/services/drivesync/driveAwareSyncClient.ts b/apps/readest-app/src/services/drivesync/driveAwareSyncClient.ts
new file mode 100644
index 00000000..b11a7d39
--- /dev/null
+++ b/apps/readest-app/src/services/drivesync/driveAwareSyncClient.ts
@@ -0,0 +1,112 @@
+/**
+ * Drive-aware sync router — the Phase 2 DI seam that decides, per call, whether
+ * book/config/note sync should flow through the user's OWN cloud storage
+ * ({@link DriveSyncClient}) or fall back to Readest's server-backed
+ * {@link SyncClient}.
+ *
+ * The routing decision is re-evaluated on EVERY method call (never captured
+ * once at construction) so a user who connects or disconnects their Drive
+ * mid-session is honoured immediately, without tearing down and rebuilding the
+ * React `SyncContext`.
+ */
+
+import { SyncClient, type SyncData, type SyncResult, type SyncType } from '@/libs/sync';
+import { DriveSyncClient } from './DriveSyncClient';
+import { getCloudProvider, isCloudConfigured } from './cloudSyncContext';
+import { useSettingsStore } from '@/store/settingsStore';
+
+/**
+ * The structural subset of {@link SyncClient} this router depends on. Typed from
+ * the real `SyncType`/`SyncData`/`SyncResult` so it cannot drift from the
+ * server-backed client it stands in for, and so the {@link DriveSyncClient}
+ * (which shares these exact signatures) is assignable here without `any`.
+ */
+export interface SyncClientLike {
+  pullChanges(
+    since: number,
+    type?: SyncType,
+    book?: string,
+    metaHash?: string,
+    limit?: number,
+  ): Promise<SyncResult>;
+  pushChanges(payload: SyncData): Promise<SyncResult>;
+}
+
+/** Injected collaborators, so the router is unit-testable without real I/O. */
+export interface DriveAwareDeps {
+  /** Readest's server-backed client, used whenever no cloud account is active. */
+  legacy: SyncClientLike;
+  /** Whether a cloud provider is currently connected; checked PER call. */
+  isCloudConfigured: () => boolean;
+  /**
+   * Builds a {@link DriveSyncClient} bound to the currently-active provider +
+   * device id. Called fresh on each routed-to-drive call (see {@link routeTo})
+   * so the client always targets the provider that is active right now — which
+   * can change as the user connects or switches accounts.
+   */
+  makeDriveClient: () => SyncClientLike;
+}
+
+/**
+ * Pick the active client for THIS call. Centralised so `pullChanges` and
+ * `pushChanges` share one routing rule (DRY): when cloud is configured, build a
+ * fresh drive client; otherwise reuse the legacy client. The freshness of the
+ * drive client is the whole point — it binds to the provider active at call
+ * time, not at router-construction time.
+ */
+const routeTo = (deps: DriveAwareDeps): SyncClientLike =>
+  deps.isCloudConfigured() ? deps.makeDriveClient() : deps.legacy;
+
+/**
+ * Build a {@link SyncClientLike} that routes each call through {@link routeTo}.
+ * The two methods are deliberately thin pass-throughs: all the decision logic
+ * lives in `routeTo`, and arguments are forwarded with the rest/spread pattern
+ * (typed from each method's own `Parameters<>`, so no `any` and no drift). Rest
+ * forwarding preserves the caller's exact arity — it does NOT pad omitted
+ * optionals with `undefined` — so the routed-to client sees precisely the call
+ * it would have seen without the router in between.
+ */
+export const createSyncRouter = (deps: DriveAwareDeps): SyncClientLike => ({
+  pullChanges: (...args: Parameters<SyncClientLike['pullChanges']>) =>
+    routeTo(deps).pullChanges(...args),
+  pushChanges: (...args: Parameters<SyncClientLike['pushChanges']>) =>
+    routeTo(deps).pushChanges(...args),
+});
+
+/**
+ * Read THIS device's stable replica id from the settings store. It is generated
+ * once during settings init (`settingsService.ts`), so by the time any sync
+ * runs it is always present; a missing value would mean sync started before
+ * settings init and is a programmer error, so we throw a NAMED, contextual error
+ * rather than letting an empty device path silently corrupt the Drive layout.
+ */
+const readReplicaDeviceId = (): string => {
+  const deviceId = useSettingsStore.getState().settings.replicaDeviceId;
+  if (!deviceId) {
+    throw new Error(
+      'DriveAwareSyncClient: settings.replicaDeviceId is missing — sync ran ' +
+        'before settings init populated the device id. This should never happen ' +
+        'post-init; check that settingsService initialised before sync started.',
+    );
+  }
+  return deviceId;
+};
+
+/**
+ * Production wiring of {@link createSyncRouter}: legacy server client + the real
+ * cloud-context predicate + a drive-client factory bound to the live provider.
+ *
+ * Returned typed as {@link SyncClient} purely for the consumer's convenience —
+ * `SyncClient` has no private members, so the structural router object satisfies
+ * it. This keeps the `SyncContext` type unchanged (still `SyncClient`) while
+ * swapping in the routing behaviour.
+ */
+export const createDriveAwareSyncClient = (): SyncClient =>
+  createSyncRouter({
+    legacy: new SyncClient(),
+    isCloudConfigured,
+    // Built fresh on each routed call so it binds to the provider active right
+    // now (connect/disconnect/switch all take effect without recreating this).
+    makeDriveClient: () =>
+      new DriveSyncClient({ provider: getCloudProvider(), getDeviceId: readReplicaDeviceId }),
+  });
diff --git a/apps/readest-app/src/services/drivesync/driveFetch.ts b/apps/readest-app/src/services/drivesync/driveFetch.ts
new file mode 100644
index 00000000..0a4614f8
--- /dev/null
+++ b/apps/readest-app/src/services/drivesync/driveFetch.ts
@@ -0,0 +1,22 @@
+import type { FetchFn } from '@/services/cloudprovider/GoogleDriveProvider';
+
+/**
+ * The `fetch` used for ALL Google calls in the cloud-sync mod — the OAuth token
+ * exchange/refresh and every Drive REST + blob upload/download request.
+ *
+ * Deliberately the WebView's own native `fetch` (read off `window`), NOT
+ * `@tauri-apps/plugin-http` (reqwest). Readest routes its OWN server calls
+ * through the reqwest plugin to bypass CORS (its endpoints don't all send CORS
+ * headers); Google does NOT need that — the OAuth token endpoint and the Drive
+ * API both return permissive `Access-Control-Allow-Origin` headers for the
+ * app's `http://tauri.localhost` origin (verified: the token POST returns 200
+ * with `access-control-allow-origin: http://tauri.localhost`). So the plain
+ * WebView fetch works, and it keeps this path free of the reqwest plugin.
+ *
+ * `window.fetch` is read EXPLICITLY (not a bare `fetch` identifier) so webpack
+ * scope-hoisting can't rebind it to a sibling module's imported fetch, and it is
+ * accessed inside the call (not at module load) so importing this module stays
+ * safe during SSR/`next build`, where `window` is undefined. Centralised here so
+ * connect, disconnect, and startup-restore share one fetch.
+ */
+export const driveFetch: FetchFn = (input, init) => window.fetch(input, init);
diff --git a/apps/readest-app/src/services/drivesync/driveMerge.ts b/apps/readest-app/src/services/drivesync/driveMerge.ts
new file mode 100644
index 00000000..3fa287b6
--- /dev/null
+++ b/apps/readest-app/src/services/drivesync/driveMerge.ts
@@ -0,0 +1,168 @@
+/**
+ * Pure last-writer-wins (LWW) merge engine for the cloud-sync mod.
+ *
+ * This mirrors the server's record merge (`src/pages/api/sync.ts`, the
+ * incoming-vs-existing rule at sync.ts:370-379) but runs *locally* and
+ * *N-way*: where the server compares one client record against one server
+ * record, Phase 2 must fold the same record (keyed by its primary key) as it
+ * appears across N devices' sync files into a single winner. To do that with a
+ * stable, deterministic outcome we lift the server's pairwise
+ * `clientDeletedAt > serverDeletedAt || clientUpdatedAt > serverUpdatedAt`
+ * comparison into a *total order* over records — see
+ * {@link effectiveTimestampMs}.
+ *
+ * Everything here is a pure function: no I/O, no clock reads (`Date.now`), no
+ * mutation of inputs. That keeps the merge trivially unit-testable and lets the
+ * same logic run on any device against the same input set and reach the same
+ * result.
+ */
+
+/**
+ * The minimal shape this engine needs: a record carrying LWW timestamps. Both
+ * are ISO-8601 strings (as the DB rows store them); `deleted_at` is the
+ * tombstone marker and may be `null`/absent for a live record. Concrete sync
+ * rows (books/configs/notes) widen this with their primary-key fields.
+ */
+export interface TimestampedRecord {
+  updated_at?: string;
+  deleted_at?: string | null;
+}
+
+/**
+ * Sentinel epoch used when a timestamp is absent or unparseable. Zero matches
+ * the server, which coerces a missing `updated_at`/`deleted_at` to `0` before
+ * comparing (sync.ts:370-377: `x ? new Date(x).getTime() : 0`). Named so the
+ * "absent means oldest-possible" intent is explicit rather than a bare literal.
+ */
+const ABSENT_TIMESTAMP_MS = 0;
+
+/**
+ * Separator joining a note's composite primary key (`book_hash` + `id`) into a
+ * single map key. Mirrors the server, which builds its lookup key by
+ * `primaryKeys.map((pk) => record[pk]).join('|')` (sync.ts:353,363). Kept as a
+ * named const so the one delimiter lives in exactly one place.
+ */
+const KEY_SEPARATOR = '|';
+
+/**
+ * Parse an ISO-8601 timestamp to epoch milliseconds, or {@link ABSENT_TIMESTAMP_MS}
+ * when the value is absent (`undefined`/`null`) or not a valid date.
+ *
+ * This is the single source of truth for turning a stored timestamp into a
+ * comparable number — every other function here defers to it so the
+ * "absent/garbage ⇒ 0" rule (which the server applies inline) is never
+ * re-derived. `Date.parse` returns `NaN` for unparseable input; we fold that
+ * back to the same sentinel so a corrupt field can never out-rank a real one.
+ */
+export const parseIsoMs = (iso?: string | null): number => {
+  if (!iso) {
+    return ABSENT_TIMESTAMP_MS;
+  }
+  const ms = Date.parse(iso);
+  return Number.isNaN(ms) ? ABSENT_TIMESTAMP_MS : ms;
+};
+
+/**
+ * The record's "latest activity" instant: `max(updated_at, deleted_at)` in ms.
+ *
+ * WHY the max: the server's freshness test is
+ * `deletedAt > otherDeletedAt || updatedAt > otherUpdatedAt` — a *later delete*
+ * must beat an *earlier update*, and a *later update* must beat an *earlier
+ * delete*. Taking the max of the two timestamps collapses that two-clause OR
+ * into one comparable scalar, which is exactly what an N-way merge needs: a
+ * single total order over records so the winner is well-defined no matter how
+ * many copies are folded together or in what order. The delete-vs-update
+ * tie-break (when the two effective instants are equal) lives in
+ * {@link mergeByKey}, again matching the server's "check deletedAt first".
+ */
+export const effectiveTimestampMs = (rec: TimestampedRecord): number =>
+  Math.max(parseIsoMs(rec.updated_at), parseIsoMs(rec.deleted_at));
+
+/**
+ * Whether `candidate` should beat the `incumbent` winner for a key.
+ *
+ * Primary order: higher {@link effectiveTimestampMs} wins. Tie-break (equal
+ * effective instant): the record whose `deleted_at` is the greater instant
+ * wins — i.e. a delete beats a same-instant update. This mirrors the server
+ * evaluating `clientDeletedAt > serverDeletedAt` *before* the updated_at clause,
+ * so a tombstone is never silently resurrected by a coincident update. The
+ * comparison is strict, so a candidate that is not provably newer (equal
+ * effective instant AND not a greater delete) does not displace the incumbent.
+ * This makes the fold order-independent whenever a key has a uniquely-newest
+ * record (the real-world case); for an exact tie the first-seen record is kept,
+ * mirroring the server keeping its incumbent (`serverData`) when the client is
+ * not strictly newer.
+ */
+const beats = (candidate: TimestampedRecord, incumbent: TimestampedRecord): boolean => {
+  const candidateEffective = effectiveTimestampMs(candidate);
+  const incumbentEffective = effectiveTimestampMs(incumbent);
+  if (candidateEffective !== incumbentEffective) {
+    return candidateEffective > incumbentEffective;
+  }
+  // Equal effective instant: prefer the stronger delete (tombstone wins a tie).
+  return parseIsoMs(candidate.deleted_at) > parseIsoMs(incumbent.deleted_at);
+};
+
+/**
+ * Collapse `records` to one winner per key under LWW.
+ *
+ * Groups by `keyOf` and, within each group, keeps the single record that
+ * {@link beats} all others (highest effective timestamp; delete wins an exact
+ * tie). The result holds exactly one record per distinct key.
+ *
+ * Determinism: because {@link beats} uses a *strict* comparison, two records
+ * that are indistinguishable under the order never swap places — the first one
+ * encountered stays. For any input that contains a uniquely-newest record per
+ * key (the real-world case), the winner is identical regardless of input order.
+ * Result order follows first-seen key order; callers treat the output as a set.
+ */
+export const mergeByKey = <T extends TimestampedRecord>(
+  records: T[],
+  keyOf: (record: T) => string,
+): T[] => {
+  const winnerByKey = new Map<string, T>();
+  for (const record of records) {
+    const key = keyOf(record);
+    const incumbent = winnerByKey.get(key);
+    if (incumbent === undefined || beats(record, incumbent)) {
+      winnerByKey.set(key, record);
+    }
+  }
+  return [...winnerByKey.values()];
+};
+
+/**
+ * Keep only records changed strictly after `sinceMs` on either timestamp —
+ * `updated_at > since || deleted_at > since`.
+ *
+ * This mirrors the server's incremental cursor, which selects rows with
+ * `updated_at.gt.<since>` OR `deleted_at.gt.<since>` so that both edits and
+ * tombstones after the cursor are picked up. The `>` is *strict* on purpose: a
+ * record stamped exactly at the cursor was already seen in the previous pass, so
+ * including it would re-process unchanged data on every sync.
+ */
+export const changedSinceMs = <T extends TimestampedRecord>(records: T[], sinceMs: number): T[] =>
+  records.filter(
+    (record) => parseIsoMs(record.updated_at) > sinceMs || parseIsoMs(record.deleted_at) > sinceMs,
+  );
+
+/**
+ * Primary key for a book row: its `book_hash` (server uses `['book_hash']`,
+ * sync.ts:427).
+ */
+export const bookKeyOf = (record: { book_hash?: string }): string => record.book_hash ?? '';
+
+/**
+ * Primary key for a book-config row: also `book_hash` (server uses
+ * `['book_hash']`, sync.ts:428). Aliased to {@link bookKeyOf} so the
+ * "configs are keyed by book_hash" fact is stated once.
+ */
+export const configKeyOf = bookKeyOf;
+
+/**
+ * Primary key for a book-note row: the composite `book_hash` + `id`, joined on
+ * {@link KEY_SEPARATOR} (server uses `['book_hash', 'id']`, sync.ts:429, joined
+ * with the same `'|'`).
+ */
+export const noteKeyOf = (record: { book_hash?: string; id?: string }): string =>
+  `${record.book_hash ?? ''}${KEY_SEPARATOR}${record.id ?? ''}`;
diff --git a/apps/readest-app/src/services/drivesync/driveStorageBridge.ts b/apps/readest-app/src/services/drivesync/driveStorageBridge.ts
new file mode 100644
index 00000000..26509b8c
--- /dev/null
+++ b/apps/readest-app/src/services/drivesync/driveStorageBridge.ts
@@ -0,0 +1,102 @@
+/**
+ * Bridge from Readest's server-era *cloud file paths* (`cfp`) onto the cloud-sync
+ * mod's active {@link CloudProvider}.
+ *
+ * Upstream code (`cloudService.ts`) addresses every book/cover transfer by a
+ * `cfp` — a key relative to the user's server storage prefix, e.g.
+ * `Readest/Books/<hash>/<title>.epub` (see `CLOUD_BOOKS_SUBDIR`). The mod's
+ * providers instead speak *logical, app-scoped* paths rooted at {@link APP_ROOT}
+ * (see {@link CloudProvider}). This module is the single, thin seam that maps one
+ * onto the other: prefix the app root so every `cfp` lands inside the app's own
+ * private folder tree and never touches the user's wider Drive.
+ *
+ * It deliberately exposes no upstream surface and owns no state — it only
+ * translates a `cfp` and forwards to {@link getCloudProvider}. Keeping the
+ * mapping here (rather than inline at each call site) means the cfp→logical-path
+ * rule lives in exactly one place and can be unit-tested against the in-memory
+ * `FakeCloudProvider` with no network.
+ */
+
+import { APP_ROOT } from './layout';
+import { CLOUD_PATH_SEPARATOR, type ProgressHandler } from '../cloudprovider/CloudProvider';
+import { getCloudProvider } from './cloudSyncContext';
+
+/**
+ * MIME types for the file kinds Readest transfers through the bridge. The cloud
+ * file's content type matters: providers serve the blob back with it, so a wrong
+ * type can make a download open as opaque bytes instead of an EPUB/PDF/PNG.
+ * Keyed by the *normalized* (lower-case) filename extension.
+ *
+ * Typed with `| undefined` values so an unknown extension is statically known to
+ * miss (this project does not enable `noUncheckedIndexedAccess`), which keeps the
+ * fallback in {@link contentTypeForFilename} type-justified rather than dead code.
+ */
+const CONTENT_TYPES_BY_EXTENSION: Readonly<Record<string, string | undefined>> = {
+  epub: 'application/epub+zip',
+  pdf: 'application/pdf',
+  png: 'image/png',
+};
+
+/**
+ * Fallback content type for files whose extension is not in
+ * {@link CONTENT_TYPES_BY_EXTENSION} — the standard "opaque byte stream" type.
+ * The blob still round-trips correctly; only the advertised MIME type is generic.
+ */
+const FALLBACK_CONTENT_TYPE = 'application/octet-stream';
+
+/** Separator between a filename and its extension. */
+const EXTENSION_SEPARATOR = '.';
+
+/**
+ * Map an upstream cloud file path (`cfp`) onto the provider's logical,
+ * app-scoped path by prefixing the application root.
+ *
+ * Example: `Books/abc.epub` → `Readest/Books/abc.epub`. Anchoring every key
+ * under {@link APP_ROOT} is what keeps the whole namespace inside the app's own
+ * private cloud scope (Google `drive.file` / a Dropbox App folder), so the
+ * user's wider storage is never read or written.
+ */
+export const cloudPath = (cfp: string): string => `${APP_ROOT}${CLOUD_PATH_SEPARATOR}${cfp}`;
+
+/**
+ * Content type to advertise for a transferred file, derived from its filename
+ * extension. Centralized so upload call sites need not each repeat the mapping.
+ */
+export const contentTypeForFilename = (name: string): string => {
+  const lastSeparatorIndex = name.lastIndexOf(EXTENSION_SEPARATOR);
+  // No dot (or a leading-dot name with no real extension) → unknown format.
+  if (lastSeparatorIndex <= 0) {
+    return FALLBACK_CONTENT_TYPE;
+  }
+  const extension = name.slice(lastSeparatorIndex + 1).toLowerCase();
+  return CONTENT_TYPES_BY_EXTENSION[extension] ?? FALLBACK_CONTENT_TYPE;
+};
+
+/**
+ * Upload a file's bytes to the cloud at the logical path for `cfp`.
+ *
+ * @param cfp - Upstream cloud file path (mapped via {@link cloudPath}).
+ * @param bytes - The file body.
+ * @param contentType - MIME type to advertise; defaults to the provider's own
+ *   default when omitted.
+ * @param onProgress - Optional upload-progress callback, forwarded verbatim.
+ */
+export const uploadCloudFileBytes = (
+  cfp: string,
+  bytes: ArrayBuffer,
+  contentType?: string,
+  onProgress?: ProgressHandler,
+): Promise<void> => getCloudProvider().putBinary(cloudPath(cfp), bytes, contentType, onProgress);
+
+/**
+ * Download a file's bytes from the cloud at the logical path for `cfp`.
+ *
+ * @returns The file body, or `null` when nothing exists at that path — callers
+ *   treat a `null` exactly as the server path treats a missing file.
+ */
+export const downloadCloudFileBytes = (cfp: string): Promise<ArrayBuffer | null> =>
+  getCloudProvider().getBinary(cloudPath(cfp));
+
+/** Delete the cloud file at the logical path for `cfp`. */
+export const deleteCloudFileByPath = (cfp: string): Promise<void> =>
+  getCloudProvider().deleteFile(cloudPath(cfp));
