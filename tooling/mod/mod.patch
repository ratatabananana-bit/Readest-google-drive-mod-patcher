+++ b/apps/readest-app/src/services/cloudprovider/GoogleDriveProvider.ts
@@ -0,0 +1,450 @@
+/**
+ * {@link CloudProvider} implemented over the Google Drive v3 REST API.
+ *
+ * This is the real backend behind the provider seam (the in-memory
+ * {@link FakeCloudProvider} lets the rest of the sync code be tested without a
+ * network). Two facts shape the whole design:
+ *
+ *  - **`drive.file` scope.** The app sees *only* the files it created, so Drive
+ *    behaves like a private app folder rooted at `'root'`. That makes Drive's
+ *    real root a safe namespace for our logical paths — no clash with the user's
+ *    own files is possible because we cannot even see them.
+ *  - **Drive is ID-addressed, not path-addressed.** There is no "GET /a/b/c"; a
+ *    logical path like `Readest/blobs/x.epub` must be resolved segment-by-segment
+ *    into Drive file ids via `files.list` search queries, then operated on by id.
+ *    Resolved ids are memoised in {@link idCache} so repeated access under the
+ *    same folder does not re-walk the tree.
+ *
+ * All wire-format string building (endpoints, queries, `fields` selectors) lives
+ * in the sibling `googleAuth/driveRest.ts`; this file owns the request plumbing,
+ * the path resolver, and the cache. Tokens are supplied by an injected
+ * {@link DriveAuth} (the OAuth/token layer), and `fetch` is injected as
+ * {@link FetchFn} so the provider is unit-testable against a mocked Drive.
+ */
+
+import {
+  CLOUD_PATH_SEPARATOR,
+  type CloudEntry,
+  type CloudProvider,
+  type ProgressHandler,
+} from './CloudProvider';
+import {
+  childrenQuery,
+  deleteUrl,
+  FILES_ENDPOINT,
+  FOLDER_MIME,
+  listQuery,
+  listUrl,
+  mediaDownloadUrl,
+  mediaUpdateUrl,
+  metadataUrl,
+  reparentUrl,
+  simpleUploadUrl,
+} from './googleAuth/driveRest';
+
+/**
+ * Token + identity source for Drive requests, supplied by the OAuth/token layer
+ * (`googleAuth/tokenStore.ts` et al.). Kept to the minimum the provider needs so
+ * it stays trivially mockable.
+ */
+export interface DriveAuth {
+  /** A currently-valid access token; refreshes under the hood as needed. */
+  getAccessToken(): Promise<string>;
+  /** Human-readable account label (e.g. email) for settings UI, or null. */
+  accountLabel(): Promise<string | null>;
+}
+
+/**
+ * Injected `fetch`. Typed to exactly what the provider uses (a string URL plus
+ * optional init) so the platform's `fetch` or a test stub drops in without the
+ * full overloaded DOM signature.
+ */
+export type FetchFn = (input: string, init?: RequestInit) => Promise<Response>;
+
+/** Drive's real root, which `drive.file` scope makes our private namespace root. */
+const DRIVE_ROOT_ID = 'root';
+
+/** HTTP method names used by the provider, named to avoid bare string literals. */
+const HTTP_GET = 'GET';
+const HTTP_POST = 'POST';
+const HTTP_PATCH = 'PATCH';
+const HTTP_DELETE = 'DELETE';
+
+/** Authorization header pieces. Drive authenticates with an OAuth bearer token. */
+const AUTHORIZATION_HEADER = 'Authorization';
+const BEARER_PREFIX = 'Bearer ';
+
+/** Content-Type header name and the JSON type used for metadata request bodies. */
+const CONTENT_TYPE_HEADER = 'Content-Type';
+const JSON_CONTENT_TYPE = 'application/json';
+
+/** Default MIME for {@link putText} — the JSON/JSONL sync replicas this carries. */
+const DEFAULT_TEXT_CONTENT_TYPE = 'application/json';
+/** Default MIME for {@link putBinary} when the caller does not know the format. */
+const DEFAULT_BINARY_CONTENT_TYPE = 'application/octet-stream';
+
+/**
+ * HTTP status codes the provider branches on.
+ *
+ * A read of a path that resolves to nothing — or whose file was deleted between
+ * resolve and fetch — surfaces as {@link HTTP_NOT_FOUND}; the contract turns that
+ * into `null`/no-op rather than an error. The 2xx codes are the success shapes
+ * Drive returns for media/metadata operations and for a delete.
+ */
+const HTTP_OK = 200;
+const HTTP_NO_CONTENT = 204;
+const HTTP_NOT_FOUND = 404;
+
+/**
+ * Request-name for error messages. Drive errors are most useful when they say
+ * which operation failed and on what path, so every failing call names itself.
+ */
+type DriveOperation =
+  | 'list'
+  | 'download'
+  | 'upload'
+  | 'create folder'
+  | 'set metadata'
+  | 'stat'
+  | 'delete';
+
+/**
+ * Raw Drive JSON for a single file or folder, restricted to the `fields` we
+ * request (see `driveRest.ts`). Modeled explicitly so the mapping into a
+ * {@link CloudEntry} is type-checked rather than reaching through `any`.
+ */
+interface DriveFile {
+  id: string;
+  name?: string;
+  /** Equals {@link FOLDER_MIME} for folders; absent/other for file blobs. */
+  mimeType?: string;
+  /** Byte size as a *string* (Drive returns numbers as strings in JSON). */
+  size?: string;
+  /** RFC 3339 / ISO-8601 last-modified timestamp. */
+  modifiedTime?: string;
+  /** Content hash Drive exposes for blobs; used to skip redundant transfers. */
+  md5Checksum?: string;
+}
+
+/** Shape of a `files.list` response (only the `files` array is requested). */
+interface DriveFileList {
+  files?: DriveFile[];
+}
+
+export class GoogleDriveProvider implements CloudProvider {
+  /**
+   * Memoised logical-path → Drive file id. Drive ids are stable for a file's
+   * lifetime, so once a segment (folder or file) is resolved it need not be
+   * looked up again; this is what stops repeated reads under one folder from
+   * re-walking the tree on every call.
+   */
+  private readonly idCache = new Map<string, string>();
+
+  constructor(
+    private readonly auth: DriveAuth,
+    private readonly fetchFn: FetchFn,
+  ) {}
+
+  async isAuthenticated(): Promise<boolean> {
+    // Contract: never throw for the unauthenticated state. A failure to mint a
+    // token (no/expired credentials) is exactly that state, so it maps to false.
+    try {
+      await this.auth.getAccessToken();
+      return true;
+    } catch {
+      return false;
+    }
+  }
+
+  accountLabel(): Promise<string | null> {
+    return this.auth.accountLabel();
+  }
+
+  async getText(path: string): Promise<string | null> {
+    const fileId = await this.resolveFile(path);
+    if (fileId === null) return null;
+    const res = await this.authedFetch(mediaDownloadUrl(fileId), HTTP_GET);
+    if (res.status === HTTP_NOT_FOUND) return null;
+    this.ensureOk(res, 'download', path);
+    return res.text();
+  }
+
+  async getBinary(path: string): Promise<ArrayBuffer | null> {
+    const fileId = await this.resolveFile(path);
+    if (fileId === null) return null;
+    const res = await this.authedFetch(mediaDownloadUrl(fileId), HTTP_GET);
+    // 404 here means the file was removed between resolve and fetch (or the
+    // cached id went stale); the contract turns "no file" into null, not an error.
+    if (res.status === HTTP_NOT_FOUND) return null;
+    this.ensureOk(res, 'download', path);
+    return res.arrayBuffer();
+  }
+
+  putText(
+    path: string,
+    body: string,
+    contentType: string = DEFAULT_TEXT_CONTENT_TYPE,
+  ): Promise<void> {
+    return this.putBinary(path, new TextEncoder().encode(body).buffer, contentType);
+  }
+
+  async putBinary(
+    path: string,
+    body: ArrayBuffer,
+    contentType: string = DEFAULT_BINARY_CONTENT_TYPE,
+    onProgress?: ProgressHandler,
+  ): Promise<void> {
+    const { parentId, name } = this.splitPath(path);
+    // Folders are auto-created on write (not on read), so an upload to a brand
+    // new path materialises its whole containing chain.
+    const folderId = await this.resolveFolderSegments(parentId, true);
+    if (folderId === null) {
+      // resolveFolder(create=true) only returns null if a segment unexpectedly
+      // failed to materialise; treat as an upload failure with context.
+      throw new Error(`Drive upload failed: could not create folder for ${path}`);
+    }
+
+    const existingId = await this.findChild(name, folderId);
+    if (existingId !== null) {
+      // Overwrite the existing file's bytes in place, preserving its id (and any
+      // sharing/links) instead of orphaning it and creating a duplicate name.
+      await this.uploadMedia(mediaUpdateUrl(existingId), HTTP_PATCH, body, contentType, path);
+      this.idCache.set(path, existingId);
+    } else {
+      // Simple media upload first creates the file at the Drive root with a
+      // server-assigned name; a follow-up PATCH then sets the real name and
+      // reparents it under the resolved folder. We do create-then-name because
+      // `uploadType=media` carries no metadata envelope, so name/parent cannot
+      // ride along with the bytes in a single request.
+      const created = await this.uploadMedia(simpleUploadUrl(), HTTP_POST, body, contentType, path);
+      await this.nameAndReparent(created.id, name, folderId, path);
+      this.idCache.set(path, created.id);
+    }
+
+    // Drive's simple upload is a single request, so the body is fully sent once
+    // it returns: report one terminal progress event for callers that track it.
+    onProgress?.(body.byteLength, body.byteLength);
+  }
+
+  async list(path: string): Promise<CloudEntry[]> {
+    const folderId = await this.resolveFolderSegments(splitSegments(path), false);
+    // Absent folder -> empty listing (matches the contract and FakeCloudProvider).
+    if (folderId === null) return [];
+    const res = await this.authedFetch(listUrl(childrenQuery(folderId)), HTTP_GET);
+    this.ensureOk(res, 'list', path);
+    const data = (await res.json()) as DriveFileList;
+    return (data.files ?? []).map((file) => {
+      const childPath = joinPath(path, file.name ?? file.id);
+      // Cache each child's id while we have it, so a subsequent get/stat on a
+      // listed entry resolves straight from cache.
+      this.idCache.set(childPath, file.id);
+      return toCloudEntry(childPath, file);
+    });
+  }
+
+  async stat(path: string): Promise<CloudEntry | null> {
+    const fileId = await this.resolveFile(path);
+    if (fileId === null) return null;
+    const res = await this.authedFetch(metadataUrl(fileId), HTTP_GET);
+    if (res.status === HTTP_NOT_FOUND) return null;
+    this.ensureOk(res, 'stat', path);
+    const file = (await res.json()) as DriveFile;
+    return toCloudEntry(path, file);
+  }
+
+  async deleteFile(path: string): Promise<void> {
+    const fileId = await this.resolveFile(path);
+    // Already absent — nothing to delete (idempotent delete).
+    if (fileId === null) return;
+    const res = await this.authedFetch(deleteUrl(fileId), HTTP_DELETE);
+    // Tolerate a 404: the file may have been deleted concurrently, which still
+    // satisfies the caller's intent ("ensure it's gone").
+    if (res.status === HTTP_NOT_FOUND) {
+      this.idCache.delete(path);
+      return;
+    }
+    this.ensureOk(res, 'delete', path);
+    this.idCache.delete(path);
+  }
+
+  // --- path resolution -----------------------------------------------------
+
+  /**
+   * Resolve a full logical file path to its Drive id, walking and caching each
+   * folder segment. Returns null when any segment (folder or the file itself)
+   * does not exist — reads never create folders.
+   */
+  private async resolveFile(path: string): Promise<string | null> {
+    const cached = this.idCache.get(path);
+    if (cached !== undefined) return cached;
+
+    const { parentId, name } = this.splitPath(path);
+    const folderId = await this.resolveFolderSegments(parentId, false);
+    if (folderId === null) return null;
+
+    const fileId = await this.findChild(name, folderId);
+    if (fileId !== null) this.idCache.set(path, fileId);
+    return fileId;
+  }
+
+  /**
+   * Resolve a chain of folder-name segments to the id of the deepest folder,
+   * starting from the Drive root. When `create` is true, missing folders are
+   * created on the way down (write path); when false, a missing segment yields
+   * null (read path). The accumulated logical prefix is cached per segment.
+   */
+  private async resolveFolderSegments(segments: string[], create: boolean): Promise<string | null> {
+    let parentId = DRIVE_ROOT_ID;
+    let prefix = '';
+    for (const segment of segments) {
+      prefix = prefix === '' ? segment : joinPath(prefix, segment);
+
+      const cached = this.idCache.get(prefix);
+      if (cached !== undefined) {
+        parentId = cached;
+        continue;
+      }
+
+      let childId = await this.findChild(segment, parentId);
+      if (childId === null) {
+        if (!create) return null;
+        childId = await this.createFolder(segment, parentId);
+      }
+      this.idCache.set(prefix, childId);
+      parentId = childId;
+    }
+    return parentId;
+  }
+
+  /**
+   * Find a directly-nested child by name under `parentId` via a `files.list`
+   * search, returning its id or null when there is no such child. This is the
+   * single per-segment lookup primitive the resolver is built from.
+   */
+  private async findChild(name: string, parentId: string): Promise<string | null> {
+    const res = await this.authedFetch(listUrl(listQuery(name, parentId)), HTTP_GET);
+    this.ensureOk(res, 'list', name);
+    const data = (await res.json()) as DriveFileList;
+    const first = data.files?.[0];
+    return first?.id ?? null;
+  }
+
+  /** Create an empty folder named `name` under `parentId`; return its new id. */
+  private async createFolder(name: string, parentId: string): Promise<string> {
+    const res = await this.authedFetch(FILES_ENDPOINT, HTTP_POST, {
+      headers: { [CONTENT_TYPE_HEADER]: JSON_CONTENT_TYPE },
+      body: JSON.stringify({ name, mimeType: FOLDER_MIME, parents: [parentId] }),
+    });
+    this.ensureOk(res, 'create folder', name);
+    const file = (await res.json()) as DriveFile;
+    return file.id;
+  }
+
+  /**
+   * Set a freshly-uploaded file's name and move it under its target folder.
+   * `addParents` reparents from the upload's default root location; combined
+   * with the name PATCH this completes the create-then-name upload flow.
+   */
+  private async nameAndReparent(
+    fileId: string,
+    name: string,
+    folderId: string,
+    path: string,
+  ): Promise<void> {
+    const res = await this.authedFetch(reparentUrl(fileId, folderId, DRIVE_ROOT_ID), HTTP_PATCH, {
+      headers: { [CONTENT_TYPE_HEADER]: JSON_CONTENT_TYPE },
+      body: JSON.stringify({ name }),
+    });
+    this.ensureOk(res, 'set metadata', path);
+  }
+
+  /**
+   * Send a simple media upload (`uploadType=media`, body = raw bytes) and parse
+   * the resulting file metadata. Shared by the create (POST) and overwrite
+   * (PATCH) paths so the transfer/parse/error logic lives in one place.
+   */
+  private async uploadMedia(
+    url: string,
+    method: typeof HTTP_POST | typeof HTTP_PATCH,
+    body: ArrayBuffer,
+    contentType: string,
+    path: string,
+  ): Promise<DriveFile> {
+    const res = await this.authedFetch(url, method, {
+      headers: { [CONTENT_TYPE_HEADER]: contentType },
+      body,
+    });
+    this.ensureOk(res, 'upload', path);
+    return (await res.json()) as DriveFile;
+  }
+
+  // --- request plumbing ----------------------------------------------------
+
+  /**
+   * Issue an authenticated Drive request. Centralises the bearer-token header so
+   * no method hand-rolls auth, and merges any per-call headers/body. A fresh
+   * token is fetched per call; the token layer caches/refreshes behind
+   * {@link DriveAuth.getAccessToken}.
+   */
+  private async authedFetch(url: string, method: string, init?: RequestInit): Promise<Response> {
+    const token = await this.auth.getAccessToken();
+    const headers: Record<string, string> = {
+      [AUTHORIZATION_HEADER]: `${BEARER_PREFIX}${token}`,
+      ...(init?.headers as Record<string, string> | undefined),
+    };
+    return this.fetchFn(url, { ...init, method, headers });
+  }
+
+  /**
+   * Throw a context-carrying error for any non-success response. Callers handle
+   * the expected {@link HTTP_NOT_FOUND}/null cases *before* calling this, so any
+   * status that reaches here is a genuine failure worth surfacing with the
+   * operation and HTTP status.
+   *
+   * Drive returns {@link HTTP_OK} for media/metadata/list calls and
+   * {@link HTTP_NO_CONTENT} for a successful delete; those are named explicitly,
+   * with `res.ok` as a catch-all for any other 2xx so no success is misreported.
+   */
+  private ensureOk(res: Response, operation: DriveOperation, path: string): void {
+    const succeeded = res.status === HTTP_OK || res.status === HTTP_NO_CONTENT || res.ok;
+    if (succeeded) return;
+    throw new Error(`Drive ${operation} failed: HTTP ${res.status} for ${path}`);
+  }
+
+  /** Split a file path into its parent folder segments and final file name. */
+  private splitPath(path: string): { parentId: string[]; name: string } {
+    const segments = splitSegments(path);
+    const name = segments.pop() ?? path;
+    return { parentId: segments, name };
+  }
+}
+
+/** Split a logical path into non-empty segments (tolerating extra separators). */
+function splitSegments(path: string): string[] {
+  return path.split(CLOUD_PATH_SEPARATOR).filter((s) => s.length > 0);
+}
+
+/** Join a parent path and a child name with the logical separator. */
+function joinPath(parent: string, child: string): string {
+  return parent === '' ? child : `${parent}${CLOUD_PATH_SEPARATOR}${child}`;
+}
+
+/** Map Drive file metadata onto a {@link CloudEntry} at the given logical path. */
+function toCloudEntry(path: string, file: DriveFile): CloudEntry {
+  const isFolder = file.mimeType === FOLDER_MIME;
+  return {
+    path,
+    name: file.name ?? lastSegment(path),
+    isFolder,
+    // Folders have no body size/hash; only surface blob metadata.
+    size: !isFolder && file.size !== undefined ? Number(file.size) : undefined,
+    modifiedTime: file.modifiedTime,
+    md5: file.md5Checksum,
+  };
+}
+
+/** Last segment of a logical path (the file or folder name). */
+function lastSegment(path: string): string {
+  const segments = splitSegments(path);
+  return segments[segments.length - 1] ?? path;
+}
diff --git a/apps/readest-app/src/services/cloudprovider/buildDriveProvider.ts b/apps/readest-app/src/services/cloudprovider/buildDriveProvider.ts
new file mode 100644
index 00000000..a64c61f5
--- /dev/null
+++ b/apps/readest-app/src/services/cloudprovider/buildDriveProvider.ts
@@ -0,0 +1,211 @@
+/**
+ * Auth plumbing that turns a *connected* Google account into a usable
+ * {@link GoogleDriveProvider}.
+ *
+ * The OAuth flow (`pkce.ts` + `tokenStore.ts`) mints a {@link TokenSet}; this
+ * module is what keeps that set alive afterwards. {@link PersistedDriveAuth}
+ * implements the provider's {@link DriveAuth} seam by holding the current tokens,
+ * transparently refreshing the short-lived access token when it nears expiry, and
+ * writing the result back through an injected {@link TokenPersistence}.
+ * {@link buildDriveProvider} is the thin assembly that wires that auth into a
+ * ready-to-use provider.
+ *
+ * Everything here is pure given its injected collaborators (`persistence`,
+ * `fetchFn`, `now`), so the refresh/persistence logic is unit-testable with no
+ * network, no native secure store, and a deterministic clock.
+ */
+
+import { GoogleDriveProvider, type DriveAuth, type FetchFn } from './GoogleDriveProvider';
+import { refreshAccessToken, type TokenSet } from './googleAuth/tokenStore';
+
+/**
+ * Where the {@link TokenSet} lives between app runs.
+ *
+ * Deliberately an interface, not a concrete store: persisting OAuth tokens needs
+ * a platform secret store (Tauri secure storage on desktop, the Keystore-backed
+ * store on Android), and that concrete, secret-bearing implementation is a
+ * separate later task. By depending only on this seam, the auth logic stays
+ * pure and testable with an in-memory fake.
+ */
+export interface TokenPersistence {
+  /** Load the persisted token set, or null when no account is connected. */
+  load(): Promise<TokenSet | null>;
+  /** Persist (overwrite) the token set after a successful sign-in or refresh. */
+  save(tokens: TokenSet): Promise<void>;
+  /** Forget all stored tokens (sign-out). */
+  clear(): Promise<void>;
+}
+
+/** OAuth client configuration needed to refresh tokens for this app. */
+export interface DriveAuthConfig {
+  /** OAuth client ID registered for this app in Google Cloud. */
+  clientId: string;
+  /**
+   * Client secret, when the client type requires one. Google's "Desktop app"
+   * client issues a (non-confidential) secret it expects at the token endpoint
+   * even under PKCE; pure-PKCE clients omit it. See {@link refreshAccessToken}.
+   */
+  clientSecret?: string;
+}
+
+/**
+ * Clock used to decide whether the access token has expired. Injected (default
+ * {@link Date.now}) so expiry logic is deterministic under test — a fixed `now`
+ * lets a test place a token's `expiresAt` firmly in the past or future without
+ * fragile real-time waits.
+ */
+export type NowFn = () => number;
+
+/** Constructor dependencies for {@link PersistedDriveAuth}. */
+export interface PersistedDriveAuthDeps extends DriveAuthConfig {
+  /** Backing store for the token set (see {@link TokenPersistence}). */
+  persistence: TokenPersistence;
+  /** Clock for expiry checks; defaults to {@link Date.now}. */
+  now?: NowFn;
+}
+
+/**
+ * Display label shown in settings while signed in.
+ *
+ * A stable placeholder for now: resolving the real account email needs an extra
+ * Drive/userinfo call, which is a later hardening step. Named so the UI label is
+ * not a bare string literal and the "real email is TODO" intent is explicit.
+ */
+export const SIGNED_IN_ACCOUNT_LABEL = 'Google Drive';
+
+/**
+ * {@link DriveAuth} backed by persisted tokens with transparent refresh.
+ *
+ * Holds the current {@link TokenSet} in memory, lazily hydrated from
+ * {@link TokenPersistence} on first need and cached thereafter (so repeated
+ * provider calls do not re-hit the store). On each access-token request it
+ * refreshes if the token has expired and a refresh token is available, otherwise
+ * it surfaces a precise error telling the caller which precondition failed.
+ */
+export class PersistedDriveAuth implements DriveAuth {
+  private readonly persistence: TokenPersistence;
+  private readonly clientId: string;
+  private readonly clientSecret?: string;
+  private readonly now: NowFn;
+  private readonly fetchFn: FetchFn;
+
+  /**
+   * In-memory copy of the persisted tokens. `null` means either "not loaded
+   * yet" or "loaded and nothing stored"; {@link loaded} disambiguates so we
+   * never re-read the store for a genuinely-empty account.
+   */
+  private current: TokenSet | null = null;
+  /** Whether {@link load} has run, so we hydrate from persistence exactly once. */
+  private loaded = false;
+
+  constructor(deps: PersistedDriveAuthDeps, fetchFn: FetchFn) {
+    this.persistence = deps.persistence;
+    this.clientId = deps.clientId;
+    this.clientSecret = deps.clientSecret;
+    this.now = deps.now ?? Date.now;
+    this.fetchFn = fetchFn;
+  }
+
+  async getAccessToken(): Promise<string> {
+    const tokens = await this.ensureLoaded();
+    if (tokens === null) {
+      throw new Error(
+        'Drive auth: not signed in (no stored Google credentials). Connect a Google account first.',
+      );
+    }
+
+    if (!this.isExpired(tokens)) {
+      return tokens.accessToken;
+    }
+    // Refresh and cache the renewed set so the next call sees the fresh token.
+    this.current = await this.refresh(tokens);
+    return this.current.accessToken;
+  }
+
+  async accountLabel(): Promise<string | null> {
+    const tokens = await this.ensureLoaded();
+    // Real email lookup is a later hardening step; until then a stable label
+    // signals "connected" and absence-of-tokens signals "not connected".
+    return tokens === null ? null : SIGNED_IN_ACCOUNT_LABEL;
+  }
+
+  /**
+   * Hydrate {@link current} from persistence on first call and return it. Reads
+   * the store at most once for the lifetime of this instance (see {@link loaded}).
+   */
+  private async ensureLoaded(): Promise<TokenSet | null> {
+    if (!this.loaded) {
+      this.current = await this.persistence.load();
+      this.loaded = true;
+    }
+    return this.current;
+  }
+
+  /** True once the token is at or past its (margin-adjusted) expiry instant. */
+  private isExpired(tokens: TokenSet): boolean {
+    // `expiresAt` already bakes in TOKEN_EXPIRY_SAFETY_MARGIN_SEC (see
+    // tokenStore.ts), so a plain `now >= expiresAt` refreshes early enough that
+    // the token stays valid for the duration of the request it authorizes.
+    return this.now() >= tokens.expiresAt;
+  }
+
+  /**
+   * Exchange the refresh token for a fresh access token and return the merged,
+   * already-persisted set. Throws (re-auth required) when no refresh token is
+   * available, since an expired access token with nothing to renew it from is
+   * unusable.
+   */
+  private async refresh(expired: TokenSet): Promise<TokenSet> {
+    if (expired.refreshToken === undefined) {
+      throw new Error(
+        'Drive auth: access token expired and no refresh token is stored; re-authentication required.',
+      );
+    }
+
+    const refreshed = await refreshAccessToken(
+      {
+        refreshToken: expired.refreshToken,
+        clientId: this.clientId,
+        clientSecret: this.clientSecret,
+      },
+      this.fetchFn,
+    );
+
+    // Google omits `refresh_token` on a refresh response, so the renewed set
+    // carries the new access token + expiry but keeps the existing refresh
+    // token — dropping it would strand the account on the next expiry.
+    const merged: TokenSet = {
+      ...refreshed,
+      refreshToken: refreshed.refreshToken ?? expired.refreshToken,
+    };
+    await this.persistence.save(merged);
+    return merged;
+  }
+}
+
+/** Result of {@link buildDriveProvider}: the provider plus its backing auth. */
+export interface DriveProviderBundle {
+  provider: GoogleDriveProvider;
+  auth: PersistedDriveAuth;
+}
+
+/**
+ * Assemble a ready-to-use {@link GoogleDriveProvider} over persisted,
+ * self-refreshing tokens.
+ *
+ * A thin wiring function: it constructs the {@link PersistedDriveAuth} from the
+ * given store/config and hands it (plus the injected `fetch`) to the provider.
+ * Client id/secret arrive via `config` rather than being read from `process.env`
+ * here, so this module stays pure and testable; the caller owns env wiring.
+ */
+export const buildDriveProvider = (
+  persistence: TokenPersistence,
+  config: DriveAuthConfig,
+  fetchFn: FetchFn,
+): DriveProviderBundle => {
+  const auth = new PersistedDriveAuth(
+    { persistence, clientId: config.clientId, clientSecret: config.clientSecret },
+    fetchFn,
+  );
+  return { provider: new GoogleDriveProvider(auth, fetchFn), auth };
+};
diff --git a/apps/readest-app/src/services/cloudprovider/googleAuth/driveRest.ts b/apps/readest-app/src/services/cloudprovider/googleAuth/driveRest.ts
new file mode 100644
index 00000000..74565f62
--- /dev/null
+++ b/apps/readest-app/src/services/cloudprovider/googleAuth/driveRest.ts
@@ -0,0 +1,129 @@
+/**
+ * Pure request builders for the Google Drive v3 REST API.
+ *
+ * The {@link GoogleDriveProvider} drives all of its file operations through the
+ * Drive REST endpoints. Drive is *ID-addressed*: there is no path-based lookup,
+ * so the provider resolves a logical path segment-by-segment with `files.list`
+ * search queries, then acts on the resolved file id with download/upload/metadata
+ * endpoints. The query strings and endpoint URLs those calls need are assembled
+ * here as small pure functions, kept apart from the provider so the exact wire
+ * format (quote escaping, query parameters, `fields` selectors) is unit-testable
+ * without a network and reads as a single source of truth.
+ *
+ * No `fetch`, no auth, no state — every export is a deterministic string builder.
+ */
+
+/** Drive REST collection endpoint for file *metadata* operations (list/get/patch/delete). */
+export const FILES_ENDPOINT = 'https://www.googleapis.com/drive/v3/files';
+
+/**
+ * Drive REST *upload* endpoint (a different host path than {@link FILES_ENDPOINT}).
+ * Drive splits metadata operations from media transfer onto the `/upload/...`
+ * path, so the byte-carrying POST/PATCH requests target this base URL.
+ */
+export const UPLOAD_ENDPOINT = 'https://www.googleapis.com/upload/drive/v3/files';
+
+/** MIME type Drive assigns to folders; the marker we use to tell folders from blobs. */
+export const FOLDER_MIME = 'application/vnd.google-apps.folder';
+
+/**
+ * Escape a string literal for embedding inside a Drive search query.
+ *
+ * Drive query literals are wrapped in single quotes, so any single quote inside
+ * the value (e.g. a file named `O'Brien`) must be backslash-escaped or the query
+ * is malformed. This is the only metacharacter Drive's query grammar requires us
+ * to escape inside a quoted string literal.
+ */
+export const escapeDriveLiteral = (s: string): string => s.replace(/'/g, "\\'");
+
+/**
+ * Build the `files.list` `q` to find a *named* child directly under a parent —
+ * the per-segment lookup that powers path resolution. `trashed = false` keeps
+ * tombstoned files (still listable in Drive) from masking a live file of the
+ * same name.
+ */
+export const listQuery = (name: string, parentId: string): string =>
+  `name = '${escapeDriveLiteral(name)}' and '${parentId}' in parents and trashed = false`;
+
+/**
+ * Build the `files.list` `q` to enumerate *all* live children of a parent — the
+ * query behind {@link CloudProvider.list}.
+ */
+export const childrenQuery = (parentId: string): string =>
+  `'${parentId}' in parents and trashed = false`;
+
+/**
+ * URL to download a file's raw bytes. `alt=media` switches the metadata `get`
+ * endpoint into returning the file *body* instead of its JSON metadata.
+ */
+export const mediaDownloadUrl = (fileId: string): string => `${FILES_ENDPOINT}/${fileId}?alt=media`;
+
+/**
+ * URL for a simple (single-request) media upload that creates a new file.
+ *
+ * `uploadType=media` means the request body *is* the file bytes (no multipart
+ * metadata envelope). `fields` narrows the JSON response to just what the
+ * provider needs — the new `id` (so it can be cached and named) plus the
+ * `md5Checksum`/`size` it surfaces as {@link CloudEntry} metadata.
+ */
+export const simpleUploadUrl = (): string =>
+  `${UPLOAD_ENDPOINT}?uploadType=media&fields=id,md5Checksum,size`;
+
+/**
+ * URL to overwrite an *existing* file's bytes via a media PATCH. Same simple
+ * media transfer as {@link simpleUploadUrl}, but targeted at a known file id.
+ */
+export const mediaUpdateUrl = (fileId: string): string =>
+  `${UPLOAD_ENDPOINT}/${fileId}?uploadType=media&fields=id,md5Checksum,size`;
+
+/**
+ * URL to fetch a single file's metadata, restricted to the {@link CloudEntry}
+ * fields the provider exposes (`name`/`mimeType`/`size`/`modifiedTime`/`md5`).
+ */
+export const metadataUrl = (fileId: string): string =>
+  `${FILES_ENDPOINT}/${fileId}?fields=${FILE_FIELDS}`;
+
+/** URL to delete a file by id. */
+export const deleteUrl = (fileId: string): string => `${FILES_ENDPOINT}/${fileId}`;
+
+/**
+ * URL for the metadata PATCH that renames a freshly-uploaded file and moves it
+ * from the upload's default root location into its target folder.
+ *
+ * `addParents` attaches the file to the destination folder and `removeParents`
+ * detaches it from `root` (a Drive file can have several parents, so an upload
+ * left at root would otherwise *also* appear at the top level). Both are query
+ * parameters, not body fields — only the new `name` rides in the PATCH body.
+ */
+export const reparentUrl = (
+  fileId: string,
+  addParentId: string,
+  removeParentId: string,
+): string => {
+  const url = new URL(`${FILES_ENDPOINT}/${fileId}`);
+  url.searchParams.set('addParents', addParentId);
+  url.searchParams.set('removeParents', removeParentId);
+  return url.toString();
+};
+
+/**
+ * The metadata `fields` selector requested for individual files and list rows.
+ *
+ * Drive omits unrequested fields entirely, so this is the contract for what the
+ * provider can read back: enough to build a {@link CloudEntry} (`id`, `name`,
+ * `mimeType` to detect folders, `size`, `modifiedTime`, `md5Checksum`).
+ */
+const FILE_FIELDS = 'id,name,mimeType,size,modifiedTime,md5Checksum';
+
+/**
+ * Build a `files.list` request URL for the given query, asking for only the
+ * id-resolution/metadata fields the provider uses from each row.
+ */
+export const listUrl = (query: string): string => {
+  const url = new URL(FILES_ENDPOINT);
+  url.searchParams.set('q', query);
+  // Each returned row carries the same per-file fields used elsewhere, nested
+  // under `files(...)`, so list results map straight onto CloudEntry.
+  url.searchParams.set('fields', `files(${FILE_FIELDS})`);
+  return url.toString();
+};
diff --git a/apps/readest-app/src/services/cloudprovider/googleAuth/oauthAndroid.ts b/apps/readest-app/src/services/cloudprovider/googleAuth/oauthAndroid.ts
new file mode 100644
index 00000000..8355fca0
--- /dev/null
+++ b/apps/readest-app/src/services/cloudprovider/googleAuth/oauthAndroid.ts
@@ -0,0 +1,94 @@
+/**
+ * Android wiring of the OAuth authorization-code + PKCE flow: a Chrome Custom Tab
+ * + reverse-DNS custom-scheme redirect.
+ *
+ * Android can't use the desktop loopback flow (the system browser has no way to
+ * hand a `http://127.0.0.1` redirect back to the app). Instead we use the
+ * reverse-DNS scheme an iOS-type Google client issues —
+ * `com.googleusercontent.apps.<id>:/oauthredirect` — registered as a BROWSABLE
+ * deep-link intent-filter so the OS routes the redirect back to the app.
+ *
+ * Consent is opened in a CHROME CUSTOM TAB via Readest's native bridge command
+ * `auth_with_custom_tab` (the same one Readest's own Supabase login uses), NOT an
+ * external browser. This is deliberate and load-bearing: launching a separate
+ * browser app backgrounds the single Tauri Activity, and under memory pressure the
+ * OS destroys it — tearing down the WebView, the in-flight Promise, the redirect
+ * listener, AND the React `isBusy` spinner state, so the FIRST redirect lands on
+ * nothing (observed on-device: first attempt fails, second succeeds). A Custom Tab
+ * renders inside the host task and keeps the process at foreground importance, and
+ * the redirect resolves through a native Kotlin field that survives a WebView
+ * reload — so the first attempt completes and the spinner stays visible. The
+ * native command opens consent AND resolves with the redirect URL in one round
+ * trip. (AppAuth #448 warns of a Custom-Tab custom-scheme bounce on Android 14,
+ * but this is a host-app-owned BROWSABLE scheme — the same class as Readest's
+ * working `readest://auth-callback` — so it routes back correctly.)
+ *
+ * The iOS-type client carries NO client secret and needs NO Android SHA-1 — Google
+ * validates the redirect by string-matching the client-id-derived scheme, and PKCE
+ * is the real client authentication. This holds ONLY while Google App Check (iOS
+ * app attestation) is not enforced on the client — an Android device can't produce
+ * an iOS attestation, so turning it on would break every user at once; keep it off.
+ * One manual per-fork step remains: each builder's own client scheme must be
+ * registered in the Android manifest (the patcher injects it into tauri.conf's
+ * `deep-link.mobile` per build). See {@link deriveReverseDnsRedirectUri}.
+ */
+import { authWithCustomTab } from '@/app/auth/utils/nativeAuth';
+import { createPkcePair } from './pkce';
+import { deriveReverseDnsRedirectUri } from './reverseDnsRedirect';
+import { runOAuthFlow, type OAuthClientConfig } from './oauthFlow';
+import { exchangeCode, type FetchFn, type TokenSet } from './tokenStore';
+
+/**
+ * Run the Android Custom-Tab OAuth flow and return the resulting tokens.
+ *
+ * Wires {@link runOAuthFlow} with the Android mechanics: open consent in a Chrome
+ * Custom Tab and resolve with the redirect the native bridge captures.
+ *
+ * @param config - OAuth client identity + scopes; see {@link OAuthClientConfig}.
+ *   On Android this is the iOS-type client (id only, no secret).
+ * @param fetchFn - platform `fetch` used for the token exchange (Tauri's
+ *   `@tauri-apps/plugin-http` `fetch` in production).
+ */
+export const runAndroidOAuth = async (
+  config: OAuthClientConfig,
+  fetchFn: FetchFn,
+): Promise<TokenSet> => {
+  const redirectUri = deriveReverseDnsRedirectUri(config.clientId);
+
+  // `auth_with_custom_tab` opens consent in a Custom Tab AND resolves with the
+  // redirect URL in a single native round-trip — so it needs the auth URL, which
+  // `runOAuthFlow` only hands to `openUrl`. Bridge the two with a deferred:
+  // `openUrl` supplies the URL, and `awaitRedirect` (which the flow invokes first)
+  // waits for it before driving the Custom Tab. The native side recognises the
+  // redirect by its reverse-DNS scheme, so only the auth URL needs to cross over.
+  let provideAuthUrl!: (url: string) => void;
+  const authUrlReady = new Promise<string>((resolve) => {
+    provideAuthUrl = resolve;
+  });
+
+  return runOAuthFlow(config.scope, {
+    createPkcePair,
+    newState: () => crypto.randomUUID(),
+    clientId: config.clientId,
+    openUrl: async (url) => {
+      provideAuthUrl(url);
+    },
+    awaitRedirect: async () => {
+      const authUrl = await authUrlReady;
+      const { redirectUrl } = await authWithCustomTab({ authUrl });
+      return redirectUrl;
+    },
+    redirectUri,
+    exchange: ({ code, verifier, redirectUri }) =>
+      exchangeCode(
+        {
+          code,
+          verifier,
+          clientId: config.clientId,
+          clientSecret: config.clientSecret,
+          redirectUri,
+        },
+        fetchFn,
+      ),
+  });
+};
diff --git a/apps/readest-app/src/services/cloudprovider/googleAuth/oauthDesktop.ts b/apps/readest-app/src/services/cloudprovider/googleAuth/oauthDesktop.ts
new file mode 100644
index 00000000..2d05e807
--- /dev/null
+++ b/apps/readest-app/src/services/cloudprovider/googleAuth/oauthDesktop.ts
@@ -0,0 +1,97 @@
+/**
+ * Desktop wiring of the OAuth authorization-code + PKCE flow: a loopback
+ * redirect.
+ *
+ * On desktop the provider redirects to `http://127.0.0.1:<port>` after consent.
+ * We spin up a short-lived local HTTP server (the tauri-plugin-oauth loopback
+ * server) to receive that redirect, open the consent URL in the user's default
+ * browser, and capture the redirect the server reports. All of the actual flow
+ * logic lives in {@link runOAuthFlow}; this file is just the thin platform glue
+ * that satisfies its injected {@link OAuthFlowDeps}.
+ *
+ * Confirmed plugin exports (from node_modules .d.ts):
+ *   - `@fabianlars/tauri-plugin-oauth@2.0.0`: `start(config?): Promise<number>`
+ *     (resolves with the bound port), `cancel(port): Promise<void>`,
+ *     `onUrl(cb: (url: string) => void): Promise<() => void>` (unlisten fn).
+ *   - `@tauri-apps/plugin-opener@2.5.4`: `openUrl(url): Promise<void>`.
+ */
+import { start, cancel, onUrl } from '@fabianlars/tauri-plugin-oauth';
+import { openUrl } from '@tauri-apps/plugin-opener';
+import { createPkcePair } from './pkce';
+import { runOAuthFlow, type OAuthClientConfig } from './oauthFlow';
+import { exchangeCode, type FetchFn, type TokenSet } from './tokenStore';
+
+/** Loopback host the provider redirects back to; any port is accepted for desktop clients. */
+const LOOPBACK_HOST = '127.0.0.1';
+/** URL scheme of the loopback redirect (plain HTTP on localhost — never leaves the machine). */
+const LOOPBACK_SCHEME = 'http';
+
+/**
+ * Run the desktop loopback OAuth flow and return the resulting tokens.
+ *
+ * Starts the loopback server, derives `redirectUri = http://127.0.0.1:<port>`,
+ * and wires {@link runOAuthFlow} with the real desktop mechanics. The server is
+ * always cancelled in a `finally` so a failed or abandoned flow never leaks a
+ * listening port.
+ *
+ * @param config - OAuth client identity + scopes; see {@link OAuthClientConfig}.
+ * @param fetchFn - platform `fetch` used for the token exchange (Tauri's
+ *   `@tauri-apps/plugin-http` `fetch` in production).
+ */
+export const runDesktopOAuth = async (
+  config: OAuthClientConfig,
+  fetchFn: FetchFn,
+): Promise<TokenSet> => {
+  // Bind the loopback server first: its port determines the redirect URI we must
+  // register in the auth request, so it has to exist before the flow builds the URL.
+  const port = await start();
+  const redirectUri = `${LOOPBACK_SCHEME}://${LOOPBACK_HOST}:${port}`;
+
+  try {
+    return await runOAuthFlow(config.scope, {
+      createPkcePair,
+      newState: () => crypto.randomUUID(),
+      clientId: config.clientId,
+      openUrl: (url) => openUrl(url),
+      // Arm the loopback listener and resolve with the first redirect URL it
+      // reports, then REMOVE the listener. The `oauth://url` event is global
+      // (not scoped to this port), so a leaked listener from one attempt would
+      // also fire on a later attempt's redirect and cross-wire the flows (state
+      // mismatches). Unlistening on resolve keeps each attempt isolated.
+      awaitRedirect: () =>
+        new Promise<string>((resolve, reject) => {
+          let unlisten: (() => void) | undefined;
+          onUrl((url) => {
+            unlisten?.();
+            resolve(url);
+          })
+            .then((fn) => {
+              unlisten = fn;
+            })
+            .catch(reject);
+        }),
+      redirectUri,
+      exchange: ({ code, verifier }) =>
+        exchangeCode(
+          {
+            code,
+            verifier,
+            clientId: config.clientId,
+            clientSecret: config.clientSecret,
+            redirectUri,
+          },
+          fetchFn,
+        ),
+    });
+  } finally {
+    // Best-effort cleanup — MUST NOT mask a successful flow. The plugin's
+    // loopback server self-closes the instant it captures the redirect (it
+    // `break`s its accept loop), so the port is usually already gone by the time
+    // we get here. `cancel` signals exit by CONNECTING to that port, so it then
+    // fails with "connection actively refused" (os error 10061). Awaiting it
+    // bare in this `finally` would let that throw override the returned tokens
+    // and turn a successful connect into a failure — so we swallow it. (Readest's
+    // own Supabase auth wraps `cancel` in try/catch for exactly this reason.)
+    await cancel(port).catch(() => undefined);
+  }
+};
diff --git a/apps/readest-app/src/services/cloudprovider/googleAuth/oauthDesktopDeepLink.ts b/apps/readest-app/src/services/cloudprovider/googleAuth/oauthDesktopDeepLink.ts
new file mode 100644
index 00000000..a6351824
--- /dev/null
+++ b/apps/readest-app/src/services/cloudprovider/googleAuth/oauthDesktopDeepLink.ts
@@ -0,0 +1,269 @@
+/**
+ * Desktop (Windows) wiring of the OAuth authorization-code + PKCE flow: the
+ * system browser plus a reverse-DNS custom-scheme deep link.
+ *
+ * The cloud-sync mod uses ONE iOS-type Google client (no secret) on every
+ * platform, whose only Google-accepted redirect is the reverse-DNS scheme
+ * `com.googleusercontent.apps.<id>:/oauthredirect`. On desktop we open consent in
+ * the user's default browser; Google redirects to that scheme; Windows routes the
+ * scheme back to the app (the app self-registers it via Tauri's
+ * `deep_link().register_all()` — no installer, no admin, no user action), and the
+ * `single-instance` / `onOpenUrl` channels deliver the redirect URL. This is the
+ * desktop analogue of Android's Custom Tab: same client, same reverse-DNS
+ * redirect, same PKCE token exchange (no secret) — only the capture differs.
+ *
+ * The one Windows subtlety (verified empirically): a browser process only
+ * recognises the scheme if it STARTED AFTER the scheme was registered — Windows
+ * snapshots protocol associations per-process at launch. The user's everyday
+ * browser is usually already running, so it may silently fail to route the
+ * redirect. To stay reliable we open the default browser first (best UX — it
+ * keeps the user's Google session) and, if no redirect returns within a grace
+ * period, re-open consent in a freshly-spawned COLD browser process (the native
+ * `spawn_fresh_browser` command), which reads the just-registered association and
+ * routes the redirect back. Whichever browser returns first wins.
+ *
+ * @see runAndroidOAuth — the structurally identical Custom-Tab runner.
+ */
+import { invoke } from '@tauri-apps/api/core';
+import { getCurrentWindow } from '@tauri-apps/api/window';
+import { onOpenUrl } from '@tauri-apps/plugin-deep-link';
+import { openUrl } from '@tauri-apps/plugin-opener';
+import { createPkcePair } from './pkce';
+import {
+  deriveReverseDnsRedirectScheme,
+  deriveReverseDnsRedirectUri,
+  matchesReverseDnsRedirect,
+} from './reverseDnsRedirect';
+import { runOAuthFlow, type OAuthClientConfig } from './oauthFlow';
+import { exchangeCode, type FetchFn, type TokenSet } from './tokenStore';
+
+/**
+ * Grace period before the cold-browser fallback. Long enough that a user
+ * consenting in their already-cold default browser completes first (so most
+ * connects never spawn a second window), short enough that the silent
+ * already-running-browser failure is recovered without the user feeling stuck.
+ */
+export const DEFAULT_FALLBACK_DELAY_MS = 25_000;
+
+/**
+ * Hard deadline after which an unfinished connect gives up and REJECTS, so the
+ * UI spinner clears and the user can retry instead of being stuck forever.
+ *
+ * Unlike Android's Custom Tab, the external browser gives the app no signal when
+ * the user closes the consent tab (a cancel) — so without this, an abandoned
+ * sign-in would leave the flow pending indefinitely. Deliberately generous: a
+ * real sign-in (account pick + password + possible 2FA, in a freshly-spawned
+ * session-less window) can take many minutes, and aborting a slow-but-valid
+ * sign-in is worse than a late timeout. This is a safety net, not the primary
+ * cancel path.
+ */
+export const CONNECT_DEADLINE_MS = 15 * 60_000;
+
+/**
+ * Native command (registered in `src-tauri/src/lib.rs`) that opens a URL in a
+ * freshly-spawned, isolated browser process — guaranteed to have started after
+ * the scheme was registered, so it can route the reverse-DNS redirect back.
+ */
+const SPAWN_FRESH_BROWSER_COMMAND = 'spawn_fresh_browser';
+
+/** Payload of the desktop `single-instance` event (mirrors `useAppUrlIngress`). */
+interface SingleInstancePayload {
+  args: string[];
+  cwd: string;
+}
+
+/**
+ * Platform mechanics the desktop runner needs, injected so the
+ * open-browser/capture/fallback orchestration can be exercised headlessly. The
+ * production default ({@link defaultDesktopDeepLinkDeps}) binds these to the real
+ * Tauri plugins; tests pass fakes.
+ */
+export interface DesktopDeepLinkDeps {
+  /** Open the consent URL in the user's default browser. */
+  openDefaultBrowser: (url: string) => Promise<void>;
+  /** Open the consent URL in a freshly-spawned cold browser process (fallback). */
+  spawnFreshBrowser: (url: string) => Promise<void>;
+  /**
+   * Subscribe to every redirect URL the OS delivers to the app, invoking `onUrl`
+   * for each. Resolves with an unlisten function. The runner filters the stream
+   * down to this client's reverse-DNS redirect itself.
+   */
+  subscribeRedirects: (onUrl: (url: string) => void) => Promise<() => void>;
+  /** Grace period before the cold-browser fallback fires; see {@link DEFAULT_FALLBACK_DELAY_MS}. */
+  fallbackDelayMs: number;
+  /** Hard deadline after which an unfinished connect rejects; see {@link CONNECT_DEADLINE_MS}. */
+  connectDeadlineMs: number;
+}
+
+/**
+ * Real Tauri capture: the OS hands a routed deep link to an already-running app
+ * via the `single-instance` event (Windows/Linux relaunch — the URL is `args[1]`)
+ * and via the Tauri v2 `onOpenUrl` channel. Both are armed; the caller unlistens
+ * on resolve. (Cold-start `getCurrent()` is intentionally not read: an
+ * interactive Connect always runs with the app already open, and reading a stale
+ * launch URL could resolve the flow with a past redirect that then fails the
+ * state check.)
+ */
+const subscribeRedirectsViaTauri = async (onUrl: (url: string) => void): Promise<() => void> => {
+  const unlistenSingleInstance = await getCurrentWindow().listen<SingleInstancePayload>(
+    'single-instance',
+    ({ payload }) => {
+      const url = payload.args?.[1];
+      if (url) onUrl(url);
+    },
+  );
+  let unlistenOpenUrl: () => void;
+  try {
+    unlistenOpenUrl = await onOpenUrl((urls) => {
+      urls.forEach(onUrl);
+    });
+  } catch (error) {
+    // Don't leak the already-attached first listener if the second registration
+    // fails — an orphaned `single-instance` listener would cross-wire a later attempt.
+    unlistenSingleInstance();
+    throw error;
+  }
+  return () => {
+    unlistenSingleInstance();
+    unlistenOpenUrl();
+  };
+};
+
+/** Production desktop deps, bound to the real Tauri plugins. */
+export const defaultDesktopDeepLinkDeps: DesktopDeepLinkDeps = {
+  openDefaultBrowser: (url) => openUrl(url),
+  spawnFreshBrowser: (url) => invoke<void>(SPAWN_FRESH_BROWSER_COMMAND, { url }),
+  subscribeRedirects: subscribeRedirectsViaTauri,
+  fallbackDelayMs: DEFAULT_FALLBACK_DELAY_MS,
+  connectDeadlineMs: CONNECT_DEADLINE_MS,
+};
+
+/**
+ * Await the reverse-DNS redirect, arming the cold-browser fallback and a hard
+ * deadline. Resolves with the first incoming URL whose scheme matches `scheme`;
+ * ignores every other URL the OS delivers; rejects if nothing arrives before the
+ * deadline. Listeners and timers are torn down on any outcome so a later attempt
+ * cannot cross-wire this one.
+ *
+ * @param authUrlReady - resolves with the consent URL (captured in `openUrl`), so
+ *   the fallback can re-open the exact same request in a cold browser.
+ */
+const awaitRedirectWithFallback = (
+  scheme: string,
+  authUrlReady: Promise<string>,
+  deps: DesktopDeepLinkDeps,
+): Promise<string> =>
+  new Promise<string>((resolve, reject) => {
+    let unlisten: (() => void) | undefined;
+    let settled = false;
+    const timers: ReturnType<typeof setTimeout>[] = [];
+
+    const cleanup = () => {
+      timers.forEach(clearTimeout);
+      unlisten?.();
+    };
+    const finish = (url: string) => {
+      if (settled) return;
+      settled = true;
+      cleanup();
+      resolve(url);
+    };
+    const fail = (error: unknown) => {
+      if (settled) return;
+      settled = true;
+      cleanup();
+      reject(error);
+    };
+
+    deps
+      .subscribeRedirects((url) => {
+        if (matchesReverseDnsRedirect(url, scheme)) finish(url);
+      })
+      .then((dispose) => {
+        unlisten = dispose;
+        // The redirect can land before `subscribeRedirects` resolves its unlisten;
+        // dispose immediately if so to avoid leaking the listener.
+        if (settled) dispose();
+      })
+      .catch(fail);
+
+    // Fallback: the user's default browser may have started before the app
+    // registered the scheme, so it can't route the redirect. After a grace
+    // period, open consent again in a freshly-spawned (cold) browser process,
+    // which reads the just-registered association and CAN route it back. The
+    // original listeners stay armed, so whichever browser returns first wins. A
+    // fallback failure (e.g. Edge absent) is logged, not fatal — the deadline
+    // below still bounds the wait, and the default browser may yet return.
+    timers.push(
+      setTimeout(() => {
+        authUrlReady
+          .then((authUrl) => deps.spawnFreshBrowser(authUrl))
+          .catch((error) => console.warn('Cloud sync: cold-browser fallback failed', error));
+      }, deps.fallbackDelayMs),
+    );
+
+    // Hard deadline so an abandoned sign-in (no redirect ever arrives) rejects
+    // and clears the UI spinner instead of hanging forever; see CONNECT_DEADLINE_MS.
+    timers.push(
+      setTimeout(
+        () => fail(new Error('Google sign-in did not complete in time')),
+        deps.connectDeadlineMs,
+      ),
+    );
+  });
+
+/**
+ * Run the desktop reverse-DNS deep-link OAuth flow and return the resulting
+ * tokens.
+ *
+ * Wires {@link runOAuthFlow} with the desktop mechanics: open consent in the
+ * default browser and resolve with the redirect the OS routes back, falling back
+ * to a cold browser if the default one cannot route it.
+ *
+ * @param config - OAuth client identity + scopes; see {@link OAuthClientConfig}.
+ *   This is the iOS-type client (id only, no secret) — identical to Android.
+ * @param fetchFn - platform `fetch` used for the token exchange.
+ * @param deps - injected platform mechanics; defaults to the real Tauri wiring.
+ */
+export const runDesktopDeepLinkOAuth = (
+  config: OAuthClientConfig,
+  fetchFn: FetchFn,
+  deps: DesktopDeepLinkDeps = defaultDesktopDeepLinkDeps,
+): Promise<TokenSet> => {
+  const redirectUri = deriveReverseDnsRedirectUri(config.clientId);
+  const scheme = deriveReverseDnsRedirectScheme(config.clientId);
+
+  // The cold-browser fallback (inside `awaitRedirect`) needs the consent URL,
+  // which `runOAuthFlow` only hands to `openUrl`. Bridge the two with a deferred
+  // (the same labeled idiom `runAndroidOAuth` uses): `openUrl` supplies the URL,
+  // the fallback awaits it.
+  let provideAuthUrl!: (url: string) => void;
+  const authUrlReady = new Promise<string>((resolve) => {
+    provideAuthUrl = resolve;
+  });
+
+  return runOAuthFlow(config.scope, {
+    createPkcePair,
+    newState: () => crypto.randomUUID(),
+    clientId: config.clientId,
+    openUrl: async (url) => {
+      provideAuthUrl(url);
+      await deps.openDefaultBrowser(url);
+    },
+    awaitRedirect: () => awaitRedirectWithFallback(scheme, authUrlReady, deps),
+    redirectUri,
+    exchange: ({ code, verifier, redirectUri }) =>
+      exchangeCode(
+        {
+          code,
+          verifier,
+          clientId: config.clientId,
+          // The iOS-type client carries no secret; this stays undefined (kept for
+          // shape symmetry with the loopback/Android runners).
+          clientSecret: config.clientSecret,
+          redirectUri,
+        },
+        fetchFn,
+      ),
+  });
+};
diff --git a/apps/readest-app/src/services/cloudprovider/googleAuth/oauthFlow.ts b/apps/readest-app/src/services/cloudprovider/googleAuth/oauthFlow.ts
new file mode 100644
index 00000000..e090a249
--- /dev/null
+++ b/apps/readest-app/src/services/cloudprovider/googleAuth/oauthFlow.ts
@@ -0,0 +1,105 @@
+/**
+ * Provider-agnostic orchestration of the OAuth 2.0 authorization-code flow with
+ * PKCE — the single place where the end-to-end sequence lives.
+ *
+ * The sequence (mint PKCE + state → build the auth URL → open it and capture the
+ * redirect → verify state and pull the code → exchange for tokens) is identical
+ * on every platform; only *how* the URL is opened and *how* the redirect is
+ * captured differ. Those platform mechanics are injected as {@link OAuthFlowDeps}
+ * so this module needs no Tauri plugins and no network, which makes the
+ * security-critical glue (state/PKCE handling) unit-testable headlessly while
+ * the desktop/Android wrappers supply the real wiring.
+ *
+ * Mirrors the pure-given-injected-dependencies style of the sibling `pkce.ts`,
+ * `parseRedirect.ts`, and `tokenStore.ts`, all of which this composes.
+ */
+import { buildAuthUrl } from './pkce';
+import { parseRedirect } from './parseRedirect';
+import type { TokenSet } from './tokenStore';
+
+/**
+ * The OAuth client identity a platform wrapper needs to run a flow.
+ *
+ * Shared by the desktop and Android wrappers so both describe their inputs the
+ * same way (DRY); the redirect URI is *not* here because it is platform-derived
+ * (a loopback port on desktop, a fixed custom scheme on Android).
+ */
+export interface OAuthClientConfig {
+  /** OAuth client ID registered for this app in Google Cloud. */
+  clientId: string;
+  /**
+   * Client secret, for client types that require one at the token endpoint.
+   * Google's "Desktop app" client type issues one even under PKCE; pure-PKCE
+   * clients omit it. See `tokenStore.ts`'s `ClientSecretParam`.
+   */
+  clientSecret?: string;
+  /** Space-delimited OAuth scopes to request (e.g. the Drive app-file scope). */
+  scope: string;
+}
+
+/**
+ * Platform mechanics the flow needs, injected so the orchestration stays pure.
+ *
+ * The real desktop/Android wirings provide these from Tauri plugins; tests pass
+ * fakes. Each dependency is typed precisely to exactly what the flow calls so a
+ * fake (or a plugin) can satisfy it without leaking `any` across the boundary.
+ */
+export interface OAuthFlowDeps {
+  /** Mint a fresh PKCE verifier/challenge pair (see `pkce.ts`'s `createPkcePair`). */
+  createPkcePair: () => Promise<{ verifier: string; challenge: string }>;
+  /** Mint a fresh opaque anti-CSRF `state` value (e.g. `crypto.randomUUID`). */
+  newState: () => string;
+  /** OAuth client ID registered for this app in Google Cloud. */
+  clientId: string;
+  /** Open the authorization URL where the user consents (browser / deep link). */
+  openUrl: (url: string) => Promise<void>;
+  /** Resolve with the full redirect URL once the provider bounces back. */
+  awaitRedirect: (redirectUri: string) => Promise<string>;
+  /** Redirect URI for this platform (loopback `http://127.0.0.1:<port>` on desktop, or the Android reverse-DNS custom scheme). */
+  redirectUri: string;
+  /** Exchange the authorization `code` (+ PKCE verifier) for tokens (see `tokenStore.ts`). */
+  exchange: (args: { code: string; verifier: string; redirectUri: string }) => Promise<TokenSet>;
+}
+
+/**
+ * Run the OAuth authorization-code + PKCE flow and return the resulting tokens.
+ *
+ * @param scope - space-delimited OAuth scopes to request (passed in, never
+ *   hardcoded, so this stays provider/feature-agnostic).
+ * @param deps - injected platform mechanics; see {@link OAuthFlowDeps}.
+ * @returns the {@link TokenSet} from the token exchange.
+ * @throws if the redirect fails the CSRF/state check, carries a provider error,
+ *   or lacks a code (via `parseRedirect`), or if the exchange itself fails —
+ *   each error propagates with the context its source attached.
+ */
+export const runOAuthFlow = async (scope: string, deps: OAuthFlowDeps): Promise<TokenSet> => {
+  const { challenge, verifier } = await deps.createPkcePair();
+  // `state` is minted here and verified by `parseRedirect` below; this is the
+  // CSRF guard proving the redirect answers *our* request, so it must be a fresh
+  // unguessable value per attempt and never reused across calls.
+  const state = deps.newState();
+
+  const authUrl = buildAuthUrl({
+    clientId: deps.clientId,
+    redirectUri: deps.redirectUri,
+    scope,
+    challenge,
+    state,
+  });
+
+  // Begin awaiting the redirect BEFORE opening the consent URL: opening can race
+  // ahead (the user may consent and the provider may redirect before a listener
+  // attached afterwards is ready), so the capture must already be armed. Both
+  // run concurrently and we wait only for the redirect.
+  const redirectPromise = deps.awaitRedirect(deps.redirectUri);
+  await deps.openUrl(authUrl);
+  const redirectUrl = await redirectPromise;
+
+  // Verifies state (CSRF) and extracts the code, throwing with a specific reason
+  // on error/mismatch/missing-code — the one place those checks live.
+  const { code } = parseRedirect(redirectUrl, state);
+
+  // PKCE binds this code to us via the verifier whose challenge we sent above;
+  // redirectUri must match the one in the auth request exactly, so reuse it.
+  return deps.exchange({ code, verifier, redirectUri: deps.redirectUri });
+};
diff --git a/apps/readest-app/src/services/cloudprovider/googleAuth/parseRedirect.ts b/apps/readest-app/src/services/cloudprovider/googleAuth/parseRedirect.ts
new file mode 100644
index 00000000..81ec6e7b
--- /dev/null
+++ b/apps/readest-app/src/services/cloudprovider/googleAuth/parseRedirect.ts
@@ -0,0 +1,77 @@
+/**
+ * Parse the OAuth redirect Google sends back after the consent screen and pull
+ * out the authorization `code`, with CSRF (anti-forgery) protection.
+ *
+ * The authorization-code flow returns its result as query parameters on a
+ * redirect URL: a loopback `http://127.0.0.1:.../?code=...&state=...` on desktop,
+ * or a custom-scheme deep link
+ * (`com.googleusercontent.apps.<id>:/oauthredirect?code=...&state=...`) on Android.
+ * Both platforms funnel that URL through this single pure helper — no network, no
+ * platform APIs — so the security-critical checks live in exactly one place.
+ *
+ * The PKCE `state` value minted in `pkce.ts`'s `buildAuthUrl` is echoed back here
+ * unchanged; comparing it to the value we generated is the CSRF guard that proves
+ * this redirect answers *our* authorization request and was not injected by an
+ * attacker.
+ */
+
+/**
+ * Redirect query-parameter names Google returns. Named so the checks below read
+ * as a checklist rather than a wall of string literals (mirrors `pkce.ts`).
+ */
+const REDIRECT_PARAM = {
+  code: 'code',
+  state: 'state',
+  error: 'error',
+} as const;
+
+/** The authorization `code` extracted from a successful redirect. */
+export interface RedirectResult {
+  /** Short-lived authorization code to exchange for tokens at the token endpoint. */
+  code: string;
+}
+
+/**
+ * Extract the authorization `code` from an OAuth redirect URL, verifying the
+ * returned `state` matches the one we sent.
+ *
+ * @param redirectUrl - the full redirect URL captured from the loopback server
+ *   (desktop) or the deep-link intent (Android).
+ * @param expectedState - the `state` we generated for this authorization attempt
+ *   (see `buildAuthUrl`); the redirect's `state` must equal it.
+ * @returns the authorization `code` on success.
+ * @throws if the provider reported an error, the `state` fails the CSRF check, or
+ *   no `code` is present — each with a message naming which check failed.
+ */
+export const parseRedirect = (redirectUrl: string, expectedState: string): RedirectResult => {
+  const params = new URL(redirectUrl).searchParams;
+
+  // Error-first: when the user denies consent (or Google aborts), the redirect
+  // carries an `error` param and no `code`, and its `state` may be missing or
+  // not match. Surfacing the provider's reason is the most actionable signal for
+  // debugging the live flow, so it must win over the CSRF/missing-code checks
+  // rather than being masked by them.
+  const error = params.get(REDIRECT_PARAM.error);
+  if (error) {
+    throw new Error(`OAuth redirect returned an error: ${error}`);
+  }
+
+  // CSRF guard: the redirect must echo back the exact `state` we generated for
+  // this attempt; a mismatch means it does not answer our request.
+  const state = params.get(REDIRECT_PARAM.state);
+  if (state !== expectedState) {
+    throw new Error(
+      `OAuth redirect state mismatch (CSRF guard): expected "${expectedState}", got "${state}"`,
+    );
+  }
+
+  // A redirect with no `code` is unusable — there is nothing to exchange for
+  // tokens — so fail loudly instead of returning an empty code that would only
+  // surface as a confusing failure later at the token endpoint.
+  const code = params.get(REDIRECT_PARAM.code);
+  if (!code) {
+    throw new Error('OAuth redirect is missing the authorization code');
+  }
+
+  return { code };
+};
diff --git a/apps/readest-app/src/services/cloudprovider/googleAuth/pkce.ts b/apps/readest-app/src/services/cloudprovider/googleAuth/pkce.ts
new file mode 100644
index 00000000..da81b54b
--- /dev/null
+++ b/apps/readest-app/src/services/cloudprovider/googleAuth/pkce.ts
@@ -0,0 +1,162 @@
+/**
+ * PKCE (Proof Key for Code Exchange, RFC 7636) helpers for Google's OAuth 2.0
+ * authorization-code flow, plus the matching authorization-URL builder.
+ *
+ * Readest ships as a distributed native app (desktop + Android). Such public
+ * clients cannot keep a client secret confidential, so the flow uses PKCE
+ * instead: each authorization attempt mints a fresh random `verifier`, sends
+ * only its SHA-256 `challenge` to the authorization endpoint, and later proves
+ * possession of the original `verifier` at the token endpoint. This binds the
+ * authorization code to this client and defeats code-interception attacks
+ * (e.g. another app registered on the same custom URI scheme).
+ *
+ * Pure functions only — no network, no platform APIs beyond Web Crypto, which
+ * is available in the browser, Node, and Tauri's webview alike.
+ */
+
+/**
+ * Number of random bytes drawn for the code verifier.
+ *
+ * RFC 7636 §4.1 requires the verifier to be 43-128 characters of the unreserved
+ * set. Base64url-encoding N raw bytes yields ceil(N / 3) * 4 characters with no
+ * padding once stripped; 64 bytes encode to 86 characters, comfortably inside
+ * the 43-128 window while staying at the high-entropy end of the range.
+ */
+const VERIFIER_RANDOM_BYTES = 64;
+
+/** Digest algorithm for the PKCE challenge; the only secure option per RFC 7636. */
+const CHALLENGE_DIGEST_ALGORITHM = 'SHA-256';
+
+/** Google's OAuth 2.0 authorization endpoint (the page where the user consents). */
+const GOOGLE_AUTH_ENDPOINT = 'https://accounts.google.com/o/oauth2/v2/auth';
+
+/**
+ * OAuth query-parameter names sent to {@link GOOGLE_AUTH_ENDPOINT}. Named so the
+ * builder reads as a spec checklist rather than a wall of string literals.
+ */
+const AUTH_PARAM = {
+  clientId: 'client_id',
+  redirectUri: 'redirect_uri',
+  responseType: 'response_type',
+  scope: 'scope',
+  codeChallenge: 'code_challenge',
+  codeChallengeMethod: 'code_challenge_method',
+  state: 'state',
+  accessType: 'access_type',
+  prompt: 'prompt',
+} as const;
+
+/** We run the authorization-code flow, so the endpoint must return a `code`. */
+const RESPONSE_TYPE_CODE = 'code';
+
+/** Tells Google the challenge is the SHA-256 (S256) transform, not plaintext. */
+const CODE_CHALLENGE_METHOD_S256 = 'S256';
+
+/**
+ * `offline` makes Google issue a refresh token alongside the access token, so
+ * the app can keep syncing after the short-lived access token expires without
+ * sending the user back through consent.
+ */
+const ACCESS_TYPE_OFFLINE = 'offline';
+
+/**
+ * `consent` forces the consent screen every time. Google only returns a refresh
+ * token on the *first* consent for a given client unless re-consent is forced,
+ * so this guarantees `access_type=offline` actually yields a refresh token.
+ */
+const PROMPT_CONSENT = 'consent';
+
+/** A cryptographically random PKCE verifier and its derived S256 challenge. */
+export interface PkcePair {
+  /** High-entropy secret kept by the client and replayed at the token endpoint. */
+  verifier: string;
+  /** Base64url(SHA-256(verifier)), the public value sent to the auth endpoint. */
+  challenge: string;
+}
+
+/** Inputs needed to assemble the Google authorization URL. */
+export interface AuthUrlParams {
+  /** OAuth client ID registered for this app in Google Cloud. */
+  clientId: string;
+  /** Where Google redirects after consent (loopback URL or deep-link scheme). */
+  redirectUri: string;
+  /** Space-delimited OAuth scopes (e.g. the Drive app-file scope). */
+  scope: string;
+  /** The PKCE `code_challenge` produced by {@link createPkcePair}. */
+  challenge: string;
+  /** Opaque anti-CSRF value echoed back by Google for the caller to verify. */
+  state: string;
+}
+
+/**
+ * Encode raw bytes as base64url **without padding**, per RFC 7636 §A.
+ *
+ * PKCE values travel in URLs, so the standard base64 alphabet's `+`, `/`, and
+ * `=` (which would need percent-encoding) are replaced/stripped: `+`→`-`,
+ * `/`→`_`, and trailing `=` removed. Single source of truth for both the
+ * verifier and the challenge encodings.
+ */
+const base64UrlEncode = (bytes: Uint8Array): string => {
+  // Build the binary string Web's `btoa` expects (one char per byte).
+  let binary = '';
+  for (const byte of bytes) {
+    binary += String.fromCharCode(byte);
+  }
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+};
+
+/**
+ * Derive the PKCE `code_challenge` from a verifier (RFC 7636 §4.6: the S256
+ * transform is `base64url(SHA-256(ASCII(verifier)))`).
+ *
+ * Exported so the exact transform is testable against the spec's known-answer
+ * vector — the most common PKCE bug is hashing the raw verifier bytes instead
+ * of the ASCII octets of the verifier string, which a random-input test cannot
+ * catch.
+ */
+export const computeChallenge = async (verifier: string): Promise<string> => {
+  // RFC 7636 §4.6: hash the US-ASCII octets of the verifier string itself.
+  const verifierBytes = new TextEncoder().encode(verifier);
+  const digest = await crypto.subtle.digest(CHALLENGE_DIGEST_ALGORITHM, verifierBytes);
+  return base64UrlEncode(new Uint8Array(digest));
+};
+
+/**
+ * Create a fresh PKCE verifier/challenge pair.
+ *
+ * The verifier is base64url-encoded random bytes, which keeps it inside the
+ * RFC 7636 unreserved-character set and length window by construction. The
+ * challenge is derived via {@link computeChallenge}.
+ */
+export const createPkcePair = async (): Promise<PkcePair> => {
+  const randomBytes = crypto.getRandomValues(new Uint8Array(VERIFIER_RANDOM_BYTES));
+  const verifier = base64UrlEncode(randomBytes);
+  const challenge = await computeChallenge(verifier);
+  return { verifier, challenge };
+};
+
+/**
+ * Build the Google authorization URL the user is sent to in order to grant
+ * access. The caller opens this URL (desktop loopback or Android deep link) and
+ * later exchanges the returned `code` plus the PKCE `verifier` for tokens.
+ */
+export const buildAuthUrl = ({
+  clientId,
+  redirectUri,
+  scope,
+  challenge,
+  state,
+}: AuthUrlParams): string => {
+  const url = new URL(GOOGLE_AUTH_ENDPOINT);
+  const params = url.searchParams;
+  params.set(AUTH_PARAM.clientId, clientId);
+  params.set(AUTH_PARAM.redirectUri, redirectUri);
+  params.set(AUTH_PARAM.responseType, RESPONSE_TYPE_CODE);
+  params.set(AUTH_PARAM.scope, scope);
+  params.set(AUTH_PARAM.codeChallenge, challenge);
+  params.set(AUTH_PARAM.codeChallengeMethod, CODE_CHALLENGE_METHOD_S256);
+  params.set(AUTH_PARAM.state, state);
+  params.set(AUTH_PARAM.accessType, ACCESS_TYPE_OFFLINE);
+  params.set(AUTH_PARAM.prompt, PROMPT_CONSENT);
+  return url.toString();
+};
diff --git a/apps/readest-app/src/services/cloudprovider/googleAuth/reverseDnsRedirect.ts b/apps/readest-app/src/services/cloudprovider/googleAuth/reverseDnsRedirect.ts
new file mode 100644
index 00000000..0d973b28
--- /dev/null
+++ b/apps/readest-app/src/services/cloudprovider/googleAuth/reverseDnsRedirect.ts
@@ -0,0 +1,64 @@
+/**
+ * The reverse-DNS OAuth redirect shared by every platform's runner.
+ *
+ * One iOS-type Google client (no secret, no SHA-1) serves Windows AND Android by
+ * redirecting to its "iOS URL scheme" — {@link GOOGLE_OAUTH_REDIRECT_SCHEME_PREFIX}
+ * followed by the client id's identifier part. Both the desktop deep-link runner
+ * and the Android Custom-Tab runner derive the exact same redirect from the client
+ * id here, so the auth request, the token exchange, and the registered intent-filter
+ * / desktop scheme stay byte-for-byte in agreement for every builder's own client.
+ */
+
+/**
+ * Scheme prefix of Google's reverse-DNS "iOS URL scheme". The redirect scheme is
+ * this followed by the client id's identifier part. Exported so the deep-link
+ * ingress filter ({@link useAppUrlIngress}) detects and skips OAuth redirect URLs
+ * without restating the literal. (The native Android `handleIntent` derives the
+ * exact scheme from the auth request's `redirect_uri` instead, so it keeps no copy.)
+ */
+export const GOOGLE_OAUTH_REDIRECT_SCHEME_PREFIX = 'com.googleusercontent.apps.';
+
+/** Suffix every Google OAuth client id ends with; stripped to form the scheme. */
+const GOOGLE_CLIENT_ID_SUFFIX = '.apps.googleusercontent.com';
+
+/** Path the redirect targets after the reverse-DNS scheme (a SINGLE slash). */
+const OAUTH_REDIRECT_PATH = ':/oauthredirect';
+
+/**
+ * Derive the reverse-DNS redirect SCHEME from a Google OAuth client id.
+ *
+ * Google issues an iOS-type client the scheme
+ * {@link GOOGLE_OAUTH_REDIRECT_SCHEME_PREFIX}`<X>`, where `<X>` is the client id
+ * minus its `.apps.googleusercontent.com` suffix. This is the bare scheme (no
+ * path) — what the desktop webview runner hands to the native `on_navigation`
+ * matcher and what an OS intent-filter / registry key registers. Lower-cased
+ * because OS scheme matching is case-sensitive and lowercase.
+ */
+export const deriveReverseDnsRedirectScheme = (clientId: string): string => {
+  const identifier = clientId.endsWith(GOOGLE_CLIENT_ID_SUFFIX)
+    ? clientId.slice(0, -GOOGLE_CLIENT_ID_SUFFIX.length)
+    : clientId;
+  return `${GOOGLE_OAUTH_REDIRECT_SCHEME_PREFIX}${identifier.toLowerCase()}`;
+};
+
+/**
+ * Derive the full reverse-DNS redirect URI from a Google OAuth client id: the
+ * {@link deriveReverseDnsRedirectScheme} scheme followed by `:/oauthredirect`
+ * (a SINGLE slash). Deriving it — rather than hardcoding one builder's value —
+ * keeps the auth request, the token exchange, and the registered redirect in
+ * byte-for-byte agreement for each builder's own client.
+ */
+export const deriveReverseDnsRedirectUri = (clientId: string): string =>
+  `${deriveReverseDnsRedirectScheme(clientId)}${OAUTH_REDIRECT_PATH}`;
+
+/**
+ * Whether an OS-delivered URL is *this* client's reverse-DNS OAuth redirect.
+ *
+ * Used by the desktop deep-link runner to pick our redirect out of the stream of
+ * URLs the OS can hand the app (book files, other deep links). Matched
+ * case-insensitively because Windows can relaunch the app with a differently-cased
+ * scheme in argv than was registered; the trailing `:` is required so a scheme
+ * that is a prefix of a longer one cannot false-match.
+ */
+export const matchesReverseDnsRedirect = (url: string, scheme: string): boolean =>
+  url.toLowerCase().startsWith(`${scheme.toLowerCase()}:`);
diff --git a/apps/readest-app/src/services/cloudprovider/googleAuth/tokenStore.ts b/apps/readest-app/src/services/cloudprovider/googleAuth/tokenStore.ts
new file mode 100644
index 00000000..93a3745e
--- /dev/null
+++ b/apps/readest-app/src/services/cloudprovider/googleAuth/tokenStore.ts
@@ -0,0 +1,223 @@
+/**
+ * Google OAuth 2.0 token endpoint operations for the PKCE authorization-code
+ * flow: exchanging an authorization `code` for tokens, and later refreshing the
+ * short-lived access token.
+ *
+ * Readest is a distributed native app (desktop + Android). Such public clients
+ * cannot keep a client secret confidential, so neither request sends one — the
+ * authorization code is instead bound to this client by replaying the PKCE
+ * `code_verifier` (see the sibling `pkce.ts`).
+ *
+ * The request/parse logic is pure given an injected `fetch`, which keeps it
+ * testable without a network and platform-agnostic (browser, Node, or Tauri's
+ * webview can each supply a compatible `fetch`).
+ */
+
+/** Google's OAuth 2.0 token endpoint (exchanges/refreshes tokens). */
+export const GOOGLE_TOKEN_ENDPOINT = 'https://oauth2.googleapis.com/token';
+
+/**
+ * Renew the access token this many seconds *before* its real expiry.
+ *
+ * Google reports the lifetime via `expires_in`; if we treated the token as valid
+ * up to the very last second, a request that started just before expiry could
+ * arrive after it and be rejected (and clock skew between client and Google
+ * makes the boundary fuzzy anyway). Trimming the usable lifetime by a small
+ * margin guarantees the token is comfortably valid for the duration of any
+ * single request we make with it.
+ */
+export const TOKEN_EXPIRY_SAFETY_MARGIN_SEC = 60;
+
+/** Milliseconds per second — `expires_in` is in seconds, `expiresAt` in ms. */
+const MS_PER_SEC = 1000;
+
+/** Token-request form field names, named so each request reads as a checklist. */
+const TOKEN_PARAM = {
+  grantType: 'grant_type',
+  code: 'code',
+  codeVerifier: 'code_verifier',
+  clientId: 'client_id',
+  clientSecret: 'client_secret',
+  redirectUri: 'redirect_uri',
+  refreshToken: 'refresh_token',
+} as const;
+
+/** OAuth grant types this module uses at the token endpoint. */
+const GRANT_TYPE = {
+  /** Exchanging the authorization `code` (+ PKCE verifier) for tokens. */
+  authorizationCode: 'authorization_code',
+  /** Trading a refresh token for a fresh access token. */
+  refreshToken: 'refresh_token',
+} as const;
+
+/** The token endpoint expects a URL-encoded form body, not JSON. */
+const FORM_CONTENT_TYPE = 'application/x-www-form-urlencoded';
+const CONTENT_TYPE_HEADER = 'Content-Type';
+const HTTP_POST = 'POST';
+
+/**
+ * Injected fetch implementation. Typed narrowly to exactly what this module
+ * needs so callers can pass the platform's `fetch` (or a stub in tests) without
+ * pulling in the full overloaded `fetch` signature.
+ */
+export type FetchFn = (input: string, init: RequestInit) => Promise<Response>;
+
+/** A set of tokens with the access token's expiry resolved to absolute time. */
+export interface TokenSet {
+  /** Short-lived bearer token used to authorize Google API calls. */
+  accessToken: string;
+  /** Long-lived token used to mint new access tokens; absent on refresh. */
+  refreshToken?: string;
+  /** Absolute expiry as epoch milliseconds, already adjusted for the margin. */
+  expiresAt: number;
+}
+
+/**
+ * Client secret for the OAuth client, when the client type requires one.
+ *
+ * Google's "Desktop app" client type issues a secret and expects it at the
+ * token endpoint *even with PKCE*. For installed/desktop apps Google documents
+ * this secret as NOT confidential — it ships inside the distributed binary and
+ * PKCE is what actually protects the exchange. Optional here so pure-PKCE
+ * clients (e.g. a future Dropbox provider) can omit it.
+ */
+interface ClientSecretParam {
+  clientSecret?: string;
+}
+
+/** Inputs for {@link exchangeCode}. */
+export interface ExchangeCodeParams extends ClientSecretParam {
+  /** Authorization code Google returned to the redirect URI. */
+  code: string;
+  /** PKCE verifier whose challenge was sent to the authorization endpoint. */
+  verifier: string;
+  /** OAuth client ID registered for this app in Google Cloud. */
+  clientId: string;
+  /** Redirect URI used in the authorization request; must match exactly. */
+  redirectUri: string;
+}
+
+/** Inputs for {@link refreshAccessToken}. */
+export interface RefreshTokenParams extends ClientSecretParam {
+  /** Refresh token obtained from a prior {@link exchangeCode}. */
+  refreshToken: string;
+  /** OAuth client ID registered for this app in Google Cloud. */
+  clientId: string;
+}
+
+/**
+ * Raw JSON shape Google's token endpoint returns on success. Modeled explicitly
+ * (rather than `any`) so the mapping into {@link TokenSet} is type-checked.
+ */
+interface TokenEndpointResponse {
+  access_token: string;
+  refresh_token?: string;
+  /** Access-token lifetime in seconds from the moment of issue. */
+  expires_in: number;
+}
+
+/** Which token-endpoint call is being made; used only for error labelling. */
+type TokenOperation = 'exchange' | 'refresh';
+
+/**
+ * Best-effort read of Google's error payload so a thrown error can name the
+ * cause. The token endpoint returns `{ error, error_description }` on failure
+ * (e.g. `invalid_grant`, `redirect_uri_mismatch`) — by far the most useful
+ * signal when debugging the live OAuth flow. Reading the body can itself fail
+ * (already-consumed/streamed body), so any problem collapses to no detail
+ * rather than masking the original HTTP error.
+ */
+const readErrorDetail = async (res: Response): Promise<string> => {
+  try {
+    const body = (await res.json()) as { error?: string; error_description?: string };
+    const parts = [body.error, body.error_description].filter(Boolean);
+    return parts.length > 0 ? `: ${parts.join(' — ')}` : '';
+  } catch {
+    return '';
+  }
+};
+
+/**
+ * POST a form body to the token endpoint, parse the JSON, and map it into a
+ * {@link TokenSet}. Shared by both operations so the request/parse/error logic
+ * lives in exactly one place.
+ *
+ * @param params - already-built form fields for this specific grant.
+ * @param operation - which call this is, included in error messages so a
+ *   failure clearly states whether exchange or refresh failed.
+ */
+const requestTokens = async (
+  params: URLSearchParams,
+  operation: TokenOperation,
+  fetchFn: FetchFn,
+): Promise<TokenSet> => {
+  const res = await fetchFn(GOOGLE_TOKEN_ENDPOINT, {
+    method: HTTP_POST,
+    headers: { [CONTENT_TYPE_HEADER]: FORM_CONTENT_TYPE },
+    body: params.toString(),
+  });
+
+  if (!res.ok) {
+    const detail = await readErrorDetail(res);
+    throw new Error(`Google token ${operation} failed with HTTP ${res.status}${detail}`);
+  }
+
+  const data = (await res.json()) as TokenEndpointResponse;
+  // Clamp so an unusually short-lived token (expires_in <= margin) is never
+  // assigned an expiry in the past, which would mark a just-issued token as
+  // already expired and trigger a needless immediate refresh.
+  const usableLifetimeSec = Math.max(0, data.expires_in - TOKEN_EXPIRY_SAFETY_MARGIN_SEC);
+  return {
+    accessToken: data.access_token,
+    refreshToken: data.refresh_token,
+    expiresAt: Date.now() + usableLifetimeSec * MS_PER_SEC,
+  };
+};
+
+/**
+ * Append the client secret to a token request when the client type supplies one.
+ * Kept in one place so both exchange and refresh treat it identically: a
+ * pure-PKCE client omits it; a Google Desktop client includes it.
+ */
+const appendClientSecret = (params: URLSearchParams, clientSecret?: string): void => {
+  if (clientSecret) {
+    params.set(TOKEN_PARAM.clientSecret, clientSecret);
+  }
+};
+
+/**
+ * Exchange an authorization `code` (plus the PKCE `verifier`) for an access and
+ * refresh token. PKCE binds the code to this client; `client_secret` is sent
+ * only when the client type requires it (Google Desktop) — see
+ * {@link ClientSecretParam}.
+ */
+export const exchangeCode = (
+  { code, verifier, clientId, redirectUri, clientSecret }: ExchangeCodeParams,
+  fetchFn: FetchFn,
+): Promise<TokenSet> => {
+  const params = new URLSearchParams();
+  params.set(TOKEN_PARAM.grantType, GRANT_TYPE.authorizationCode);
+  params.set(TOKEN_PARAM.code, code);
+  params.set(TOKEN_PARAM.codeVerifier, verifier);
+  params.set(TOKEN_PARAM.clientId, clientId);
+  params.set(TOKEN_PARAM.redirectUri, redirectUri);
+  appendClientSecret(params, clientSecret);
+  return requestTokens(params, 'exchange', fetchFn);
+};
+
+/**
+ * Trade a refresh token for a fresh access token once the previous one nears
+ * expiry. Google does not return a new refresh token here, so the caller keeps
+ * the existing one.
+ */
+export const refreshAccessToken = (
+  { refreshToken, clientId, clientSecret }: RefreshTokenParams,
+  fetchFn: FetchFn,
+): Promise<TokenSet> => {
+  const params = new URLSearchParams();
+  params.set(TOKEN_PARAM.grantType, GRANT_TYPE.refreshToken);
+  params.set(TOKEN_PARAM.refreshToken, refreshToken);
+  params.set(TOKEN_PARAM.clientId, clientId);
+  appendClientSecret(params, clientSecret);
+  return requestTokens(params, 'refresh', fetchFn);
+};
diff --git a/apps/readest-app/src/services/drivesync/DriveBlobStore.ts b/apps/readest-app/src/services/drivesync/DriveBlobStore.ts
new file mode 100644
index 00000000..bc9a4c1d
--- /dev/null
+++ b/apps/readest-app/src/services/drivesync/DriveBlobStore.ts
@@ -0,0 +1,111 @@
+import type { CloudProvider, ProgressHandler } from '../cloudprovider/CloudProvider';
+import { bookBlobPath, coverBlobPath } from './layout';
+
+/**
+ * MIME types for the book formats Readest knows how to store. The cloud file's
+ * content type matters: providers (and any future direct-share links) serve the
+ * blob back with it, so a wrong type can make a download open as plain bytes
+ * instead of an EPUB/PDF. Keyed by the *normalized* (lower-case) extension.
+ *
+ * Typed with a `| undefined` value so an unknown extension is statically known
+ * to miss (this project does not enable `noUncheckedIndexedAccess`), which keeps
+ * the fallback in {@link bookContentType} type-justified rather than dead code.
+ */
+const BOOK_CONTENT_TYPES: Readonly<Record<string, string | undefined>> = {
+  epub: 'application/epub+zip',
+  pdf: 'application/pdf',
+};
+
+/**
+ * Fallback content type for book formats not in {@link BOOK_CONTENT_TYPES} — the
+ * standard "opaque byte stream" type. The blob still round-trips correctly; only
+ * the advertised MIME type is generic.
+ */
+const FALLBACK_BOOK_CONTENT_TYPE = 'application/octet-stream';
+
+/**
+ * Content type for cover blobs. Covers are always PNG (see {@link coverBlobPath}
+ * / layout), so this is a constant rather than a per-call argument.
+ */
+const COVER_CONTENT_TYPE = 'image/png';
+
+/**
+ * Readest's book/cover binary storage API, expressed over a {@link CloudProvider}.
+ *
+ * This is the drop-in replacement for the old server-backed `/api/storage/*`
+ * transfer: it maps a book's content hash + format to a stable logical blob path
+ * and delegates every transfer to the injected provider. Because it depends only
+ * on the {@link CloudProvider} seam it is fully unit-testable against the
+ * in-memory `FakeCloudProvider` with no network. Identity and quota are no longer
+ * its concern — the user's own cloud account is the namespace and enforces quota.
+ */
+export class DriveBlobStore {
+  constructor(private readonly cloud: CloudProvider) {}
+
+  /**
+   * Upload a book body, keyed by its content hash and format extension.
+   *
+   * @param hash - Content hash uniquely identifying the book.
+   * @param ext - Format extension (case-insensitive; normalized internally).
+   * @param bytes - The book body.
+   * @param onProgress - Optional upload-progress callback, forwarded verbatim.
+   */
+  async uploadBook(
+    hash: string,
+    ext: string,
+    bytes: ArrayBuffer,
+    onProgress?: ProgressHandler,
+  ): Promise<void> {
+    const normalizedExt = normalizeExt(ext);
+    await this.cloud.putBinary(
+      bookBlobPath(hash, normalizedExt),
+      bytes,
+      bookContentType(normalizedExt),
+      onProgress,
+    );
+  }
+
+  /**
+   * Download a book body.
+   *
+   * @returns The book body, or `null` when no blob exists for this hash+ext.
+   */
+  async downloadBook(hash: string, ext: string): Promise<ArrayBuffer | null> {
+    return this.cloud.getBinary(bookBlobPath(hash, normalizeExt(ext)));
+  }
+
+  /** Whether a book body exists in the cloud for this hash+ext. */
+  async hasBook(hash: string, ext: string): Promise<boolean> {
+    const entry = await this.cloud.stat(bookBlobPath(hash, normalizeExt(ext)));
+    return entry !== null;
+  }
+
+  /**
+   * Upload a cover image. Always stored as PNG (see layout), so no extension or
+   * content type is taken from the caller.
+   */
+  async uploadCover(hash: string, bytes: ArrayBuffer): Promise<void> {
+    await this.cloud.putBinary(coverBlobPath(hash), bytes, COVER_CONTENT_TYPE);
+  }
+
+  /**
+   * Download a cover image.
+   *
+   * @returns The cover bytes, or `null` when no cover exists for this hash.
+   */
+  async downloadCover(hash: string): Promise<ArrayBuffer | null> {
+    return this.cloud.getBinary(coverBlobPath(hash));
+  }
+}
+
+/**
+ * Normalize a format extension to lower-case. Readest book formats can arrive
+ * upper/mixed case (e.g. `EPUB`); normalizing here — the single place every blob
+ * path is derived from — guarantees upload, download, and existence checks agree
+ * on one path.
+ */
+const normalizeExt = (ext: string): string => ext.toLowerCase();
+
+/** MIME type for a (normalized) book extension, falling back to octet-stream. */
+const bookContentType = (normalizedExt: string): string =>
+  BOOK_CONTENT_TYPES[normalizedExt] ?? FALLBACK_BOOK_CONTENT_TYPE;
