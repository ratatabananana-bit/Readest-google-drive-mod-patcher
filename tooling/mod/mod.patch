diff --git a/apps/readest-app/src/app/library/components/DataSyncWindow.tsx b/apps/readest-app/src/app/library/components/DataSyncWindow.tsx
new file mode 100644
index 00000000..2a5f030b
--- /dev/null
+++ b/apps/readest-app/src/app/library/components/DataSyncWindow.tsx
@@ -0,0 +1,77 @@
+import React, { useEffect, useState } from 'react';
+import { useEnv } from '@/context/EnvContext';
+import { useTranslation } from '@/hooks/useTranslation';
+import { SyncCategoriesSection } from '@/app/user/components/SyncCategoriesSection';
+import Dialog from '@/components/Dialog';
+
+/**
+ * DOM id of the dialog element. Shared by the imperative show/hide helper, the
+ * effect that subscribes to visibility events, and the `Dialog` itself so the
+ * three references cannot drift.
+ */
+const DATA_SYNC_WINDOW_ID = 'data_sync_window';
+
+export const setDataSyncDialogVisible = (visible: boolean) => {
+  const dialog = document.getElementById(DATA_SYNC_WINDOW_ID);
+  if (dialog) {
+    const event = new CustomEvent('setDialogVisibility', {
+      detail: { visible },
+    });
+    dialog.dispatchEvent(event);
+  }
+};
+
+/**
+ * MOD: standalone "Data Sync" dialog for the cloud-sync mod.
+ *
+ * Readest hosts the "what to sync" toggles ({@link SyncCategoriesSection}) inside
+ * the account profile page (`/user?section=sync`), which is gated on a Readest
+ * login and redirects to `/auth` without one. A user syncing through their own
+ * Google Drive has no Readest account, so that route is unreachable for them.
+ *
+ * This dialog gives the same already-self-contained categories UI a home that
+ * needs no Readest session — it reads and writes only the settings store. It
+ * mirrors {@link BackupWindow}'s show/hide mechanism (a `setDialogVisibility`
+ * custom event on the dialog element) so it behaves like every other library
+ * dialog. The account menu opens it for standalone users while logged-in users
+ * keep routing to the stock profile page.
+ */
+export const DataSyncWindow: React.FC = () => {
+  const _ = useTranslation();
+  const { appService } = useEnv();
+  const [isOpen, setIsOpen] = useState(false);
+
+  useEffect(() => {
+    const handleVisibilityEvent = (event: CustomEvent) => {
+      setIsOpen(event.detail.visible);
+    };
+
+    const el = document.getElementById(DATA_SYNC_WINDOW_ID);
+    if (el) {
+      el.addEventListener('setDialogVisibility', handleVisibilityEvent as EventListener);
+    }
+
+    return () => {
+      if (el) {
+        el.removeEventListener('setDialogVisibility', handleVisibilityEvent as EventListener);
+      }
+    };
+  }, []);
+
+  return (
+    <Dialog
+      id={DATA_SYNC_WINDOW_ID}
+      isOpen={isOpen}
+      title={_('Data Sync')}
+      onClose={() => setIsOpen(false)}
+      snapHeight={appService?.isMobile ? 0.6 : undefined}
+      boxClassName='sm:!w-[520px] sm:!max-w-screen-sm sm:h-auto'
+    >
+      {isOpen && (
+        <div className='flex flex-col gap-6 px-6 py-4'>
+          <SyncCategoriesSection />
+        </div>
+      )}
+    </Dialog>
+  );
+};
diff --git a/apps/readest-app/src/app/library/components/RecentShelf.tsx b/apps/readest-app/src/app/library/components/RecentShelf.tsx
new file mode 100644
index 00000000..90b9a3f8
--- /dev/null
+++ b/apps/readest-app/src/app/library/components/RecentShelf.tsx
@@ -0,0 +1,180 @@
+import clsx from 'clsx';
+import { useCallback, useEffect } from 'react';
+import useEmblaCarousel from 'embla-carousel-react';
+import { Menu, type MenuItemOptions } from '@tauri-apps/api/menu';
+import { Book } from '@/types/book';
+import { useEnv } from '@/context/EnvContext';
+import { useSettingsStore } from '@/store/settingsStore';
+import { useTranslation } from '@/hooks/useTranslation';
+import { useLongPress } from '@/hooks/useLongPress';
+import { saveSysSettings } from '@/helpers/settings';
+import { eventDispatcher } from '@/utils/event';
+import BookCover from '@/components/BookCover';
+
+/**
+ * How many recently-read books the top shelf holds. Fixed (no user option) so
+ * the row stays a compact quick-resume strip rather than a second library.
+ */
+export const RECENT_SHELF_BOOK_COUNT = 12;
+
+/** Confirmation toast lifetime when a book is hidden on a touch device (ms). */
+const HIDE_TOAST_TIMEOUT_MS = 2000;
+
+/**
+ * Each cover occupies one main-grid column-width and carries the same per-item
+ * padding, so recent covers render at the same size as the shelf below and
+ * their left edges line up. Mirror of `BOOKSHELF_GRID_CLASSES` column counts +
+ * the grid `BookshelfItem` padding in Bookshelf.tsx — keep the two in sync.
+ */
+const RECENT_SLIDE_CLASSES =
+  'shrink-0 basis-1/3 sm:basis-1/4 md:basis-1/6 xl:basis-[12.5%] 2xl:basis-1/12 ' +
+  'px-0 py-2 sm:px-4 sm:py-4';
+
+interface RecentShelfCoverProps {
+  book: Book;
+  /** Open the book. */
+  onOpen: (book: Book) => void;
+  /** Hide the book from the shelf until it is read again. */
+  onRequestHide: (book: Book) => void;
+}
+
+const RecentShelfCover: React.FC<RecentShelfCoverProps> = ({ book, onOpen, onRequestHide }) => {
+  // A swipe never opens or hides a book: useLongPress cancels its tap/long-press
+  // once the pointer moves past its threshold, which is exactly when Embla takes
+  // over the gesture as a drag (same coexistence the main shelf relies on inside
+  // its scroller). Embla additionally suppresses the post-drag synthetic click.
+  const open = useCallback(() => onOpen(book), [book, onOpen]);
+  const requestHide = useCallback(() => onRequestHide(book), [book, onRequestHide]);
+
+  const { handlers } = useLongPress(
+    {
+      onTap: open,
+      onLongPress: requestHide,
+      onContextMenu: requestHide,
+    },
+    [open, requestHide],
+  );
+
+  const handleKeyDown = (e: React.KeyboardEvent) => {
+    if (e.key === 'Enter' || e.key === ' ') {
+      e.preventDefault();
+      onOpen(book);
+    }
+    if (e.key === 'ContextMenu' || (e.shiftKey && e.key === 'F10')) {
+      e.preventDefault();
+      onRequestHide(book);
+    }
+  };
+
+  return (
+    <div
+      className={clsx(
+        'recent-shelf-cover min-w-0 cursor-pointer select-none',
+        RECENT_SLIDE_CLASSES,
+      )}
+      role='button'
+      tabIndex={0}
+      aria-label={book.title}
+      onKeyDown={handleKeyDown}
+      {...handlers}
+    >
+      <div className='aspect-[28/41] overflow-hidden rounded'>
+        <BookCover book={book} mode='grid' coverFit='crop' imageClassName='rounded shadow-md' />
+      </div>
+      <h4 className='block overflow-hidden text-ellipsis whitespace-nowrap pt-2 text-[0.6em] text-xs font-semibold'>
+        {book.title}
+      </h4>
+    </div>
+  );
+};
+
+interface RecentShelfProps {
+  books: Book[];
+  onOpenBook: (book: Book) => void;
+}
+
+/**
+ * Recently-read shelf rendered in the bookshelf's scrollable header: a flat,
+ * recency-ordered row of covers, independent of the main shelf's sort/grouping.
+ * Drag-to-scroll with snap-to-alignment + edge rubber-band via Embla, so the
+ * row never rests on a half-cut cover. Tap opens a book; press-and-hold hides
+ * it until it is read again (see `libraryRecentShelfHiddenAt`).
+ */
+const RecentShelf: React.FC<RecentShelfProps> = ({ books, onOpenBook }) => {
+  const _ = useTranslation();
+  const { envConfig, appService } = useEnv();
+  const { settings } = useSettingsStore();
+  const [emblaRef, emblaApi] = useEmblaCarousel({
+    align: 'start',
+    containScroll: 'trimSnaps',
+    dragFree: false,
+  });
+
+  // Embla measures slides on init; the set of covers changes as books are read
+  // or hidden, so re-measure to keep snap points and bounds correct.
+  useEffect(() => {
+    emblaApi?.reInit();
+  }, [emblaApi, books]);
+
+  const hideBook = useCallback(
+    async (book: Book) => {
+      const hiddenAt = {
+        ...settings.libraryRecentShelfHiddenAt,
+        [book.hash]: Date.now(),
+      };
+      await saveSysSettings(envConfig, 'libraryRecentShelfHiddenAt', hiddenAt);
+    },
+    [envConfig, settings.libraryRecentShelfHiddenAt],
+  );
+
+  const requestHide = useCallback(
+    async (book: Book) => {
+      // Desktop has a native context menu, so offer the action explicitly.
+      // Touch platforms have no context menu (see BookshelfItem) — hide
+      // immediately and confirm with a toast that explains how it comes back.
+      if (appService?.hasContextMenu) {
+        const items: MenuItemOptions[] = [
+          {
+            text: _('Hide from recent'),
+            action: async () => {
+              await hideBook(book);
+            },
+          },
+        ];
+        const menu = await Menu.new({ items });
+        await menu.popup();
+        return;
+      }
+      await hideBook(book);
+      eventDispatcher.dispatch('toast', {
+        type: 'info',
+        message: _('Hidden until you open it again'),
+        timeout: HIDE_TOAST_TIMEOUT_MS,
+      });
+    },
+    [appService, _, hideBook],
+  );
+
+  return (
+    <div className='recent-shelf select-none pt-3'>
+      <h3 className='text-base-content/60 mb-1 ps-4 text-xs font-medium sm:ps-6'>
+        {_('Recently read')}
+      </h3>
+      <div className='overflow-hidden px-4 sm:px-2' ref={emblaRef}>
+        <div className='flex gap-x-4 sm:gap-x-0'>
+          {books.map((book) => (
+            <RecentShelfCover
+              key={book.hash}
+              book={book}
+              onOpen={onOpenBook}
+              onRequestHide={requestHide}
+            />
+          ))}
+        </div>
+      </div>
+      <hr aria-hidden='true' className='border-base-300 mt-3' />
+    </div>
+  );
+};
+
+export default RecentShelf;
