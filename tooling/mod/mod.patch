+++ b/apps/readest-app/src/__tests__/cloudprovider/fakeCloudProvider.test.ts
@@ -0,0 +1,138 @@
+import { describe, it, expect } from 'vitest';
+import { FakeCloudProvider } from '@/services/cloudprovider/FakeCloudProvider';
+
+describe('FakeCloudProvider', () => {
+  it('writes then reads a binary by path', async () => {
+    const p = new FakeCloudProvider();
+    const bytes = new TextEncoder().encode('hello').buffer;
+    await p.putBinary('Readest/blobs/books/abc.epub', bytes, 'application/epub+zip');
+    const got = await p.getBinary('Readest/blobs/books/abc.epub');
+    expect(got && new TextDecoder().decode(got)).toBe('hello');
+  });
+
+  it('returns null for a missing path', async () => {
+    const p = new FakeCloudProvider();
+    expect(await p.getBinary('Readest/nope')).toBeNull();
+  });
+
+  it('lists immediate child subfolders under a prefix and deletes', async () => {
+    const p = new FakeCloudProvider();
+    await p.putText('Readest/sync/devA/books.jsonl', '{}');
+    await p.putText('Readest/sync/devB/books.jsonl', '{}');
+    // `list` returns IMMEDIATE children only: the deeper `books.jsonl` files make
+    // `devA`/`devB` the direct subfolders of `Readest/sync`, so each surfaces as a
+    // single folder entry (no transitive descendants leak through).
+    const entries = await p.list('Readest/sync');
+    expect(entries.map((e) => e.path).sort()).toEqual(['Readest/sync/devA', 'Readest/sync/devB']);
+    expect(entries.every((e) => e.isFolder)).toBe(true);
+    await p.deleteFile('Readest/sync/devA/books.jsonl');
+    expect(await p.getText('Readest/sync/devA/books.jsonl')).toBeNull();
+  });
+
+  it('lists an immediate file child as a non-folder entry', async () => {
+    const p = new FakeCloudProvider();
+    await p.putText('Readest/sync/devA/books.jsonl', '{}');
+    const entries = await p.list('Readest/sync/devA');
+    expect(entries).toHaveLength(1);
+    expect(entries[0]?.path).toBe('Readest/sync/devA/books.jsonl');
+    expect(entries[0]?.name).toBe('books.jsonl');
+    expect(entries[0]?.isFolder).toBe(false);
+  });
+
+  it('lists a mix of an immediate file and an immediate subfolder', async () => {
+    const p = new FakeCloudProvider();
+    await p.putText('Readest/x/a.txt', 'direct');
+    await p.putText('Readest/x/sub/b.txt', 'deeper');
+    const entries = await p.list('Readest/x');
+    const byName = new Map(entries.map((e) => [e.name, e]));
+
+    const file = byName.get('a.txt');
+    expect(file?.path).toBe('Readest/x/a.txt');
+    expect(file?.isFolder).toBe(false);
+
+    const sub = byName.get('sub');
+    expect(sub?.path).toBe('Readest/x/sub');
+    expect(sub?.isFolder).toBe(true);
+    // A folder is synthesized from flat keys, so it carries no body metadata.
+    expect(sub?.size).toBeUndefined();
+    expect(sub?.md5).toBeUndefined();
+
+    expect(entries).toHaveLength(2);
+  });
+
+  it('round-trips text via the binary methods (UTF-8)', async () => {
+    const p = new FakeCloudProvider();
+    const body = 'café — 日本語 — 🚀';
+    await p.putText('Readest/sync/devA/notes.txt', body);
+    expect(await p.getText('Readest/sync/devA/notes.txt')).toBe(body);
+  });
+
+  it('returns null from getText for a missing path', async () => {
+    const p = new FakeCloudProvider();
+    expect(await p.getText('Readest/sync/missing.jsonl')).toBeNull();
+  });
+
+  it('overwrites the body and content type on a repeated put', async () => {
+    const p = new FakeCloudProvider();
+    await p.putText('Readest/sync/devA/books.jsonl', 'first');
+    await p.putText('Readest/sync/devA/books.jsonl', 'second');
+    expect(await p.getText('Readest/sync/devA/books.jsonl')).toBe('second');
+  });
+
+  it('reports stat metadata for a stored file and null when absent', async () => {
+    const p = new FakeCloudProvider();
+    const payload = 'hello';
+    await p.putBinary(
+      'Readest/blobs/books/abc.epub',
+      new TextEncoder().encode(payload).buffer,
+      'application/epub+zip',
+    );
+
+    const entry = await p.stat('Readest/blobs/books/abc.epub');
+    expect(entry).not.toBeNull();
+    expect(entry?.path).toBe('Readest/blobs/books/abc.epub');
+    expect(entry?.name).toBe('abc.epub');
+    expect(entry?.isFolder).toBe(false);
+    expect(entry?.size).toBe(payload.length);
+
+    expect(await p.stat('Readest/blobs/books/missing.epub')).toBeNull();
+  });
+
+  it('lists immediate children but excludes prefix-string false matches', async () => {
+    const p = new FakeCloudProvider();
+    await p.putText('Readest/sync/devA/books.jsonl', '{}');
+    // Shares the literal prefix "Readest/sync" but is NOT under the folder.
+    await p.putText('Readest/synced.txt', 'sibling');
+
+    // Only `devA` (the immediate subfolder) surfaces; the sibling is excluded.
+    const entries = await p.list('Readest/sync');
+    expect(entries.map((e) => e.path)).toEqual(['Readest/sync/devA']);
+    expect(entries[0]?.isFolder).toBe(true);
+  });
+
+  it('returns an empty list for an absent folder', async () => {
+    const p = new FakeCloudProvider();
+    expect(await p.list('Readest/does/not/exist')).toEqual([]);
+  });
+
+  it('reports an empty in-memory account as authenticated with a label', async () => {
+    const p = new FakeCloudProvider();
+    expect(await p.isAuthenticated()).toBe(true);
+    expect(await p.accountLabel()).not.toBeNull();
+  });
+
+  it('invokes onProgress once with sent equal to total for a binary put', async () => {
+    const p = new FakeCloudProvider();
+    const bytes = new TextEncoder().encode('hello').buffer;
+    const calls: Array<[number, number]> = [];
+
+    await p.putBinary(
+      'Readest/blobs/books/abc.epub',
+      bytes,
+      'application/epub+zip',
+      (sent, total) => calls.push([sent, total]),
+    );
+
+    expect(calls).toEqual([[bytes.byteLength, bytes.byteLength]]);
+  });
+});
diff --git a/apps/readest-app/src/__tests__/cloudprovider/oauthAndroid.test.ts b/apps/readest-app/src/__tests__/cloudprovider/oauthAndroid.test.ts
new file mode 100644
