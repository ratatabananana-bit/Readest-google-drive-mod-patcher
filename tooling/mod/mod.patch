diff --git a/apps/readest-app/src/components/settings/integrations/CloudSyncForm.tsx b/apps/readest-app/src/components/settings/integrations/CloudSyncForm.tsx
new file mode 100644
index 00000000..bc1e1022
--- /dev/null
+++ b/apps/readest-app/src/components/settings/integrations/CloudSyncForm.tsx
@@ -0,0 +1,224 @@
+import clsx from 'clsx';
+import React, { useState } from 'react';
+import { RiGoogleLine } from 'react-icons/ri';
+import { useEnv } from '@/context/EnvContext';
+import { useTranslation } from '@/hooks/useTranslation';
+import { useSettingsStore } from '@/store/settingsStore';
+import { eventDispatcher } from '@/utils/event';
+import {
+  connectGoogleDrive,
+  disconnectGoogleDrive,
+} from '@/services/drivesync/cloudSyncController';
+import { getSettingsTokenPersistence } from '@/services/drivesync/settingsTokenPersistence';
+import { readCloudAccount } from '@/services/drivesync/cloudAccount';
+import {
+  ANDROID_PLATFORM_NAME,
+  readDriveAuthConfig,
+  selectRunOAuth,
+  toOAuthClientConfig,
+} from '@/services/drivesync/cloudSyncEnvConfig';
+// Shared WebView fetch for all Google (OAuth + Drive) calls. NOT
+// @tauri-apps/plugin-http (reqwest), which fails with os error 10061 on some
+// Windows setups; the WebView fetch reaches Google and CORS is permitted. See
+// services/drivesync/driveFetch.ts for the full rationale.
+import { driveFetch } from '@/services/drivesync/driveFetch';
+import SubPageHeader from '../SubPageHeader';
+import { BoxedList, SettingsRow } from '../primitives';
+
+interface CloudSyncFormProps {
+  onBack: () => void;
+}
+
+/**
+ * Google Drive cloud-sync integration form. Two mutually-exclusive states share
+ * the panel, mirroring {@link WebDAVForm}:
+ *
+ * - Connected: shows the account label and a Disconnect button.
+ * - Not connected: shows a Connect button (or, when the build has no Google
+ *   client configured, an explanatory disabled state).
+ *
+ * All orchestration — running OAuth, persisting tokens, activating the provider —
+ * lives in the already-tested {@link connectGoogleDrive} / {@link
+ * disconnectGoogleDrive} controller. This component is the thin presentational
+ * layer that supplies the platform-specific deps (persistence, env config,
+ * platform OAuth flow, `fetch`) and reflects the result in the UI.
+ */
+const CloudSyncForm: React.FC<CloudSyncFormProps> = ({ onBack }) => {
+  const _ = useTranslation();
+  const { envConfig, appService } = useEnv();
+  const { settings } = useSettingsStore();
+
+  // Which platform's OAuth client this build uses. Android authenticates against
+  // its own iOS-type client via a reverse-DNS deep link; every other platform
+  // uses the desktop loopback client. Derived from `appService` (Readest's OS
+  // detection) rather than `platform()` so it is safe to read during render.
+  const platformName = appService?.isAndroidApp ? ANDROID_PLATFORM_NAME : 'desktop';
+
+  // Connected iff a token set is persisted. Derived from settings via the shared
+  // `readCloudAccount` (one source of truth for "Drive connected", reused by the
+  // account menu) so the state survives navigation, and re-derived after
+  // connect/disconnect by reading the store — the controller writes through
+  // `settingsTokenPersistence`, which updates the same store. See `refreshConnected`.
+  const initialAccount = readCloudAccount(settings);
+  const [isConnected, setIsConnected] = useState(initialAccount.connected);
+  const [accountLabel, setAccountLabel] = useState<string | null>(initialAccount.label);
+  const [isBusy, setIsBusy] = useState(false);
+
+  // Resolve the build's OAuth client once per render. `null` means the build was
+  // shipped without Google credentials, which disables Connect and shows a clear
+  // "not configured" message rather than letting the user start a flow that
+  // cannot complete.
+  const authConfig = readDriveAuthConfig();
+  const isConfigured = authConfig !== null;
+
+  /**
+   * Re-derive connected state from the store after the controller has run. The
+   * controller persists tokens (or clears them) through the settings store, so
+   * reading `getState()` here reflects the committed result without threading
+   * the controller's return value through extra state.
+   */
+  const refreshConnected = () => {
+    const next = readCloudAccount(useSettingsStore.getState().settings);
+    setIsConnected(next.connected);
+    setAccountLabel(next.label);
+  };
+
+  const handleConnect = async () => {
+    // Guard mirrors the disabled button; defends against a programmatic call
+    // when the build is unconfigured (authConfig === null).
+    if (!authConfig || isBusy) return;
+    setIsBusy(true);
+    try {
+      const persistence = getSettingsTokenPersistence(envConfig);
+      const runOAuth = selectRunOAuth(platformName);
+      // The controller refreshes tokens (no scope needed) so it takes the bare
+      // auth config; the interactive consent additionally needs the scope, hence
+      // `toOAuthClientConfig` only on the `runOAuth` call.
+      const result = await connectGoogleDrive({
+        runOAuth: () => runOAuth(toOAuthClientConfig(authConfig), driveFetch),
+        persistence,
+        config: authConfig,
+        fetchFn: driveFetch,
+      });
+      // Prefer the controller's resolved label; fall back to whatever the store
+      // now holds so the UI never shows a stale "not connected" after success.
+      setAccountLabel(result.accountLabel);
+      refreshConnected();
+      eventDispatcher.dispatch('toast', { type: 'info', message: _('Connected') });
+    } catch (e) {
+      // OAuth cancellation/denial and network failures all surface here; show a
+      // generic failure rather than leaking the raw English error to the user.
+      console.warn('Cloud sync: connect failed', e);
+      eventDispatcher.dispatch('toast', {
+        type: 'error',
+        message: _('Failed to connect to Google Drive'),
+      });
+    } finally {
+      setIsBusy(false);
+    }
+  };
+
+  const handleDisconnect = async () => {
+    if (isBusy) return;
+    setIsBusy(true);
+    try {
+      const persistence = getSettingsTokenPersistence(envConfig);
+      await disconnectGoogleDrive({
+        persistence,
+        // `config`/`fetchFn` are unused by disconnect (it only clears the store
+        // and deactivates the provider), but the deps shape requires them; pass
+        // the real ones for type-completeness. `runOAuth` is never invoked on
+        // this path, so a throwing stub documents that it must not be called.
+        config: authConfig ?? { clientId: '' },
+        fetchFn: driveFetch,
+        runOAuth: () => Promise.reject(new Error('runOAuth must not be called on disconnect')),
+      });
+      refreshConnected();
+      eventDispatcher.dispatch('toast', { type: 'info', message: _('Disconnected') });
+    } catch (e) {
+      console.warn('Cloud sync: disconnect failed', e);
+      eventDispatcher.dispatch('toast', {
+        type: 'error',
+        message: _('Failed to disconnect'),
+      });
+    } finally {
+      setIsBusy(false);
+    }
+  };
+
+  const description = isConnected
+    ? _('Your reading data syncs to your private Google Drive app folder.')
+    : _('Connect a Google account to sync your reading data via Google Drive.');
+
+  return (
+    <div className='w-full'>
+      <SubPageHeader
+        parentLabel={_('Integrations')}
+        currentLabel={_('Cloud Sync')}
+        description={description}
+        onBack={onBack}
+      />
+
+      {isConnected ? (
+        <div className='space-y-5'>
+          <BoxedList>
+            <SettingsRow
+              label={accountLabel ?? _('Connected')}
+              description={_('Signed in to Google Drive')}
+            >
+              <button
+                type='button'
+                onClick={handleDisconnect}
+                disabled={isBusy}
+                className={clsx(
