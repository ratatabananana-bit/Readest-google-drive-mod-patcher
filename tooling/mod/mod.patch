@@ -0,0 +1,469 @@
+import { describe, it, expect } from 'vitest';
+import {
+  listQuery,
+  mediaDownloadUrl,
+  simpleUploadUrl,
+  FOLDER_MIME,
+} from '@/services/cloudprovider/googleAuth/driveRest';
+import {
+  GoogleDriveProvider,
+  type DriveAuth,
+  type FetchFn,
+} from '@/services/cloudprovider/GoogleDriveProvider';
+
+describe('driveRest builders', () => {
+  it('escapes single quotes in a name query', () => {
+    const q = listQuery("O'Brien", 'PARENT_ID');
+    expect(q).toContain("name = 'O\\'Brien'");
+    expect(q).toContain("'PARENT_ID' in parents");
+    expect(q).toContain('trashed = false');
+  });
+  it('builds a media download url', () => {
+    expect(mediaDownloadUrl('FILE1')).toBe(
+      'https://www.googleapis.com/drive/v3/files/FILE1?alt=media',
+    );
+  });
+  it('builds a simple-upload url', () => {
+    expect(simpleUploadUrl()).toBe(
+      'https://www.googleapis.com/upload/drive/v3/files?uploadType=media&fields=id,md5Checksum,size',
+    );
+  });
+});
+
+const mockAuth: DriveAuth = {
+  getAccessToken: async () => 'AT',
+  accountLabel: async () => 'me@x.com',
+};
+
+/** A single recorded fetch call: method + url + parsed-where-useful init. */
+interface RecordedCall {
+  method: string;
+  url: string;
+  init?: RequestInit;
+}
+
+/** Drive JSON metadata as the mock returns it for a single file/folder. */
+interface MockFile {
+  id: string;
+  name?: string;
+  mimeType?: string;
+  size?: string;
+  modifiedTime?: string;
+  md5Checksum?: string;
+}
+
+const okJson = (body: unknown): Response =>
+  ({ ok: true, status: 200, json: async () => body }) as Response;
+const okText = (body: string): Response =>
+  ({ ok: true, status: 200, text: async () => body }) as Response;
+const okBinary = (body: ArrayBuffer): Response =>
+  ({ ok: true, status: 200, arrayBuffer: async () => body }) as Response;
+const status = (code: number): Response =>
+  ({ ok: code >= 200 && code < 300, status: code, json: async () => ({}) }) as Response;
+
+/**
+ * Build a routing mock fetch over an in-memory tree of named children keyed by
+ * `${parentId}/${name}`. It answers list/resolve, download, upload, metadata,
+ * and delete the way Drive v3 does, and records every call for assertions.
+ */
+const makeFetch = (tree: Map<string, MockFile>, bodies: Map<string, string> = new Map()) => {
+  const calls: RecordedCall[] = [];
+  let nextId = 1;
+
+  const fetchFn: FetchFn = async (url, init) => {
+    const method = init?.method ?? 'GET';
+    calls.push({ method, url, init });
+
+    // files.list — resolve a child by name, or enumerate children.
+    if (url.includes('q=')) {
+      const q = new URL(url).searchParams.get('q') ?? '';
+      const nameMatch = q.match(/name = '(.*?)' and '(.*?)' in parents/);
+      if (nameMatch) {
+        const [, rawName, parentId] = nameMatch;
+        const name = rawName!.replace(/\\'/g, "'");
+        const hit = tree.get(`${parentId}/${name}`);
+        return okJson({ files: hit ? [hit] : [] });
+      }
+      const childrenMatch = q.match(/'(.*?)' in parents/);
+      const parentId = childrenMatch?.[1] ?? '';
+      const files: MockFile[] = [];
+      for (const [key, file] of tree) {
+        if (key.startsWith(`${parentId}/`)) files.push(file);
+      }
+      return okJson({ files });
+    }
+
+    // Media download.
+    if (url.includes('alt=media')) {
+      const id = url.split('/files/')[1]!.split('?')[0]!;
+      const body = bodies.get(id);
+      return body === undefined ? status(404) : okText(body);
+    }
+
+    // Media upload: POST (create) or PATCH (overwrite) on the /upload/ path.
+    if (url.includes('uploadType=media')) {
+      if (method === 'POST') {
+        const id = `NEW${nextId++}`;
+        return okJson({ id, md5Checksum: 'm', size: '3' });
+      }
+      const id = url.split('/files/')[1]!.split('?')[0]!;
+      return okJson({ id, md5Checksum: 'm', size: '3' });
+    }
+
+    // Metadata PATCH (set name + addParents) on the metadata endpoint.
+    if (method === 'PATCH') {
+      const id = url.split('/files/')[1]!.split('?')[0]!;
+      const patch = JSON.parse(init!.body as string) as { name?: string };
+      const parentId = new URL(url).searchParams.get('addParents');
+      if (patch.name && parentId) tree.set(`${parentId}/${patch.name}`, { id, name: patch.name });
+      return okJson({ id });
+    }
+
+    // Folder create (POST JSON to the metadata endpoint, no upload path).
+    if (method === 'POST') {
+      const meta = JSON.parse(init!.body as string) as {
+        name: string;
+        mimeType: string;
+        parents?: string[];
+      };
+      const id = `FOLDER${nextId++}`;
+      const parentId = meta.parents?.[0] ?? 'root';
+      tree.set(`${parentId}/${meta.name}`, { id, name: meta.name, mimeType: meta.mimeType });
+      return okJson({ id });
+    }
+
+    // Single-file metadata get (stat): fields= but not a list and not media.
+    if (url.includes('fields=')) {
+      const id = url.split('/files/')[1]!.split('?')[0]!;
+      for (const file of tree.values()) {
+        if (file.id === id) return okJson(file);
+      }
+      return status(404);
+    }
+
+    // Delete.
+    if (method === 'DELETE') {
+      const id = url.split('/files/')[1]!.split('?')[0]!;
+      for (const [key, file] of tree) {
+        if (file.id === id) tree.delete(key);
+      }
+      return status(204);
+    }
+
+    throw new Error(`unexpected request: ${method} ${url}`);
+  };
+
+  return { fetchFn, calls };
+};
