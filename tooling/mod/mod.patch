+describe('GoogleDriveProvider.putText create flow', () => {
+  it('creates folders, uploads bytes, then names + parents the new file', async () => {
+    const tree = new Map<string, MockFile>();
+    const { fetchFn, calls } = makeFetch(tree);
+    const p = new GoogleDriveProvider(mockAuth, fetchFn);
+    await p.putText('Readest/keys/replica.json', '{}');
+
+    // Two folders auto-created (Readest, keys) via JSON POST to the metadata endpoint.
+    const folderCreates = calls.filter((c) => c.method === 'POST' && !c.url.includes('uploadType'));
+    expect(folderCreates.length).toBe(2);
+
+    // Bytes uploaded via a media POST...
+    expect(calls.some((c) => c.method === 'POST' && c.url.includes('uploadType=media'))).toBe(true);
+    // ...then a metadata PATCH set the name and reparented it into `keys`.
+    const patch = calls.find((c) => c.method === 'PATCH');
+    expect(patch).toBeDefined();
+    expect(patch!.url).toContain('addParents=');
+    const patchBody = JSON.parse(patch!.init!.body as string) as { name: string };
+    expect(patchBody.name).toBe('replica.json');
+  });
+
+  it('overwrites an existing file with a media PATCH (no new create)', async () => {
+    const tree = new Map<string, MockFile>([
+      ['root/Readest', { id: 'F1', mimeType: FOLDER_MIME }],
+      ['F1/replica.json', { id: 'EXIST' }],
+    ]);
+    const { fetchFn, calls } = makeFetch(tree);
+    const p = new GoogleDriveProvider(mockAuth, fetchFn);
+    await p.putText('Readest/replica.json', '{}');
+
+    // Existing id is updated in place via a media PATCH; no media POST create.
+    expect(calls.some((c) => c.method === 'POST' && c.url.includes('uploadType=media'))).toBe(
+      false,
+    );
+    const update = calls.find((c) => c.method === 'PATCH' && c.url.includes('uploadType=media'));
+    expect(update).toBeDefined();
+    expect(update!.url).toContain('/files/EXIST');
+  });
+});
+
+describe('GoogleDriveProvider.putBinary', () => {
+  it('reports completion through onProgress', async () => {
+    const tree = new Map<string, MockFile>();
+    const { fetchFn } = makeFetch(tree);
+    const p = new GoogleDriveProvider(mockAuth, fetchFn);
+    const body = new TextEncoder().encode('abc').buffer;
+    const seen: Array<[number, number]> = [];
+    await p.putBinary('Readest/x.bin', body, 'application/octet-stream', (sent, total) =>
+      seen.push([sent, total]),
+    );
+    expect(seen.at(-1)).toEqual([body.byteLength, body.byteLength]);
+  });
+});
+
+describe('GoogleDriveProvider id cache', () => {
+  it('avoids re-resolving the same folder twice', async () => {
+    const tree = new Map<string, MockFile>([
+      ['root/Readest', { id: 'F1', mimeType: FOLDER_MIME }],
+      ['F1/a.json', { id: 'A' }],
+      ['F1/b.json', { id: 'B' }],
+    ]);
+    const bodies = new Map([
+      ['A', 'AA'],
+      ['B', 'BB'],
+    ]);
+    const { fetchFn, calls } = makeFetch(tree, bodies);
+    const p = new GoogleDriveProvider(mockAuth, fetchFn);
+
+    await p.getText('Readest/a.json');
+    await p.getText('Readest/b.json');
+
+    // The `Readest` folder is resolved by a name-list query; with the cache it
+    // should be looked up exactly once across both reads. Parse the `q` param so
+    // the assertion is independent of how spaces are URL-encoded.
+    const folderResolves = calls.filter((c) => {
+      if (!c.url.includes('q=')) return false;
+      const q = new URL(c.url).searchParams.get('q') ?? '';
+      return q.includes("name = 'Readest'");
+    });
+    expect(folderResolves.length).toBe(1);
+  });
+});
diff --git a/apps/readest-app/src/__tests__/cloudprovider/fakeCloudProvider.test.ts b/apps/readest-app/src/__tests__/cloudprovider/fakeCloudProvider.test.ts
