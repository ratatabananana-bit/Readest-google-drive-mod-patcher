+import React, { useEffect, useState } from 'react';
+import { useEnv } from '@/context/EnvContext';
+import { useTranslation } from '@/hooks/useTranslation';
+import { SyncCategoriesSection } from '@/app/user/components/SyncCategoriesSection';
+import Dialog from '@/components/Dialog';
+
+/**
+ * DOM id of the dialog element. Shared by the imperative show/hide helper, the
+ * effect that subscribes to visibility events, and the `Dialog` itself so the
+ * three references cannot drift.
+ */
+const DATA_SYNC_WINDOW_ID = 'data_sync_window';
+
+export const setDataSyncDialogVisible = (visible: boolean) => {
+  const dialog = document.getElementById(DATA_SYNC_WINDOW_ID);
+  if (dialog) {
+    const event = new CustomEvent('setDialogVisibility', {
+      detail: { visible },
+    });
+    dialog.dispatchEvent(event);
+  }
+};
+
+/**
+ * MOD: standalone "Data Sync" dialog for the cloud-sync mod.
+ *
+ * Readest hosts the "what to sync" toggles ({@link SyncCategoriesSection}) inside
+ * the account profile page (`/user?section=sync`), which is gated on a Readest
+ * login and redirects to `/auth` without one. A user syncing through their own
+ * Google Drive has no Readest account, so that route is unreachable for them.
+ *
+ * This dialog gives the same already-self-contained categories UI a home that
+ * needs no Readest session — it reads and writes only the settings store. It
+ * mirrors {@link BackupWindow}'s show/hide mechanism (a `setDialogVisibility`
+ * custom event on the dialog element) so it behaves like every other library
+ * dialog. The account menu opens it for standalone users while logged-in users
+ * keep routing to the stock profile page.
+ */
+export const DataSyncWindow: React.FC = () => {
+  const _ = useTranslation();
+  const { appService } = useEnv();
+  const [isOpen, setIsOpen] = useState(false);
+
+  useEffect(() => {
+    const handleVisibilityEvent = (event: CustomEvent) => {
+      setIsOpen(event.detail.visible);
+    };
+
+    const el = document.getElementById(DATA_SYNC_WINDOW_ID);
+    if (el) {
+      el.addEventListener('setDialogVisibility', handleVisibilityEvent as EventListener);
+    }
+
+    return () => {
+      if (el) {
+        el.removeEventListener('setDialogVisibility', handleVisibilityEvent as EventListener);
+      }
+    };
+  }, []);
+
+  return (
+    <Dialog
+      id={DATA_SYNC_WINDOW_ID}
+      isOpen={isOpen}
+      title={_('Data Sync')}
+      onClose={() => setIsOpen(false)}
+      snapHeight={appService?.isMobile ? 0.6 : undefined}
+      boxClassName='sm:!w-[520px] sm:!max-w-screen-sm sm:h-auto'
+    >
+      {isOpen && (
+        <div className='flex flex-col gap-6 px-6 py-4'>
+          <SyncCategoriesSection />
+        </div>
+      )}
+    </Dialog>
+  );
+};
