--- /dev/null
+++ b/apps/readest-app/src/__tests__/cloudprovider/oauthAndroid.test.ts
@@ -0,0 +1,71 @@
+import { describe, it, expect, vi } from 'vitest';
+import { deriveReverseDnsRedirectUri } from '@/services/cloudprovider/googleAuth/reverseDnsRedirect';
+import { runAndroidOAuth } from '@/services/cloudprovider/googleAuth/oauthAndroid';
+import { authWithCustomTab } from '@/app/auth/utils/nativeAuth';
+
+// runAndroidOAuth drives Readest's native Custom-Tab bridge; mock it so the flow
+// runs headlessly (vi.mock is hoisted above the import above). Each test sets the
+// implementation it needs.
+vi.mock('@/app/auth/utils/nativeAuth', () => ({ authWithCustomTab: vi.fn() }));
+
+/**
+ * The derived redirect URI must match, byte-for-byte, both the value registered
+ * on Google's iOS-type client and the deep-link intent-filter scheme the app
+ * registers — so these cases pin the exact shape (reverse-DNS, single slash,
+ * lowercase).
+ */
+describe('deriveReverseDnsRedirectUri', () => {
+  it('builds the reverse-DNS redirect from a full Google client id', () => {
+    expect(deriveReverseDnsRedirectUri('433627266031-abc123.apps.googleusercontent.com')).toBe(
+      'com.googleusercontent.apps.433627266031-abc123:/oauthredirect',
+    );
+  });
+
+  it('lower-cases the scheme (Android intent-scheme matching is case-sensitive)', () => {
+    expect(deriveReverseDnsRedirectUri('123-AbC.apps.googleusercontent.com')).toBe(
+      'com.googleusercontent.apps.123-abc:/oauthredirect',
+    );
+  });
+
+  it('uses a single slash after the colon, not "://"', () => {
+    const uri = deriveReverseDnsRedirectUri('123-abc.apps.googleusercontent.com');
+    expect(uri).toContain(':/oauthredirect');
+    expect(uri).not.toContain('://');
+  });
+
+  it('tolerates an id already stripped of the .apps.googleusercontent.com suffix', () => {
+    expect(deriveReverseDnsRedirectUri('123-abc')).toBe(
+      'com.googleusercontent.apps.123-abc:/oauthredirect',
+    );
+  });
+});
+
+describe('runAndroidOAuth', () => {
+  const ANDROID_CLIENT = '123-abc.apps.googleusercontent.com';
+  const SCOPE = 'https://www.googleapis.com/auth/drive.file';
+
+  it('opens the Custom Tab with an auth URL whose redirect_uri is the derived scheme', async () => {
+    // Reject right after the tab opens so we only assert the request it was handed.
+    vi.mocked(authWithCustomTab).mockRejectedValue(new Error('stop after the tab opens'));
+    const fetchFn = vi.fn();
+
+    await runAndroidOAuth({ clientId: ANDROID_CLIENT, scope: SCOPE }, fetchFn).catch(
+      () => undefined,
+    );
+
+    const authUrl = vi.mocked(authWithCustomTab).mock.calls[0]![0].authUrl;
+    expect(new URL(authUrl).searchParams.get('redirect_uri')).toBe(
+      deriveReverseDnsRedirectUri(ANDROID_CLIENT),
+    );
+  });
+
+  it('rejects without exchanging a token when the sign-in is cancelled', async () => {
+    vi.mocked(authWithCustomTab).mockRejectedValue(new Error('Sign-in was cancelled'));
+    const fetchFn = vi.fn();
+
+    await expect(
+      runAndroidOAuth({ clientId: ANDROID_CLIENT, scope: SCOPE }, fetchFn),
+    ).rejects.toThrow();
+    expect(fetchFn).not.toHaveBeenCalled();
+  });
+});
diff --git a/apps/readest-app/src/__tests__/cloudprovider/oauthDesktopDeepLink.test.ts b/apps/readest-app/src/__tests__/cloudprovider/oauthDesktopDeepLink.test.ts
new file mode 100644
index 00000000..87618d2f
--- /dev/null
+++ b/apps/readest-app/src/__tests__/cloudprovider/oauthDesktopDeepLink.test.ts
@@ -0,0 +1,199 @@
+import { describe, it, expect, vi } from 'vitest';
+import {
+  deriveReverseDnsRedirectScheme,
+  deriveReverseDnsRedirectUri,
+  matchesReverseDnsRedirect,
+} from '@/services/cloudprovider/googleAuth/reverseDnsRedirect';
+import {
+  runDesktopDeepLinkOAuth,
+  DEFAULT_FALLBACK_DELAY_MS,
+  type DesktopDeepLinkDeps,
+} from '@/services/cloudprovider/googleAuth/oauthDesktopDeepLink';
+import type { FetchFn } from '@/services/cloudprovider/googleAuth/tokenStore';
+
+const DESKTOP_CLIENT = '123-abc.apps.googleusercontent.com';
+const SCOPE = 'https://www.googleapis.com/auth/drive.file';
+const REDIRECT_URI = deriveReverseDnsRedirectUri(DESKTOP_CLIENT);
+/** A deadline far past any test's simulated time, so only the case testing it trips it. */
+const FAR_DEADLINE_MS = 60 * 60_000;
+
+/** A token endpoint that always succeeds, so a captured code completes the flow. */
+const okFetch: FetchFn = async () =>
+  ({
+    ok: true,
+    json: async () => ({ access_token: 'AT', refresh_token: 'RT', expires_in: 3600 }),
+  }) as unknown as Response;
+
+/** Drain several macrotasks so the flow's async chain (PKCE digest, openUrl) settles. */
+const flush = async () => {
+  for (let i = 0; i < 10; i++) await new Promise<void>((resolve) => setTimeout(resolve, 0));
+};
+
+/**
+ * Build fake desktop deps that record what the runner did and let the test push
+ * redirect URLs in, standing in for the real Tauri single-instance/deep-link
+ * capture and browser launches — so the orchestration is exercised headlessly.
+ */
+function makeHarness(
+  fallbackDelayMs = DEFAULT_FALLBACK_DELAY_MS,
+  connectDeadlineMs = FAR_DEADLINE_MS,
+) {
+  const openedUrls: string[] = [];
+  const spawnedUrls: string[] = [];
+  let emit: (url: string) => void = () => {};
+  let unlistened = false;
+  const deps: DesktopDeepLinkDeps = {
+    openDefaultBrowser: async (url) => {
+      openedUrls.push(url);
+    },
+    spawnFreshBrowser: async (url) => {
+      spawnedUrls.push(url);
+    },
+    subscribeRedirects: async (onUrl) => {
+      emit = onUrl;
+      return () => {
+        unlistened = true;
+      };
+    },
+    fallbackDelayMs,
+    connectDeadlineMs,
+  };
+  return {
+    deps,
+    openedUrls,
+    spawnedUrls,
+    emit: (url: string) => emit(url),
+    isUnlistened: () => unlistened,
+    stateOf: (url: string) => new URL(url).searchParams.get('state')!,
+    /** Resolve once the runner has opened the default browser (poll, not a fixed tick). */
+    waitOpened: async () => {
+      for (let i = 0; i < 200; i++) {
+        if (openedUrls.length) return;
+        await new Promise<void>((resolve) => setTimeout(resolve, 2));
+      }
+      throw new Error('default browser was never opened');
+    },
+  };
+}
+
+describe('matchesReverseDnsRedirect', () => {
+  const scheme = deriveReverseDnsRedirectScheme(DESKTOP_CLIENT);
+
+  it('matches our reverse-DNS redirect URL', () => {
+    expect(matchesReverseDnsRedirect(`${scheme}:/oauthredirect?code=x`, scheme)).toBe(true);
+  });
+
+  it('rejects unrelated schemes (book files, other deep links)', () => {
+    expect(matchesReverseDnsRedirect('readest://auth-callback', scheme)).toBe(false);
+    expect(matchesReverseDnsRedirect('file:///C:/book.epub', scheme)).toBe(false);
+  });
+
+  it('is case-insensitive on the scheme (the OS may upper-case the argv)', () => {
+    expect(matchesReverseDnsRedirect(`${scheme.toUpperCase()}:/oauthredirect`, scheme)).toBe(true);
+  });
+
+  it('does not match a different scheme that merely starts with ours (the `:` guard)', () => {
+    // `<scheme>extra:` shares the prefix but is a distinct scheme; the required
+    // trailing `:` after the exact scheme prevents a false match.
+    expect(matchesReverseDnsRedirect(`${scheme}extra:/oauthredirect`, scheme)).toBe(false);
+  });
+});
+
+describe('runDesktopDeepLinkOAuth', () => {
+  it('requests consent with the derived reverse-DNS redirect_uri', async () => {
+    const h = makeHarness();
+    const result = runDesktopDeepLinkOAuth(
+      { clientId: DESKTOP_CLIENT, scope: SCOPE },
+      okFetch,
+      h.deps,
+    );
+    await h.waitOpened();
+
+    const opened = new URL(h.openedUrls[0]!);
+    expect(opened.searchParams.get('redirect_uri')).toBe(REDIRECT_URI);
+
+    h.emit(`${REDIRECT_URI}?code=C&state=${h.stateOf(h.openedUrls[0]!)}`);
+    await result;
+  });
+
+  it('resolves the token set when the matching redirect arrives, then unlistens', async () => {
+    const h = makeHarness();
+    const result = runDesktopDeepLinkOAuth(
+      { clientId: DESKTOP_CLIENT, scope: SCOPE },
+      okFetch,
+      h.deps,
+    );
+    await h.waitOpened();
+
+    h.emit(`${REDIRECT_URI}?code=C&state=${h.stateOf(h.openedUrls[0]!)}`);
+    const tokens = await result;
+
+    expect(tokens.accessToken).toBe('AT');
+    expect(h.isUnlistened()).toBe(true);
+    expect(h.spawnedUrls).toHaveLength(0);
+  });
+
+  it('ignores unrelated incoming URLs and waits for the reverse-DNS redirect', async () => {
+    const h = makeHarness();
+    const result = runDesktopDeepLinkOAuth(
+      { clientId: DESKTOP_CLIENT, scope: SCOPE },
+      okFetch,
+      h.deps,
+    );
+    await h.waitOpened();
+
+    let settled = false;
+    void result.then(() => {
+      settled = true;
+    });
+    h.emit('file:///C:/some/book.epub');
+    h.emit('readest://other');
+    await flush();
+    expect(settled).toBe(false);
+
+    h.emit(`${REDIRECT_URI}?code=C&state=${h.stateOf(h.openedUrls[0]!)}`);
+    expect((await result).accessToken).toBe('AT');
+  });
+
+  it('spawns a fresh cold browser with the same auth URL after the fallback delay', async () => {
+    vi.useFakeTimers();
+    try {
+      const h = makeHarness(DEFAULT_FALLBACK_DELAY_MS);
+      const result = runDesktopDeepLinkOAuth(
+        { clientId: DESKTOP_CLIENT, scope: SCOPE },
+        okFetch,
+        h.deps,
+      );
+      await vi.advanceTimersByTimeAsync(0);
+      expect(h.spawnedUrls).toHaveLength(0);
+
+      await vi.advanceTimersByTimeAsync(DEFAULT_FALLBACK_DELAY_MS);
+      expect(h.spawnedUrls).toEqual([h.openedUrls[0]]);
+
+      h.emit(`${REDIRECT_URI}?code=C&state=${h.stateOf(h.openedUrls[0]!)}`);
+      expect((await result).accessToken).toBe('AT');
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it('rejects after the connect deadline when no redirect ever arrives', async () => {
+    vi.useFakeTimers();
+    try {
+      const deadlineMs = 5 * 60_000;
+      const h = makeHarness(DEFAULT_FALLBACK_DELAY_MS, deadlineMs);
+      const result = runDesktopDeepLinkOAuth(
+        { clientId: DESKTOP_CLIENT, scope: SCOPE },
+        okFetch,
+        h.deps,
+      );
+      const rejection = expect(result).rejects.toThrow(/did not complete/i);
+      await vi.advanceTimersByTimeAsync(deadlineMs);
+      await rejection;
+      // The deadline must not have triggered a token exchange.
+      expect(h.isUnlistened()).toBe(true);
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+});
diff --git a/apps/readest-app/src/__tests__/cloudprovider/oauthFlow.test.ts b/apps/readest-app/src/__tests__/cloudprovider/oauthFlow.test.ts
new file mode 100644
index 00000000..ed93b735
--- /dev/null
+++ b/apps/readest-app/src/__tests__/cloudprovider/oauthFlow.test.ts
@@ -0,0 +1,115 @@
+/**
+ * Unit tests for the provider-agnostic OAuth orchestration (`oauthFlow.ts`).
+ *
+ * Every platform mechanic is faked — no Tauri plugins, no network — so these
+ * exercise the security-critical glue (PKCE/state handling, await-before-open,
+ * code extraction, error propagation) headlessly. The desktop/Android wrappers
+ * are intentionally NOT tested here: they are thin wiring over real plugins that
+ * cannot run in a headless test, and the sequence they wire is what is covered.
+ */
+import { describe, it, expect, vi } from 'vitest';
+import { runOAuthFlow, type OAuthFlowDeps } from '@/services/cloudprovider/googleAuth/oauthFlow';
+import type { TokenSet } from '@/services/cloudprovider/googleAuth/tokenStore';
+
+/** A fixed PKCE pair so assertions can check the exact verifier flows through. */
+const FAKE_PKCE = { verifier: 'VERIFIER1', challenge: 'CHALLENGE1' };
+/** Fixed `state` so the fake redirect can echo it back (the flow mints it internally). */
+const FAKE_STATE = 'STATE1';
+const REDIRECT_URI = 'http://127.0.0.1:1';
+const SCOPE = 'https://www.googleapis.com/auth/drive.file';
+const CLIENT_ID = 'client-123';
+const AUTH_CODE = 'CODE1';
+
+/** A representative token set the fake `exchange` returns, to assert propagation. */
+const TOKENS: TokenSet = { accessToken: 'AT', refreshToken: 'RT', expiresAt: 123 };
+
+/**
+ * Build {@link OAuthFlowDeps} with controllable fakes. `newState` is fixed so the
+ * redirect URL (which we author) can carry the same `state` the flow generates —
+ * the parse step's CSRF check then passes deterministically.
+ */
+const makeDeps = (overrides: Partial<OAuthFlowDeps> = {}): OAuthFlowDeps => ({
+  createPkcePair: vi.fn(async () => FAKE_PKCE),
+  newState: () => FAKE_STATE,
+  clientId: CLIENT_ID,
+  openUrl: vi.fn(async () => {}),
+  awaitRedirect: vi.fn(async () => `${REDIRECT_URI}/?code=${AUTH_CODE}&state=${FAKE_STATE}`),
+  redirectUri: REDIRECT_URI,
+  exchange: vi.fn(async () => TOKENS),
+  ...overrides,
+});
+
+describe('runOAuthFlow', () => {
+  it('runs the happy path: exchanges the captured code + PKCE verifier and returns the tokens', async () => {
+    const deps = makeDeps();
+
+    const result = await runOAuthFlow(SCOPE, deps);
+
+    expect(result).toBe(TOKENS);
+    expect(deps.exchange).toHaveBeenCalledTimes(1);
+    expect(deps.exchange).toHaveBeenCalledWith({
+      code: AUTH_CODE,
+      verifier: FAKE_PKCE.verifier,
+      redirectUri: REDIRECT_URI,
+    });
+    expect(deps.awaitRedirect).toHaveBeenCalledWith(REDIRECT_URI);
+  });
+
+  it('builds the auth URL with the injected redirectUri, scope, challenge and state', async () => {
+    // Capture the opened URL via a closure so the assertion does not depend on
+    // the mock-calls tuple being statically typed.
+    let openedUrl = '';
+    const openUrl = vi.fn(async (url: string) => {
+      openedUrl = url;
+    });
+    const deps = makeDeps({ openUrl });
+
+    await runOAuthFlow(SCOPE, deps);
+
+    expect(openUrl).toHaveBeenCalledTimes(1);
+    const params = new URL(openedUrl).searchParams;
+    expect(params.get('redirect_uri')).toBe(REDIRECT_URI);
+    expect(params.get('scope')).toBe(SCOPE);
+    expect(params.get('client_id')).toBe(CLIENT_ID);
+    expect(params.get('code_challenge')).toBe(FAKE_PKCE.challenge);
+    expect(params.get('state')).toBe(FAKE_STATE);
+  });
+
+  it('arms the redirect capture before opening the consent URL (no race)', async () => {
+    // Record call order: `awaitRedirect` must be invoked before `openUrl` so the
+    // listener is ready when the provider redirects.
+    const order: string[] = [];
+    const deps = makeDeps({
+      awaitRedirect: vi.fn(async () => {
+        order.push('awaitRedirect');
+        return `${REDIRECT_URI}/?code=${AUTH_CODE}&state=${FAKE_STATE}`;
+      }),
+      openUrl: vi.fn(async () => {
+        order.push('openUrl');
+      }),
+    });
+
+    await runOAuthFlow(SCOPE, deps);
+
+    expect(order).toEqual(['awaitRedirect', 'openUrl']);
+  });
+
+  it('rejects when the redirect state does not match (CSRF guard)', async () => {
+    const deps = makeDeps({
+      awaitRedirect: vi.fn(async () => `${REDIRECT_URI}/?code=${AUTH_CODE}&state=WRONG`),
+    });
+
+    await expect(runOAuthFlow(SCOPE, deps)).rejects.toThrow(/state mismatch/i);
+    expect(deps.exchange).not.toHaveBeenCalled();
+  });
+
+  it('propagates an exchange failure', async () => {
+    const deps = makeDeps({
+      exchange: vi.fn(async () => {
+        throw new Error('token exchange failed');
+      }),
+    });
+
+    await expect(runOAuthFlow(SCOPE, deps)).rejects.toThrow('token exchange failed');
+  });
+});
diff --git a/apps/readest-app/src/__tests__/cloudprovider/parseRedirect.test.ts b/apps/readest-app/src/__tests__/cloudprovider/parseRedirect.test.ts
new file mode 100644
index 00000000..d1c842b8
--- /dev/null
+++ b/apps/readest-app/src/__tests__/cloudprovider/parseRedirect.test.ts
@@ -0,0 +1,43 @@
+import { describe, it, expect } from 'vitest';
+import { parseRedirect } from '@/services/cloudprovider/googleAuth/parseRedirect';
+
+describe('parseRedirect', () => {
+  it('extracts code when state matches', () => {
+    const r = parseRedirect('http://127.0.0.1:5123/?code=ABC&state=S1', 'S1');
+    expect(r).toEqual({ code: 'ABC' });
+  });
+
+  it('throws on state mismatch (CSRF guard)', () => {
+    expect(() => parseRedirect('http://127.0.0.1:5123/?code=ABC&state=BAD', 'S1')).toThrow();
+  });
+
+  it('throws when provider returns an error param', () => {
+    expect(() =>
+      parseRedirect('http://127.0.0.1:5123/?error=access_denied&state=S1', 'S1'),
+    ).toThrow(/access_denied/);
+  });
+
+  it('throws when code is missing even though state matches', () => {
+    // A redirect with a valid state but no `code` is unusable: there is nothing
+    // to exchange at the token endpoint, so fail loudly rather than returning an
+    // empty/undefined code that would only surface as a confusing later failure.
+    expect(() => parseRedirect('http://127.0.0.1:5123/?state=S1', 'S1')).toThrow();
+  });
+
+  it('reports the provider error before the CSRF check, regardless of state', () => {
+    // Error-first: a provider-rejected/aborted consent (e.g. user denied) often
+    // arrives with a missing or non-matching state, yet the actionable cause is
+    // the error itself — surfacing it must not be masked by a state mismatch.
+    expect(() =>
+      parseRedirect('http://127.0.0.1:5123/?error=access_denied&state=BAD', 'S1'),
+    ).toThrow(/access_denied/);
+  });
+
+  it('parses a custom-scheme deep-link redirect (Android reuses this helper)', () => {
+    // Android receives the redirect as a custom URI scheme deep link rather than
+    // a loopback HTTP URL; the same parser must handle it so both platforms share
+    // one code path.
+    const r = parseRedirect('readest://oauth?code=ABC&state=S1', 'S1');
+    expect(r).toEqual({ code: 'ABC' });
+  });
+});
diff --git a/apps/readest-app/src/__tests__/cloudprovider/persistedDriveAuth.test.ts b/apps/readest-app/src/__tests__/cloudprovider/persistedDriveAuth.test.ts
new file mode 100644
index 00000000..e982c056
--- /dev/null
+++ b/apps/readest-app/src/__tests__/cloudprovider/persistedDriveAuth.test.ts
@@ -0,0 +1,153 @@
+import { describe, it, expect, vi } from 'vitest';
+import {
+  buildDriveProvider,
+  PersistedDriveAuth,
+  SIGNED_IN_ACCOUNT_LABEL,
+  type TokenPersistence,
+} from '@/services/cloudprovider/buildDriveProvider';
+import { GoogleDriveProvider, type FetchFn } from '@/services/cloudprovider/GoogleDriveProvider';
+import type { TokenSet } from '@/services/cloudprovider/googleAuth/tokenStore';
+
+/**
+ * In-memory {@link TokenPersistence} used in place of the (out-of-scope) secure
+ * store. `load` is a `vi.fn` so call-count assertions can verify the auth loads
+ * exactly once; `save` records the last persisted set so the merge-keep-refresh
+ * behaviour can be inspected.
+ */
+const fakePersistence = (initial: TokenSet | null) => {
+  let stored: TokenSet | null = initial;
+  const load = vi.fn(async (): Promise<TokenSet | null> => stored);
+  const save = vi.fn(async (tokens: TokenSet): Promise<void> => {
+    stored = tokens;
+  });
+  const clear = vi.fn(async (): Promise<void> => {
+    stored = null;
+  });
+  const persistence: TokenPersistence = { load, save, clear };
+  return { persistence, load, save, clear };
+};
+
+/** A token-endpoint refresh response (Google omits `refresh_token` on refresh). */
+const refreshResponse = (accessToken: string, expiresInSec: number) =>
+  ({
+    ok: true,
+    status: 200,
+    json: async () => ({ access_token: accessToken, expires_in: expiresInSec }),
+  }) as Response;
+
+/** A fetch that fails the test if it is ever called (no network expected). */
+const unusedFetch = (): ReturnType<typeof vi.fn<FetchFn>> =>
+  vi.fn<FetchFn>(() => {
+    throw new Error('fetch must not be called');
+  });
+
+const CLIENT_ID = 'client-id-123';
+const FAR_FUTURE_MS = 10_000;
+const ONE_HOUR_SEC = 3600;
+
+describe('PersistedDriveAuth', () => {
+  it('returns the stored access token when it is not expired, without refreshing', async () => {
+    const now = () => 0;
+    const valid: TokenSet = { accessToken: 'AT', refreshToken: 'RT', expiresAt: FAR_FUTURE_MS };
+    const { persistence } = fakePersistence(valid);
+    const fetchFn = unusedFetch();
+    const auth = new PersistedDriveAuth({ persistence, clientId: CLIENT_ID, now }, fetchFn);
+
+    expect(await auth.getAccessToken()).toBe('AT');
+    expect(fetchFn).not.toHaveBeenCalled();
+  });
+
+  it('refreshes when expired, keeps the old refresh token, and persists the merged set', async () => {
+    const now = () => 5000; // now >= expiresAt below -> expired
+    const expired: TokenSet = { accessToken: 'OLD_AT', refreshToken: 'KEEP_RT', expiresAt: 1000 };
+    const { persistence, save } = fakePersistence(expired);
+    const fetchFn = vi.fn<FetchFn>().mockResolvedValue(refreshResponse('NEW_AT', ONE_HOUR_SEC));
+    const auth = new PersistedDriveAuth({ persistence, clientId: CLIENT_ID, now }, fetchFn);
+
+    const token = await auth.getAccessToken();
+
+    // The refresh grant was actually performed.
+    expect(fetchFn).toHaveBeenCalledTimes(1);
+    const [, init] = fetchFn.mock.calls[0]!;
+    expect(new URLSearchParams(init!.body as string).get('grant_type')).toBe('refresh_token');
+
+    // The new access token is returned...
+    expect(token).toBe('NEW_AT');
+    // ...and the merged set keeps the old refresh token (Google omits it on refresh).
+    const saved = save.mock.calls.at(-1)![0];
+    expect(saved.accessToken).toBe('NEW_AT');
+    expect(saved.refreshToken).toBe('KEEP_RT');
+  });
+
+  it('throws a clear error when nothing is stored (not signed in)', async () => {
+    const { persistence } = fakePersistence(null);
+    const auth = new PersistedDriveAuth({ persistence, clientId: CLIENT_ID }, unusedFetch());
+    await expect(auth.getAccessToken()).rejects.toThrow(/signed in|stored/i);
+  });
+
+  it('throws a re-auth error when the token is expired and there is no refresh token', async () => {
+    const now = () => 5000;
+    const expiredNoRefresh: TokenSet = { accessToken: 'OLD_AT', expiresAt: 1000 };
+    const { persistence } = fakePersistence(expiredNoRefresh);
+    const auth = new PersistedDriveAuth({ persistence, clientId: CLIENT_ID, now }, unusedFetch());
+    await expect(auth.getAccessToken()).rejects.toThrow(/re-?auth|refresh token/i);
+  });
+
+  it('loads from persistence exactly once across repeated calls', async () => {
+    const now = () => 0;
+    const valid: TokenSet = { accessToken: 'AT', refreshToken: 'RT', expiresAt: FAR_FUTURE_MS };
+    const { persistence, load } = fakePersistence(valid);
+    const auth = new PersistedDriveAuth({ persistence, clientId: CLIENT_ID, now }, unusedFetch());
+
+    await auth.getAccessToken();
+    await auth.getAccessToken();
+    await auth.accountLabel();
+
+    expect(load).toHaveBeenCalledTimes(1);
+  });
+
+  it('reports accountLabel as null when nothing is stored and non-null when signed in', async () => {
+    const empty = fakePersistence(null);
+    const signedOut = new PersistedDriveAuth(
+      { persistence: empty.persistence, clientId: CLIENT_ID },
+      unusedFetch(),
+    );
+    expect(await signedOut.accountLabel()).toBeNull();
+
+    const valid: TokenSet = { accessToken: 'AT', refreshToken: 'RT', expiresAt: FAR_FUTURE_MS };
+    const signedIn = new PersistedDriveAuth(
+      { persistence: fakePersistence(valid).persistence, clientId: CLIENT_ID, now: () => 0 },
+      unusedFetch(),
+    );
+    expect(await signedIn.accountLabel()).toBe(SIGNED_IN_ACCOUNT_LABEL);
+  });
+});
+
+describe('buildDriveProvider', () => {
+  it('returns a GoogleDriveProvider whose isAuthenticated reflects auth state', async () => {
+    // buildDriveProvider wires the real Date.now (no injected clock), so the
+    // token must be valid against wall-clock time, not the synthetic now() above.
+    const valid: TokenSet = {
+      accessToken: 'AT',
+      refreshToken: 'RT',
+      expiresAt: Date.now() + ONE_HOUR_SEC * 1000,
+    };
+    const { persistence } = fakePersistence(valid);
+    const { provider, auth } = buildDriveProvider(
+      persistence,
+      { clientId: CLIENT_ID },
+      unusedFetch(),
+    );
+
+    expect(provider).toBeInstanceOf(GoogleDriveProvider);
+    expect(auth).toBeInstanceOf(PersistedDriveAuth);
+    // Preloaded with a valid token -> authenticated without any network call.
+    expect(await provider.isAuthenticated()).toBe(true);
+  });
+
+  it('isAuthenticated is false when no credentials are stored', async () => {
+    const { persistence } = fakePersistence(null);
+    const { provider } = buildDriveProvider(persistence, { clientId: CLIENT_ID }, unusedFetch());
+    expect(await provider.isAuthenticated()).toBe(false);
+  });
+});
diff --git a/apps/readest-app/src/__tests__/cloudprovider/pkce.test.ts b/apps/readest-app/src/__tests__/cloudprovider/pkce.test.ts
new file mode 100644
index 00000000..1460920f
--- /dev/null
+++ b/apps/readest-app/src/__tests__/cloudprovider/pkce.test.ts
@@ -0,0 +1,74 @@
+import { describe, it, expect } from 'vitest';
+import {
+  createPkcePair,
+  buildAuthUrl,
+  computeChallenge,
+} from '@/services/cloudprovider/googleAuth/pkce';
+
+describe('pkce', () => {
+  it('verifier is 43-128 chars, url-safe', async () => {
+    const { verifier } = await createPkcePair();
+    expect(verifier.length).toBeGreaterThanOrEqual(43);
+    expect(verifier.length).toBeLessThanOrEqual(128);
+    // Tight to the encoder's actual output: base64url emits only this set, so a
+    // regression that leaked `.`/`~`/`=` (or padding) would fail here.
+    expect(verifier).toMatch(/^[A-Za-z0-9\-_]+$/);
+  });
+
+  it('challenge is base64url S256 of verifier (no padding)', async () => {
+    const { challenge } = await createPkcePair();
+    expect(challenge).toMatch(/^[A-Za-z0-9\-_]+$/);
+    expect(challenge).not.toContain('=');
+  });
+
+  it('computes the exact RFC 7636 Appendix B known-answer S256 challenge', async () => {
+    // The canonical test vector from RFC 7636 Appendix B. This pins the S256
+    // transform to a fixed expected output, catching the classic PKCE bug of
+    // hashing the raw verifier bytes instead of the verifier string's ASCII
+    // octets — a defect that random-input tests cannot detect.
+    const verifier = 'dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk';
+    const expectedChallenge = 'E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM';
+    expect(await computeChallenge(verifier)).toBe(expectedChallenge);
+  });
+
+  it('produces a different verifier/challenge pair on every call', async () => {
+    const a = await createPkcePair();
+    const b = await createPkcePair();
+    // PKCE security relies on each authorization attempt using fresh,
+    // unpredictable randomness; two pairs must never collide.
+    expect(a.verifier).not.toBe(b.verifier);
+    expect(a.challenge).not.toBe(b.challenge);
+  });
+
+  it('builds an auth url with required params', async () => {
+    const url = buildAuthUrl({
+      clientId: 'cid',
+      redirectUri: 'http://127.0.0.1:5123',
+      scope: 'https://www.googleapis.com/auth/drive.file',
+      challenge: 'CHAL',
+      state: 'STATE',
+    });
+    const u = new URL(url);
+    expect(u.origin + u.pathname).toBe('https://accounts.google.com/o/oauth2/v2/auth');
+    expect(u.searchParams.get('code_challenge_method')).toBe('S256');
+    expect(u.searchParams.get('code_challenge')).toBe('CHAL');
+    expect(u.searchParams.get('access_type')).toBe('offline');
+    expect(u.searchParams.get('prompt')).toBe('consent');
+  });
+
+  it('sets client_id, redirect_uri, response_type, scope and state on the auth url', async () => {
+    const url = buildAuthUrl({
+      clientId: 'cid',
+      redirectUri: 'http://127.0.0.1:5123',
+      scope: 'https://www.googleapis.com/auth/drive.file',
+      challenge: 'CHAL',
+      state: 'STATE',
+    });
+    const u = new URL(url);
+    expect(u.searchParams.get('client_id')).toBe('cid');
+    expect(u.searchParams.get('redirect_uri')).toBe('http://127.0.0.1:5123');
+    expect(u.searchParams.get('response_type')).toBe('code');
+    expect(u.searchParams.get('scope')).toBe('https://www.googleapis.com/auth/drive.file');
+    expect(u.searchParams.get('state')).toBe('STATE');
+  });
+});
diff --git a/apps/readest-app/src/__tests__/cloudprovider/tokenStore.test.ts b/apps/readest-app/src/__tests__/cloudprovider/tokenStore.test.ts
new file mode 100644
index 00000000..391889d1
--- /dev/null
+++ b/apps/readest-app/src/__tests__/cloudprovider/tokenStore.test.ts
@@ -0,0 +1,188 @@
+import { describe, it, expect, vi } from 'vitest';
+import {
+  exchangeCode,
+  refreshAccessToken,
+  GOOGLE_TOKEN_ENDPOINT,
+  TOKEN_EXPIRY_SAFETY_MARGIN_SEC,
+  type FetchFn,
+} from '@/services/cloudprovider/googleAuth/tokenStore';
+
+const jsonResponse = (body: unknown) =>
+  ({ ok: true, status: 200, json: async () => body }) as Response;
+
+const errorResponse = (status: number) =>
+  ({ ok: false, status, json: async () => ({}) }) as Response;
+
+/** Read the `(url, init)` of a mock fetch's first call, asserting it happened. */
+const firstCall = (fetchFn: ReturnType<typeof vi.fn<FetchFn>>): [string, RequestInit] => {
+  const call = fetchFn.mock.calls[0];
+  expect(call).toBeDefined();
+  return call!;
+};
+
+describe('tokenStore', () => {
+  it('exchanges an auth code for tokens (PKCE, no secret)', async () => {
+    const fetchFn = vi
+      .fn<FetchFn>()
+      .mockResolvedValue(
+        jsonResponse({ access_token: 'AT', refresh_token: 'RT', expires_in: 3600 }),
+      );
+    const tok = await exchangeCode(
+      { code: 'CODE', verifier: 'VER', clientId: 'cid', redirectUri: 'http://127.0.0.1:5123' },
+      fetchFn,
+    );
+    expect(tok.accessToken).toBe('AT');
+    expect(tok.refreshToken).toBe('RT');
+    const [, init] = firstCall(fetchFn);
+    const body = new URLSearchParams(init.body as string);
+    expect(body.get('grant_type')).toBe('authorization_code');
+    expect(body.get('code_verifier')).toBe('VER');
+    expect(body.has('client_secret')).toBe(false);
+  });
+
+  it('includes client_secret on exchange when provided (Google Desktop client)', async () => {
+    const fetchFn = vi
+      .fn<FetchFn>()
+      .mockResolvedValue(
+        jsonResponse({ access_token: 'AT', refresh_token: 'RT', expires_in: 3600 }),
+      );
+    await exchangeCode(
+      {
+        code: 'CODE',
+        verifier: 'VER',
+        clientId: 'cid',
+        redirectUri: 'http://127.0.0.1:5123',
+        clientSecret: 'SECRET',
+      },
+      fetchFn,
+    );
+    const [, init] = firstCall(fetchFn);
+    expect(new URLSearchParams(init.body as string).get('client_secret')).toBe('SECRET');
+  });
+
+  it('includes client_secret on refresh when provided', async () => {
+    const fetchFn = vi
+      .fn<FetchFn>()
+      .mockResolvedValue(jsonResponse({ access_token: 'AT2', expires_in: 3600 }));
+    await refreshAccessToken(
+      { refreshToken: 'RT', clientId: 'cid', clientSecret: 'SECRET' },
+      fetchFn,
+    );
+    const [, init] = firstCall(fetchFn);
+    expect(new URLSearchParams(init.body as string).get('client_secret')).toBe('SECRET');
+  });
+
+  it('sends code, client_id and redirect_uri on exchange', async () => {
+    const fetchFn = vi
+      .fn<FetchFn>()
+      .mockResolvedValue(
+        jsonResponse({ access_token: 'AT', refresh_token: 'RT', expires_in: 3600 }),
+      );
+    await exchangeCode(
+      { code: 'CODE', verifier: 'VER', clientId: 'cid', redirectUri: 'http://127.0.0.1:5123' },
+      fetchFn,
+    );
+    const [, init] = firstCall(fetchFn);
+    const body = new URLSearchParams(init.body as string);
+    expect(body.get('code')).toBe('CODE');
+    expect(body.get('client_id')).toBe('cid');
+    expect(body.get('redirect_uri')).toBe('http://127.0.0.1:5123');
+  });
+
+  it('refreshes an access token', async () => {
+    const fetchFn = vi
+      .fn<FetchFn>()
+      .mockResolvedValue(jsonResponse({ access_token: 'AT2', expires_in: 3600 }));
+    const tok = await refreshAccessToken({ refreshToken: 'RT', clientId: 'cid' }, fetchFn);
+    expect(tok.accessToken).toBe('AT2');
+    const [, init] = firstCall(fetchFn);
+    const body = new URLSearchParams(init.body as string);
+    expect(body.get('grant_type')).toBe('refresh_token');
+    expect(body.get('refresh_token')).toBe('RT');
+    expect(body.get('client_id')).toBe('cid');
+  });
+
+  it('POSTs form-encoded to the Google token endpoint', async () => {
+    const fetchFn = vi
+      .fn<FetchFn>()
+      .mockResolvedValue(
+        jsonResponse({ access_token: 'AT', refresh_token: 'RT', expires_in: 3600 }),
+      );
+    await exchangeCode(
+      { code: 'CODE', verifier: 'VER', clientId: 'cid', redirectUri: 'http://127.0.0.1:5123' },
+      fetchFn,
+    );
+    const [url, init] = firstCall(fetchFn);
+    expect(url).toBe(GOOGLE_TOKEN_ENDPOINT);
+    expect(GOOGLE_TOKEN_ENDPOINT).toBe('https://oauth2.googleapis.com/token');
+    expect(init.method).toBe('POST');
+    const headers = init.headers as Record<string, string>;
+    expect(headers['Content-Type']).toBe('application/x-www-form-urlencoded');
+  });
+
+  it('computes expiresAt as a future epoch-ms accounting for the safety margin', async () => {
+    const expiresIn = 3600;
+    const fetchFn = vi
+      .fn<FetchFn>()
+      .mockResolvedValue(
+        jsonResponse({ access_token: 'AT', refresh_token: 'RT', expires_in: expiresIn }),
+      );
+    const before = Date.now();
+    const tok = await exchangeCode(
+      { code: 'CODE', verifier: 'VER', clientId: 'cid', redirectUri: 'http://127.0.0.1:5123' },
+      fetchFn,
+    );
+    const after = Date.now();
+
+    const lowerBound = before + (expiresIn - TOKEN_EXPIRY_SAFETY_MARGIN_SEC) * 1000;
+    const upperBound = after + (expiresIn - TOKEN_EXPIRY_SAFETY_MARGIN_SEC) * 1000;
+    expect(tok.expiresAt).toBeGreaterThanOrEqual(lowerBound);
+    expect(tok.expiresAt).toBeLessThanOrEqual(upperBound);
+    // The margin makes the usable lifetime shorter than the raw expires_in,
+    // and the token must still be valid into the future.
+    expect(tok.expiresAt).toBeGreaterThan(after);
+    expect(tok.expiresAt).toBeLessThan(after + expiresIn * 1000);
+  });
+
+  it('throws an error including the HTTP status when exchange fails', async () => {
+    const fetchFn = vi.fn<FetchFn>().mockResolvedValue(errorResponse(400));
+    await expect(
+      exchangeCode(
+        { code: 'CODE', verifier: 'VER', clientId: 'cid', redirectUri: 'http://127.0.0.1:5123' },
+        fetchFn,
+      ),
+    ).rejects.toThrow(/400/);
+  });
+
+  it('throws an error including the HTTP status when refresh fails', async () => {
+    const fetchFn = vi.fn<FetchFn>().mockResolvedValue(errorResponse(401));
+    await expect(
+      refreshAccessToken({ refreshToken: 'RT', clientId: 'cid' }, fetchFn),
+    ).rejects.toThrow(/401/);
+  });
+
+  it("surfaces Google's error/error_description in the thrown message", async () => {
+    const fetchFn = vi.fn<FetchFn>().mockResolvedValue({
+      ok: false,
+      status: 400,
+      json: async () => ({ error: 'invalid_grant', error_description: 'Bad Request' }),
+    } as Response);
+    await expect(
+      exchangeCode(
+        { code: 'CODE', verifier: 'VER', clientId: 'cid', redirectUri: 'http://127.0.0.1:5123' },
+        fetchFn,
+      ),
+    ).rejects.toThrow(/invalid_grant — Bad Request/);
+  });
+
+  it('never returns an expiresAt in the past when expires_in <= safety margin', async () => {
+    // A token whose lifetime is at or under the margin must not be marked
+    // already-expired; the usable lifetime clamps to zero (expiresAt ~= now).
+    const fetchFn = vi
+      .fn<FetchFn>()
+      .mockResolvedValue(jsonResponse({ access_token: 'AT', expires_in: 5 }));
+    const before = Date.now();
+    const tok = await refreshAccessToken({ refreshToken: 'RT', clientId: 'cid' }, fetchFn);
+    expect(tok.expiresAt).toBeGreaterThanOrEqual(before);
+  });
+});
diff --git a/apps/readest-app/src/__tests__/drivesync/blobStore.test.ts b/apps/readest-app/src/__tests__/drivesync/blobStore.test.ts
new file mode 100644
index 00000000..362f3a66
--- /dev/null
+++ b/apps/readest-app/src/__tests__/drivesync/blobStore.test.ts
@@ -0,0 +1,81 @@
+import { describe, it, expect } from 'vitest';
+import { FakeCloudProvider } from '@/services/cloudprovider/FakeCloudProvider';
+import { DriveBlobStore } from '@/services/drivesync/DriveBlobStore';
+import { bookBlobPath, coverBlobPath } from '@/services/drivesync/layout';
+
+describe('DriveBlobStore', () => {
+  it('uploads then downloads a book binary by hash+ext', async () => {
+    const store = new DriveBlobStore(new FakeCloudProvider());
+    const bytes = new TextEncoder().encode('EPUBDATA').buffer;
+    await store.uploadBook('hash123', 'epub', bytes);
+    const got = await store.downloadBook('hash123', 'epub');
+    expect(got && new TextDecoder().decode(got)).toBe('EPUBDATA');
+  });
+
+  it('reports a book present after upload, absent before', async () => {
+    const store = new DriveBlobStore(new FakeCloudProvider());
+    expect(await store.hasBook('h', 'pdf')).toBe(false);
+    await store.uploadBook('h', 'pdf', new ArrayBuffer(4));
+    expect(await store.hasBook('h', 'pdf')).toBe(true);
+  });
+
+  it('uploads/reads a cover', async () => {
+    const store = new DriveBlobStore(new FakeCloudProvider());
+    await store.uploadCover('h', new TextEncoder().encode('PNG').buffer);
+    const got = await store.downloadCover('h');
+    expect(got && new TextDecoder().decode(got)).toBe('PNG');
+  });
+
+  it('returns null when downloading an absent book', async () => {
+    const store = new DriveBlobStore(new FakeCloudProvider());
+    expect(await store.downloadBook('missing', 'epub')).toBeNull();
+  });
+
+  it('returns null when downloading an absent cover', async () => {
+    const store = new DriveBlobStore(new FakeCloudProvider());
+    expect(await store.downloadCover('missing')).toBeNull();
+  });
+
+  it('writes a book to the canonical Readest/blobs/books/<hash>.<ext> path', async () => {
+    const cloud = new FakeCloudProvider();
+    const store = new DriveBlobStore(cloud);
+    await store.uploadBook('abc', 'epub', new ArrayBuffer(8));
+    // Assert against the path the rest of the sync system expects, not just the
+    // store's own round-trip, so a path-builder regression cannot hide.
+    const entry = await cloud.stat('Readest/blobs/books/abc.epub');
+    expect(entry?.path).toBe('Readest/blobs/books/abc.epub');
+    expect(entry?.size).toBe(8);
+  });
+
+  it('writes a cover to the canonical Readest/blobs/covers/<hash>.png path', async () => {
+    const cloud = new FakeCloudProvider();
+    const store = new DriveBlobStore(cloud);
+    await store.uploadCover('abc', new ArrayBuffer(3));
+    const entry = await cloud.stat('Readest/blobs/covers/abc.png');
+    expect(entry?.path).toBe('Readest/blobs/covers/abc.png');
+  });
+
+  it('forwards the progress callback on book upload', async () => {
+    const store = new DriveBlobStore(new FakeCloudProvider());
+    const progress: Array<[number, number]> = [];
+    await store.uploadBook('h', 'epub', new ArrayBuffer(10), (sent, total) => {
+      progress.push([sent, total]);
+    });
+    // FakeCloudProvider reports a single terminal event; the store must forward it.
+    expect(progress).toEqual([[10, 10]]);
+  });
+
+  it('normalizes the extension so a mixed-case upload is retrievable by lower-case', async () => {
+    const store = new DriveBlobStore(new FakeCloudProvider());
+    await store.uploadBook('h', 'EPUB', new TextEncoder().encode('X').buffer);
+    // Upload and download/has must agree on a single normalized path.
+    const got = await store.downloadBook('h', 'epub');
+    expect(got && new TextDecoder().decode(got)).toBe('X');
+    expect(await store.hasBook('h', 'epub')).toBe(true);
+  });
+
+  it('exposes path builders that compose under the Readest app root', () => {
+    expect(bookBlobPath('abc', 'epub')).toBe('Readest/blobs/books/abc.epub');
+    expect(coverBlobPath('abc')).toBe('Readest/blobs/covers/abc.png');
+  });
+});
