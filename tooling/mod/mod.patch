diff --git a/apps/readest-app/src/__tests__/drivesync/jsonl.test.ts b/apps/readest-app/src/__tests__/drivesync/jsonl.test.ts
new file mode 100644
index 00000000..011b903c
--- /dev/null
+++ b/apps/readest-app/src/__tests__/drivesync/jsonl.test.ts
@@ -0,0 +1,73 @@
+import { describe, it, expect, vi, afterEach } from 'vitest';
+import { parseJsonl, serializeJsonl } from '@/services/drivesync/jsonl';
+
+// A minimal record shape: the codec is generic, so the fields are arbitrary —
+// these mirror the kind of DB rows (a key plus a timestamp) the sync replicas
+// actually carry, without depending on the concrete record types.
+interface Row {
+  book_hash: string;
+  updated_at: string;
+}
+
+const ROW_A: Row = { book_hash: 'a', updated_at: '2024-01-01T00:00:00.000Z' };
+const ROW_B: Row = { book_hash: 'b', updated_at: '2024-02-01T00:00:00.000Z' };
+
+describe('parseJsonl', () => {
+  it('returns an empty array for null (no file yet)', () => {
+    expect(parseJsonl<Row>(null)).toEqual([]);
+  });
+
+  it('returns an empty array for an empty string', () => {
+    expect(parseJsonl<Row>('')).toEqual([]);
+  });
+
+  it('returns an empty array for whitespace-only content', () => {
+    expect(parseJsonl<Row>('  \n\t\n')).toEqual([]);
+  });
+
+  it('parses one JSON object per non-blank line', () => {
+    const text = `${JSON.stringify(ROW_A)}\n${JSON.stringify(ROW_B)}`;
+    expect(parseJsonl<Row>(text)).toEqual([ROW_A, ROW_B]);
+  });
+
+  it('skips blank and whitespace-only lines between records', () => {
+    const text = `${JSON.stringify(ROW_A)}\n\n   \n${JSON.stringify(ROW_B)}\n`;
+    expect(parseJsonl<Row>(text)).toEqual([ROW_A, ROW_B]);
+  });
+
+  it('skips a single malformed line (warns, does not throw) and keeps the rest', () => {
+    const warn = vi.spyOn(console, 'warn').mockImplementation(() => {});
+    const text = `${JSON.stringify(ROW_A)}\n{not valid json\n${JSON.stringify(ROW_B)}`;
+
+    const parsed = parseJsonl<Row>(text);
+
+    // The good rows survive; only the broken middle line is dropped.
+    expect(parsed).toEqual([ROW_A, ROW_B]);
+    // The drop is observable (a warning carrying line context), never silent.
+    expect(warn).toHaveBeenCalledTimes(1);
+    expect(warn.mock.calls[0]![0]).toContain('jsonl');
+  });
+});
+
+describe('serializeJsonl', () => {
+  it('emits an empty string for an empty array', () => {
+    expect(serializeJsonl<Row>([])).toBe('');
+  });
+
+  it('emits one compact JSON object per line, newline-joined (no trailing newline)', () => {
+    expect(serializeJsonl<Row>([ROW_A, ROW_B])).toBe(
+      `${JSON.stringify(ROW_A)}\n${JSON.stringify(ROW_B)}`,
+    );
+  });
+});
+
+describe('round-trip', () => {
+  it('serialize then parse reproduces the records', () => {
+    const records = [ROW_A, ROW_B];
+    expect(parseJsonl<Row>(serializeJsonl(records))).toEqual(records);
+  });
+});
+
+afterEach(() => {
+  vi.restoreAllMocks();
+});
diff --git a/apps/readest-app/src/__tests__/drivesync/settingsTokenPersistence.test.ts b/apps/readest-app/src/__tests__/drivesync/settingsTokenPersistence.test.ts
new file mode 100644
index 00000000..73c10e33
--- /dev/null
+++ b/apps/readest-app/src/__tests__/drivesync/settingsTokenPersistence.test.ts
@@ -0,0 +1,122 @@
+import { describe, test, expect, vi } from 'vitest';
+import {
+  createSettingsTokenPersistence,
+  type SettingsAccess,
+} from '@/services/drivesync/settingsTokenPersistence';
+import type { TokenSet } from '@/services/cloudprovider/googleAuth/tokenStore';
+import type { SystemSettings } from '@/types/settings';
+
+/**
+ * A fully-formed {@link TokenSet} used across the round-trip cases. Refresh
+ * token present and a concrete (non-zero) expiry so every defensive check in
+ * `load()` has a truthy field to accept.
+ */
+const FULL_TOKENS: TokenSet = {
+  accessToken: 'access-abc',
+  refreshToken: 'refresh-xyz',
+  expiresAt: 1_700_000_000_000,
+};
+
+/**
+ * Build a {@link SettingsAccess} fake backed by a single mutable settings cell.
+ * `persist` is a spy so tests can assert it was invoked with the exact next
+ * settings object; it does not touch disk. Seeded from `initial` (defaults to a
+ * bare settings object with no `cloudSync`).
+ */
+const createFakeAccess = (
+  initial: SystemSettings = {} as SystemSettings,
+): { access: SettingsAccess; persist: ReturnType<typeof vi.fn> } => {
+  let current = initial;
+  const persist = vi.fn(async (_next: SystemSettings) => {});
+  const access: SettingsAccess = {
+    getSettings: () => current,
+    setSettings: (next) => {
+      current = next;
+    },
+    persist,
+  };
+  return { access, persist };
+};
+
+describe('createSettingsTokenPersistence', () => {
+  test('load() returns null when no cloudSync block is present', async () => {
+    const { access } = createFakeAccess();
+    const persistence = createSettingsTokenPersistence(access);
+
+    await expect(persistence.load()).resolves.toBeNull();
+  });
+
+  test('save() then load() round-trips the exact TokenSet', async () => {
+    const { access, persist } = createFakeAccess();
+    const persistence = createSettingsTokenPersistence(access);
+
+    await persistence.save(FULL_TOKENS);
+
+    await expect(persistence.load()).resolves.toEqual(FULL_TOKENS);
+    // persist must have been handed the very settings object now in the store.
+    expect(persist).toHaveBeenCalledTimes(1);
+    expect(persist).toHaveBeenCalledWith(access.getSettings());
+  });
+
+  test('save() does not mutate the original settings object (immutability)', async () => {
+    const original = {} as SystemSettings;
+    const { access } = createFakeAccess(original);
+    const persistence = createSettingsTokenPersistence(access);
+
+    await persistence.save(FULL_TOKENS);
+
+    // The pre-save reference must remain untouched: zustand/React rely on a
+    // new reference to detect the change, so the old one must not have grown
+    // a cloudSync field.
+    expect(original.cloudSync).toBeUndefined();
+    expect(access.getSettings()).not.toBe(original);
+  });
+
+  test('save() preserves an existing cloudSync.google.accountLabel', async () => {
+    const initial = {
+      cloudSync: { google: { accountLabel: 'reader@example.com' } },
+    } as SystemSettings;
+    const { access } = createFakeAccess(initial);
+    const persistence = createSettingsTokenPersistence(access);
+
+    await persistence.save(FULL_TOKENS);
+
+    const stored = access.getSettings().cloudSync?.google;
+    expect(stored?.tokens).toEqual(FULL_TOKENS);
+    expect(stored?.accountLabel).toBe('reader@example.com');
+  });
+
+  test('clear() removes the tokens (load → null) but leaves siblings intact', async () => {
+    const initial = {
+      version: 7,
+      cloudSync: {
+        google: { tokens: FULL_TOKENS, accountLabel: 'reader@example.com' },
+      },
+    } as SystemSettings;
+    const { access, persist } = createFakeAccess(initial);
+    const persistence = createSettingsTokenPersistence(access);
+
+    await persistence.clear();
+
+    await expect(persistence.load()).resolves.toBeNull();
+    const stored = access.getSettings();
+    // The unrelated top-level field and the sibling accountLabel both survive.
+    expect(stored.version).toBe(7);
+    expect(stored.cloudSync?.google?.accountLabel).toBe('reader@example.com');
+    expect(persist).toHaveBeenCalledTimes(1);
+    expect(persist).toHaveBeenCalledWith(stored);
+  });
+
+  test('load() returns null when the stored token object is missing a required field', async () => {
+    const initial = {
+      cloudSync: {
+        // accessToken present but expiresAt absent — a partial/corrupt write.
+        google: { tokens: { accessToken: 'access-only' } },
+      },
+    } as unknown as SystemSettings;
+    const { access } = createFakeAccess(initial);
+    const persistence = createSettingsTokenPersistence(access);
+
+    await expect(persistence.load()).resolves.toBeNull();
+  });
+});
diff --git a/apps/readest-app/src/__tests__/drivesync/statsMerge.test.ts b/apps/readest-app/src/__tests__/drivesync/statsMerge.test.ts
new file mode 100644
index 00000000..1d6e2d32
--- /dev/null
+++ b/apps/readest-app/src/__tests__/drivesync/statsMerge.test.ts
@@ -0,0 +1,97 @@
+import { describe, it, expect } from 'vitest';
+import type { StatPageRecord } from '@/libs/sync';
+import { mergeStatPagesByDuration, statPageKeyOf } from '@/services/drivesync/statsMerge';
+
+// ---------------------------------------------------------------------------
+// statsMerge is the ONE new merge rule Phase 3 adds: reading-page events merge
+// by "longest duration wins", NOT last-writer-wins. This mirrors the server's
+// pickWinningPages (sync.ts:28-38) which is itself KOReader-compatible — a page
+// you spent longer on is the truer record of time read, regardless of when each
+// device happened to report it. These tests pin that rule down in isolation.
+// ---------------------------------------------------------------------------
+
+const BOOK_HASH = 'hashX';
+
+/** A StatPageRecord fixture; only the key fields + duration matter to the merge. */
+const makePage = (overrides: Partial<StatPageRecord> = {}): StatPageRecord => ({
+  book_hash: BOOK_HASH,
+  page: 1,
+  start_time: 1000,
+  duration: 10,
+  total_pages: 300,
+  ...overrides,
+});
+
+describe('statPageKeyOf', () => {
+  it('joins book_hash, page and start_time into the composite key', () => {
+    const key = statPageKeyOf(makePage({ book_hash: 'h', page: 4, start_time: 99 }));
+    expect(key).toBe('h|4|99');
+  });
+
+  it('distinguishes records that differ in any one key field', () => {
+    const base = makePage({ book_hash: 'h', page: 4, start_time: 99 });
+    expect(statPageKeyOf({ ...base, page: 5 })).not.toBe(statPageKeyOf(base));
+    expect(statPageKeyOf({ ...base, start_time: 100 })).not.toBe(statPageKeyOf(base));
+    expect(statPageKeyOf({ ...base, book_hash: 'g' })).not.toBe(statPageKeyOf(base));
+  });
+});
+
+describe('mergeStatPagesByDuration', () => {
+  it('keeps a single new key as-is', () => {
+    const merged = mergeStatPagesByDuration([makePage({ duration: 7 })]);
+    expect(merged).toHaveLength(1);
+    expect(merged[0]!.duration).toBe(7);
+  });
+
+  it('a longer duration replaces a shorter one for the same key', () => {
+    const merged = mergeStatPagesByDuration([
+      makePage({ duration: 10 }),
+      makePage({ duration: 25 }),
+    ]);
+    expect(merged).toHaveLength(1);
+    expect(merged[0]!.duration).toBe(25);
+  });
+
+  it('a shorter duration does NOT replace a longer one for the same key', () => {
+    const merged = mergeStatPagesByDuration([
+      makePage({ duration: 25 }),
+      makePage({ duration: 10 }),
+    ]);
+    expect(merged).toHaveLength(1);
+    expect(merged[0]!.duration).toBe(25);
+  });
+
+  it('is order-independent: the longest duration wins regardless of input order', () => {
+    const pages = [
+      makePage({ duration: 10 }),
+      makePage({ duration: 25 }),
+      makePage({ duration: 18 }),
+    ];
+    const forward = mergeStatPagesByDuration(pages);
+    const reversed = mergeStatPagesByDuration([...pages].reverse());
+    expect(forward).toHaveLength(1);
+    expect(reversed).toHaveLength(1);
+    expect(forward[0]!.duration).toBe(25);
+    expect(reversed[0]!.duration).toBe(25);
+  });
+
+  it('an equal duration keeps the incumbent (strict comparison, deterministic tie)', () => {
+    const incumbent = makePage({ duration: 10, total_pages: 111 });
+    const challenger = makePage({ duration: 10, total_pages: 222 });
+    const merged = mergeStatPagesByDuration([incumbent, challenger]);
+    expect(merged).toHaveLength(1);
+    // Tie keeps the first-seen record, so total_pages is the incumbent's.
+    expect(merged[0]!.total_pages).toBe(111);
+  });
+
+  it('retains one row per distinct key', () => {
+    const merged = mergeStatPagesByDuration([
+      makePage({ page: 1, duration: 5 }),
+      makePage({ page: 2, duration: 5 }),
+      makePage({ page: 1, start_time: 2000, duration: 5 }),
